<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Nexora"
        xmlns:vm="using:Nexora.ViewModels"
        xmlns:v="using:Nexora.Views"
        xmlns:sys="using:System"
        x:Class="Nexora.Janela"
        x:DataType="vm:JanelaVM"
        Title="{Binding Principal.Titulo}"
        Icon="/Assets/nexora.ico"
        Width="1340" Height="860" MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52">
  <Window.Styles>
    <Style Selector="Button.veu-exclusao">
      <Setter Property="Background" Value="#8C0A0908" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.veu-exclusao:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.veu-exclusao:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#8C0A0908" />
    </Style>
    <Style Selector="Button.perigo">
      <Setter Property="Background" Value="{DynamicResource Vermelho}" />
      <Setter Property="Foreground" Value="{DynamicResource SobreVermelho}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.perigo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Vermelho}" />
      <Setter Property="Foreground" Value="{DynamicResource SobreVermelho}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.perigo:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
      <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
    </Style>
    <Style Selector="Button.novidade">
      <Setter Property="Background" Value="{DynamicResource AcentoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
    </Style>

    <Style Selector="Grid.cabeca-topo">
      <Setter Property="Width" Value="64" />
    </Style>
    <Style Selector="Grid.cabeca-topo.fixa">
      <Setter Property="Width" Value="352" />
    </Style>
    <Style Selector="Border.cartao-conteudo">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource FundoDoConteudo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BordaVidro}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 8 30 0 #38000000" />
    </Style>
    <Style Selector="Button.rodape">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}" />
    </Style>
    <Style Selector="Button.rodape:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="Border.cartao-conteudo.grande">
      <Setter Property="Margin" Value="44,0,44,0" />
    </Style>
    <Style Selector="Border.realce">
      <Setter Property="BorderThickness" Value="2.5" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
      <Setter Property="BoxShadow" Value="{DynamicResource BrilhoCaixa}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Canvas.Left" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Canvas.Top" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Width" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Height" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.vao-lateral">
      <Setter Property="Width" Value="0" />
    </Style>
    <Style Selector="Border.vao-lateral.aberto">
      <Setter Property="Width" Value="288" />
    </Style>
    <Style Selector="TextBox.busca-topo">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BordaVidro}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="8,9" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Styles>
  <LayoutTransformControl x:Name="Escalador">
  <Grid x:Name="Moldura" RowDefinitions="54,*,28">
    <Image Grid.RowSpan="3" Source="{Binding ImagemFundo}" Stretch="UniformToFill" IsVisible="{Binding TemImagem}" IsHitTestVisible="False" />
    <Border Grid.RowSpan="3" Background="{DynamicResource BrilhoFundo}" IsHitTestVisible="False" />
    <v:FundoVivo Grid.RowSpan="3" Estilo="{Binding FundoAnimado}" Modo="{Binding ModoFundo}" Agitado="{Binding TemTrabalhando}" />
    <Border Grid.RowSpan="3" Background="{DynamicResource Fundo}" Opacity="{Binding Escurecer}" IsVisible="{Binding TemVeu}" IsHitTestVisible="False" />
    <Border Grid.RowSpan="3" Background="{DynamicResource VeuConteudo}" IsHitTestVisible="False" />

    <Border WindowDecorationProperties.ElementRole="TitleBar" IsVisible="{Binding !TelaCheia}">
      <Grid x:Name="BarraTitulo" ColumnDefinitions="Auto,Auto,*,Auto,Auto,156">
        <Grid Classes="cabeca-topo" Classes.fixa="{Binding LateralFixa}" ColumnDefinitions="64,*" VerticalAlignment="Center" ClipToBounds="True">
          <Button x:Name="BotaoLogo" Classes="logo-topo" Command="{Binding MostrarVisaoGeralCommand}" WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="{l:T 'Ao vivo (Ctrl+0)'}" AutomationProperties.Name="{l:T 'Ao vivo'}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Panel>
              <Image Source="/Assets/nexora.png" Width="30" Height="30" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Laranja}" BorderBrush="{DynamicResource FundoSolido}" BorderThickness="2"
                      IsVisible="{Binding TemPrecisa}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
            </Panel>
          </Button>
          <TextBlock Grid.Column="1" Text="Nexora" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False" />
        </Grid>
        <v:AbasView x:Name="Abas" Grid.Column="2" DataContext="{Binding Principal}" Margin="10,0,8,0" />
        <Button Grid.Column="3" Classes="topo" Command="{Binding ProcurarCommand}" WindowDecorationProperties.ElementRole="User" Margin="0,0,4,0"
                ToolTip.Tip="{l:T 'Procurar telas, comandos, projetos e conversas (Ctrl+K)'}" AutomationProperties.Name="{l:T 'Procurar'}">
          <v:Icone Nome="busca" Tamanho="16" />
        </Button>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="contorno novidade" Command="{Binding AbrirRecuperacaoCommand}" IsVisible="{Binding TemAvisoDeRecuperacao}" WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="{Binding DicaRecuperacao}" AutomationProperties.Name="{Binding TextoRecuperacao}">
            <StackPanel Orientation="Horizontal" Spacing="7"><v:Icone Nome="alerta" Tamanho="14" /><TextBlock Text="{Binding TextoRecuperacao}" /></StackPanel>
          </Button>
          <Button Classes="contorno novidade" Command="{Binding AtualizarAgoraCommand}" IsVisible="{Binding TemAtualizacao}" WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="{Binding DicaAtualizacao}" AutomationProperties.Name="{l:T 'Atualizar o Nexora'}">
            <StackPanel Orientation="Horizontal" Spacing="7"><v:Icone Nome="brilho" Tamanho="14" /><TextBlock Text="{Binding TextoAtualizacao}" /></StackPanel>
          </Button>
          <Button Classes="topo foco" Classes.chamando="{Binding TemPrecisa}" Classes.vazio="{Binding !TemPrecisa}" Command="{Binding AbrirFocoCommand}" WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="{l:T 'Modo foco: um pedido por vez, respondido pelo teclado (Ctrl+J)'}" AutomationProperties.Name="{l:T 'Modo foco'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:Icone Nome="foco" Tamanho="16" />
              <TextBlock x:Name="TextoFoco" Text="{l:T 'Foco'}" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Panel IsVisible="False">
          <Panel x:Name="CaixaPlano">
          <Button Classes="fantasma" Command="{Binding MostrarUsoCommand}" IsVisible="{Binding TemPlano}" Padding="8,4"
                  WindowDecorationProperties.ElementRole="User" ToolTip.Tip="{Binding DicaPlano}" AutomationProperties.Name="{l:T 'Uso do plano'}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <StackPanel Spacing="4" Width="62" VerticalAlignment="Center">
                <TextBlock Classes="suave" Text="{Binding TextoPlanoSessao}" FontSize="11" />
                <ProgressBar Classes="plano" Classes.alerta="{Binding SessaoEmAlerta}" Classes.critico="{Binding SessaoCritica}"
                             Minimum="0" Maximum="1" Value="{Binding ValorPlanoSessao}" />
              </StackPanel>
              <StackPanel Spacing="4" Width="74" VerticalAlignment="Center">
                <TextBlock Classes="suave" Text="{Binding TextoPlanoSemana}" FontSize="11" />
                <ProgressBar Classes="plano" Classes.alerta="{Binding SemanaEmAlerta}" Classes.critico="{Binding SemanaCritica}"
                             Minimum="0" Maximum="1" Value="{Binding ValorPlanoSemana}" />
              </StackPanel>
            </StackPanel>
          </Button>
          </Panel>
          </Panel>
          <Button Classes="topo" Click="Importar_Click" WindowDecorationProperties.ElementRole="User" ToolTip.Tip="{l:T 'Abrir um .code-workspace que está fora da pasta de projetos'}" AutomationProperties.Name="{l:T 'Importar projeto'}">
            <v:Icone Nome="importar" Tamanho="16" />
          </Button>
          <v:BotaoLigado Classes="topo" Classes.ativo="{Binding TelaCheia}" IsChecked="{Binding TelaCheia, Mode=OneWay}" Command="{Binding AlternarTelaCheiaCommand}" WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="{Binding DicaTelaCheia}" AutomationProperties.Name="{l:T 'Tela cheia'}">
            <v:Icone Nome="maximizar" Tamanho="15" />
          </v:BotaoLigado>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding !TelaGrande.Aberta}">
      <v:TrilhoView x:Name="Trilho" IsVisible="{Binding MostraTrilho}" ZIndex="5" />
      <Border Grid.Column="1" Classes="vao-lateral" Classes.aberto="{Binding LateralFixa}" IsHitTestVisible="False" />
      <Border x:Name="CartaoConteudo" Grid.Column="2" Classes="cartao-conteudo" Classes.grande="{Binding TelaCheia}">
        <v:AreaView x:Name="Area" DataContext="{Binding Principal}" />
      </Border>

      <Button Grid.ColumnSpan="3" Theme="{StaticResource VeuSobreposto}" Command="{Binding FecharLateralSobrepostaCommand}" IsVisible="{Binding VeuDaLateral}"
              AutomationProperties.Name="{l:T 'Fechar as conversas'}" />
      <Border x:Name="Gaveta" Grid.Column="1" Grid.ColumnSpan="2" Classes="esquerda" Theme="{StaticResource GavetaSobreposta}" Classes.sobreposta="{Binding LateralSobreposta}" HorizontalAlignment="Left">
        <Border Classes="painel-lateral" Classes.fixa="{Binding LateralFixa}" Classes.grande="{Binding TelaCheia}" Width="280" Background="{DynamicResource Lateral}" BorderBrush="{DynamicResource BordaVidro}"
                IsVisible="{Binding LateralNaTela}" v:Animacoes.Aparecer="esquerda">
          <v:LateralView />
        </Border>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0,16,2" IsVisible="{Binding !TelaCheia}">
      <Button Classes="rodape" Command="{Binding MostrarUsoCommand}" IsVisible="{Binding TemPlano}" ToolTip.Tip="{Binding DicaPlano}" AutomationProperties.Name="{l:T 'Uso do plano'}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:Icone Nome="faisca" Tamanho="12" Foreground="{DynamicResource Laranja}" VerticalAlignment="Center" />
          <ProgressBar Classes="plano" Classes.alerta="{Binding SessaoEmAlerta}" Classes.critico="{Binding SessaoCritica}" Width="46" VerticalAlignment="Center"
                       Minimum="0" Maximum="1" Value="{Binding ValorPlanoSessao}" />
          <TextBlock Text="{Binding TextoLimites}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="rodape" Command="{Binding MostrarUsoCommand}" IsVisible="{Binding TemPlanoCodex}" ToolTip.Tip="{Binding DetalheCodex}" AutomationProperties.Name="{l:T 'Uso do Codex'}" Margin="14,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:Icone Nome="terminal" Tamanho="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TextoLimitesCodex}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="rodape" Command="{Binding MostrarRecursosCommand}" IsVisible="{Binding TemMemoria}" ToolTip.Tip="{l:T 'Memória do Nexora, das sessões e dos MCPs'}" AutomationProperties.Name="{l:T 'Memória'}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:Icone Nome="memoria" Tamanho="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TextoMemoria}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Theme="{StaticResource RecadoFlutuante}" IsVisible="{Binding TemRecado}" ZIndex="20" v:Animacoes.Aparecer="perto">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <v:Icone Nome="pasta" Tamanho="15" Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding RecadoSoltar}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <Canvas x:Name="CamadaRealce" Grid.Row="1" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="Realce" Classes="realce" Opacity="0" />
    </Canvas>
    <v:TopoTelaGrandeView x:Name="TopoGrande" DataContext="{Binding TelaGrande}" IsVisible="{Binding Ligada}" />
    <v:TelaGrandeView x:Name="Inicio" Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding TelaGrande}" IsVisible="{Binding Aberta}" v:Animacoes.Aparecer="perto" />
    <v:BuscaView x:Name="PainelBusca" Grid.RowSpan="3" IsVisible="{Binding BuscaAberta}" />
    <v:FocoView Grid.RowSpan="3" DataContext="{Binding Foco}" IsVisible="{Binding Aberto}" />
    <v:TemplatesView Grid.RowSpan="3" DataContext="{Binding Templates}" IsVisible="{Binding Aberto}" />
    <v:AtalhosView Grid.RowSpan="3" DataContext="{Binding Atalhos}" IsVisible="{Binding Aberto}" />

    <v:BoasVindasView Grid.RowSpan="3" DataContext="{Binding BoasVindas}" IsVisible="{Binding $parent[Window].((vm:JanelaVM)DataContext).MostraBoasVindas}" />
    <v:EscolhaDeAgenteView Grid.RowSpan="3" DataContext="{Binding EscolhaDeAgente}" IsVisible="{Binding $parent[Window].((vm:JanelaVM)DataContext).MostraEscolhaDeAgente}" />

    <Panel Grid.RowSpan="3" IsVisible="{Binding TemExclusao}">
      <Button Classes="veu-exclusao" Command="{Binding Exclusao.CancelarCommand, FallbackValue={x:Null}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="{l:T 'Cancelar'}" />
      <ContentControl Content="{Binding Exclusao}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ExclusaoVM">
            <Border Width="580" Background="{DynamicResource FundoSolido}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="16" Padding="24,20" BoxShadow="0 24 70 0 #80000000">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ErroFundo}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <v:Icone Nome="lixeira" Tamanho="17" Foreground="{DynamicResource Vermelho}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="fraco mono" Text="{Binding Principal}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="suave" TextWrapping="Wrap" FontSize="13"
                           Text="{l:T 'O projeto sai da lista do Nexora. Marque o que mais deve ir embora; tudo vai para a Lixeira e dá para recuperar de lá.'}" />
                <StackPanel Spacing="10">
                  <CheckBox IsChecked="{Binding ApagarArquivo}" IsVisible="{Binding MostrarOpcaoArquivo}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding TextoArquivo}" TextWrapping="Wrap" />
                      <TextBlock Classes="fraco" Text="{l:T 'O VS Code também deixa de abrir este workspace.'}" FontSize="12" />
                    </StackPanel>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding ApagarPasta}" IsEnabled="{Binding !Diagnosticando}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding TextoPasta}" TextWrapping="Wrap" />
                      <TextBlock Classes="fraco mono" Text="{Binding DicaPasta}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding ApagarBranch}" IsVisible="{Binding PodeApagarBranch}" Margin="28,0,0,0">
                    <TextBlock Text="{Binding TextoBranch}" TextWrapping="Wrap" />
                  </CheckBox>
                  <Border IsVisible="{Binding TemAvisos}" Background="{DynamicResource PedidoFundo}" BorderBrush="{DynamicResource Laranja}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="28,0,0,0">
                    <ItemsControl ItemsSource="{Binding Avisos}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                          <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <v:Icone Nome="alerta" Tamanho="13" Foreground="{DynamicResource Laranja}" VerticalAlignment="Top" Margin="0,2,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <CheckBox IsChecked="{Binding ApagarConversas}" IsVisible="{Binding TemConversas}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding TextoConversas}" TextWrapping="Wrap" />
                      <TextBlock Classes="fraco" Text="{l:T 'Elas somem do histórico do Nexora e do Claude Code.'}" FontSize="12" />
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
                <TextBlock Classes="fraco" Text="{Binding TextoVinculados}" IsVisible="{Binding TemVinculados}" FontSize="12.5" />
                <TextBlock Text="{Binding TextoBloqueio}" IsVisible="{Binding Bloqueado}" Foreground="{DynamicResource Laranja}" TextWrapping="Wrap" FontSize="12.5" />
                <TextBlock Text="{Binding Erro}" IsVisible="{Binding TemErro}" Foreground="{DynamicResource Vermelho}" TextWrapping="Wrap" FontSize="12.5" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                  <Button Classes="contorno" Command="{Binding CancelarCommand}">
                    <TextBlock Text="{l:T 'Cancelar'}" />
                  </Button>
                  <Button Classes="perigo" Command="{Binding ExcluirCommand}" IsEnabled="{Binding PodeExcluir}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><v:Icone Nome="lixeira" Tamanho="13" /><TextBlock Text="{Binding TextoBotao}" /></StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>

    <Panel Grid.RowSpan="3" IsVisible="{Binding PedindoReinicio}">
      <Button Classes="veu-exclusao" Command="{Binding ReiniciarDepoisCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="{l:T 'Depois'}" />
      <Border Theme="{StaticResource Dialogo}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AcentoFundo}" VerticalAlignment="Top" Margin="0,0,12,0">
              <v:Icone Nome="atualizar" Tamanho="17" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{l:T 'Reiniciar o Nexora?'}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="suave" Text="{Binding TextoReinicio}" TextWrapping="Wrap" FontSize="13" />
          <TextBlock Text="{Binding AvisoReinicio}" IsVisible="{Binding TemAvisoReinicio}" Foreground="{DynamicResource Laranja}" TextWrapping="Wrap" FontSize="12.5" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Classes="contorno" Command="{Binding ReiniciarDepoisCommand}">
              <TextBlock Text="{l:T 'Depois'}" />
            </Button>
            <Button Classes="primario" Command="{Binding ReiniciarAgoraCommand}">
              <TextBlock Text="{l:T 'Reiniciar agora'}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
  </LayoutTransformControl>
</Window>
