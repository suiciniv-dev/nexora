<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="using:Nexora"
                    xmlns:v="using:Nexora.Views"
                    xmlns:vm="using:Nexora.ViewModels"
                    xmlns:conv="using:Avalonia.Controls.Converters">

  <CornerRadius x:Key="RaioFlutuante">14</CornerRadius>
  <CornerRadius x:Key="RaioItem">8</CornerRadius>
  <Thickness x:Key="EspacoFlutuante">4</Thickness>
  <Thickness x:Key="EspacoItem">10,6</Thickness>
  <x:Double x:Key="LarguraConversa">1400</x:Double>
  <conv:PlatformKeyGestureConverter x:Key="ConversorDeAtalho" />

  <ControlTheme x:Key="Flutuante" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource FundoSolido}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RaioFlutuante}" />
    <Setter Property="Padding" Value="{StaticResource EspacoFlutuante}" />
  </ControlTheme>

  <ControlTheme x:Key="Dialogo" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource FundoSolido}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BordaVidro}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="24,20" />
    <Setter Property="BoxShadow" Value="0 24 70 0 #80000000" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Cursor" Value="Arrow" />
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="2,3">
            <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Classes="trilho" Focusable="False" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Classes="trilho" Focusable="False" />
              </Track.IncreaseButton>
              <Thumb Name="Pegador" MinHeight="28" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="3,2">
            <Track Name="PART_Track" Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Classes="trilho" Focusable="False" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Classes="trilho" Focusable="False" />
              </Track.IncreaseButton>
              <Thumb Name="Pegador" MinWidth="28" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^ /template/ RepeatButton.trilho">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Thumb#Pegador">
      <Setter Property="Background" Value="{DynamicResource TextoFraco}" />
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="4" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Thumb#Pegador">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="^ /template/ Thumb#Pegador:pressed">
      <Setter Property="Background" Value="{DynamicResource TextoSuave}" />
      <Setter Property="Opacity" Value="0.95" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RaioItem}" />
    <Setter Property="Padding" Value="{StaticResource EspacoItem}" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}" />
            <v:Icone Name="Marca" Grid.Column="1" Nome="ok" Tamanho="13" Margin="12,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Texto}" IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Fundo">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Fundo">
      <Setter Property="Background" Value="{DynamicResource SelecaoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
    </Style>
    <Style Selector="^:selected /template/ v|Icone#Marca">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Fundo">
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Superficie}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,5,9,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextoFraco}" />
    <Setter Property="MaxDropDownHeight" Value="380" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Name="Placeholder" Text="{TemplateBinding PlaceholderText}" Foreground="{TemplateBinding PlaceholderForeground}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
              <ContentControl Name="Conteudo" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}" />
              <v:Icone Name="Seta" Grid.Column="1" Nome="abaixo" Tamanho="14" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextoSuave}" RenderTransformOrigin="50%,50%" />
            </Grid>
          </Border>
          <Popup Name="PART_Popup" WindowManagerAddShadowHint="False" IsLightDismissEnabled="True" InheritsTransform="True"
                 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                 MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                 MaxHeight="{TemplateBinding MaxDropDownHeight}">
            <Border Theme="{StaticResource Flutuante}" v:Animacoes.Entrada="True">
              <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Fundo">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Fundo">
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
    </Style>
    <Style Selector="^:dropdownopen /template/ Border#Fundo">
      <Setter Property="Background" Value="{DynamicResource MarcaFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
    </Style>
    <Style Selector="^:dropdownopen /template/ v|Icone#Seta">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="FontFamily" Value="{DynamicResource FonteUi}" />
    <Setter Property="FontSize" Value="{DynamicResource TamanhoDaDica}" />
    <Setter Property="MaxWidth" Value="{DynamicResource LarguraDaDica}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Theme="{StaticResource Flutuante}" CornerRadius="{StaticResource RaioItem}" Padding="10,6">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextWrapping="Wrap" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="FontFamily" Value="{DynamicResource FonteUi}" />
    <Setter Property="MinWidth" Value="190" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Theme="{StaticResource Flutuante}" v:Animacoes.Entrada="True">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Grid.IsSharedSizeScope="True"
                            KeyboardNavigation.TabNavigation="Continue" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="FontFamily" Value="{DynamicResource FonteUi}" />
    <Setter Property="MinWidth" Value="190" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Theme="{StaticResource Flutuante}" v:Animacoes.Entrada="True">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Grid.IsSharedSizeScope="True"
                            KeyboardNavigation.TabNavigation="Continue" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{StaticResource RaioItem}" />
    <Setter Property="Padding" Value="{StaticResource EspacoItem}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <ContentPresenter Name="Icone" Content="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center" RecognizesAccessKey="True" />
              <TextBlock Grid.Column="2" Foreground="{DynamicResource TextoFraco}" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center"
                         Text="{TemplateBinding InputGesture, Converter={StaticResource ConversorDeAtalho}}"
                         IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <v:Icone Name="Seta" Grid.Column="3" Nome="direita" Tamanho="12" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextoFraco}" IsVisible="False" />
            </Grid>
          </Border>
          <Popup Name="PART_Popup" Placement="RightEdgeAlignedTop" HorizontalOffset="6" IsLightDismissEnabled="False" WindowManagerAddShadowHint="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
            <Border Theme="{StaticResource Flutuante}" MinWidth="190" v:Animacoes.Entrada="True">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Grid.IsSharedSizeScope="True" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Fundo, ^:selected /template/ Border#Fundo, ^:open /template/ Border#Fundo">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
    <Style Selector="^:not(:empty) /template/ v|Icone#Seta">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Borda}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="9,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <Border Name="Caixa" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Center"
                  BorderBrush="{DynamicResource TextoFraco}" Background="Transparent">
            <Panel>
              <v:Icone Name="Marca" Nome="ok" Tamanho="12" Foreground="{DynamicResource Texto}" IsVisible="False" />
              <Border Name="Parcial" Width="8" Height="2" CornerRadius="1" Background="{DynamicResource Texto}" IsVisible="False" />
            </Panel>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" RecognizesAccessKey="True"
                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Caixa">
      <Setter Property="BorderBrush" Value="{DynamicResource TextoSuave}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Caixa, ^:indeterminate /template/ Border#Caixa">
      <Setter Property="Background" Value="{DynamicResource SelecaoTexto}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MarcaGradiente}" />
    </Style>
    <Style Selector="^:checked /template/ v|Icone#Marca">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#Parcial">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="4" Background="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Name="Trilho" Width="38" Height="22" CornerRadius="11" BorderThickness="1" VerticalAlignment="Center"
                    Background="{DynamicResource SuperficieAlta}" BorderBrush="{DynamicResource Borda}">
              <Canvas Name="PART_SwitchKnob" Width="16" Height="18" Margin="1" HorizontalAlignment="Left">
                <Panel Name="PART_MovingKnobs" Width="18" Height="18" Canvas.Left="0">
                  <Ellipse Name="Bolinha" Width="14" Height="14" Fill="{DynamicResource TextoSuave}" />
                </Panel>
              </Canvas>
            </Border>
            <Panel VerticalAlignment="Center">
              <ContentPresenter Name="PART_OnContentPresenter" Content="{TemplateBinding OnContent}" ContentTemplate="{TemplateBinding OnContentTemplate}"
                                IsVisible="False" />
              <ContentPresenter Name="PART_OffContentPresenter" Content="{TemplateBinding OffContent}" ContentTemplate="{TemplateBinding OffContentTemplate}" />
            </Panel>
          </StackPanel>
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Panel#PART_MovingKnobs">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Canvas.Left" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:checked /template/ Panel#PART_MovingKnobs">
      <Setter Property="Canvas.Left" Value="16" />
    </Style>
    <Style Selector="^:checked /template/ Border#Trilho">
      <Setter Property="Background" Value="{DynamicResource MarcaGradiente}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#Bolinha">
      <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Trilho">
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CartaoSubagente" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Superficie}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Style Selector="^.rodando">
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
    </Style>
    <Style Selector="^.erro">
      <Setter Property="BorderBrush" Value="{DynamicResource Vermelho}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CabecalhoSubagente" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center"
                          Foreground="{TemplateBinding Foreground}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="ResumoDoTurno" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,-6,0,10" />
    <Style Selector="^.confirmando">
      <Setter Property="Background" Value="{DynamicResource PedidoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Laranja}" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="PilulaPr" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2,9,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextoSuave}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
    </Style>
    <Style Selector="^.falhou">
      <Setter Property="Foreground" Value="{DynamicResource Vermelho}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Vermelho}" />
    </Style>
    <Style Selector="^.aprovado">
      <Setter Property="Foreground" Value="{DynamicResource Verde}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Verde}" />
    </Style>
    <Style Selector="^.mergeado">
      <Setter Property="Foreground" Value="{DynamicResource Acento}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
    </Style>
    <Style Selector="^.fechado">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </ControlTheme>

  <DataTemplate x:Key="PilulasDePr" x:DataType="vm:IssueLinhaVM">
    <ItemsControl ItemsSource="{Binding Pilulas}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="5" LineSpacing="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PilulaPrVM">
          <Button Theme="{StaticResource PilulaPr}" Classes.falhou="{Binding Falhou}" Classes.aprovado="{Binding Aprovado}" Classes.mergeado="{Binding Mergeado}"
                  Classes.fechado="{Binding Fechado}" Command="{Binding AbrirCommand}" ToolTip.Tip="{Binding Dica}" AutomationProperties.Name="{Binding Dica}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <v:Icone Nome="pr" Tamanho="11" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>

  <DataTemplate x:Key="MiniaturaDoTema" x:DataType="vm:TemaCartaoVM">
    <Border CornerRadius="9" ClipToBounds="True" Height="84" Background="{Binding Fundo}" BorderBrush="{DynamicResource BordaVidro}" BorderThickness="1">
      <Panel>
        <Image Source="{Binding Miniatura}" Stretch="UniformToFill" IsVisible="{Binding TemMiniatura}" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8" VerticalAlignment="Bottom" IsVisible="{Binding TemMiniatura}">
          <Border Height="10" Width="32" CornerRadius="5" Background="{Binding Acento}" />
          <Border Height="10" Width="18" CornerRadius="5" Background="{Binding Superficie}" />
        </StackPanel>
        <Grid ColumnDefinitions="30,*" IsVisible="{Binding !TemMiniatura}">
          <Border Background="{Binding Lateral}">
            <StackPanel Margin="6,9" Spacing="5">
              <Border Height="7" CornerRadius="3" Background="{Binding Acento}" />
              <Border Height="4" CornerRadius="2" Background="{Binding TextoFraco}" Opacity="0.6" />
              <Border Height="4" CornerRadius="2" Background="{Binding TextoFraco}" Opacity="0.4" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,9" Spacing="6">
            <Border Height="6" Width="56" CornerRadius="3" Background="{Binding Texto}" HorizontalAlignment="Left" />
            <Border CornerRadius="6" Background="{Binding Superficie}" Padding="6,5">
              <StackPanel Spacing="5">
                <Border Height="4" CornerRadius="2" Background="{Binding Texto}" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Ellipse Width="6" Height="6" Fill="{Binding Verde}" />
                  <Ellipse Width="6" Height="6" Fill="{Binding Laranja}" />
                  <Border Height="9" Width="26" CornerRadius="4" Background="{Binding Acento}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Panel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="PreviaDoTema" x:DataType="vm:TemaCartaoVM">
    <Panel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MiniaturaDoTema}" IsVisible="{Binding NaoEhSistema}" />
      <Grid ColumnDefinitions="*,4,*" IsVisible="{Binding EhSistema}">
        <ContentControl Content="{Binding Escuro}" ContentTemplate="{StaticResource MiniaturaDoTema}" />
        <ContentControl Grid.Column="2" Content="{Binding Claro}" ContentTemplate="{StaticResource MiniaturaDoTema}" />
      </Grid>
    </Panel>
  </DataTemplate>

  <ControlTheme x:Key="CartaoDeTema" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Superficie}" />
    <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BordaVidro}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="8,8,8,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^.em-uso /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="{DynamicResource BrilhoCaixa}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="GavetaSobreposta" TargetType="Border">
    <Style Selector="^.sobreposta">
      <Setter Property="Background" Value="{DynamicResource FundoSolido}" />
      <Setter Property="BoxShadow" Value="-14 0 44 0 #73000000" />
    </Style>
    <Style Selector="^.sobreposta.esquerda">
      <Setter Property="BoxShadow" Value="14 0 44 0 #73000000" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="MarcadorDeAnotacao" TargetType="Border">
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Background" Value="{DynamicResource Marca}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FundoSolido}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </ControlTheme>

  <ControlTheme x:Key="BarraDoNavegador" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Lateral}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,6" />
  </ControlTheme>

  <ControlTheme x:Key="VeuSobreposto" TargetType="Button">
    <Setter Property="Background" Value="#4D0A0908" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <DataTemplate x:Key="CartaoDeSubagente" x:DataType="vm:ItemSubagente">
    <Border Theme="{StaticResource CartaoSubagente}" Classes.rodando="{Binding Rodando}" Classes.erro="{Binding Falhou}">
      <StackPanel>
        <Button Theme="{StaticResource CabecalhoSubagente}" Command="{Binding AlternarCommand}" ToolTip.Tip="{Binding Descricao}"
                AutomationProperties.Name="{Binding Descricao}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
            <Ellipse Classes="estado" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center"
                     Classes.trabalhando="{Binding Rodando}" Classes.pronta="{Binding Ok}" Classes.erro="{Binding Falhou}" />
            <v:Icone Grid.Column="1" Nome="subagente" Tamanho="14" Classes="suave" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Grid.Column="2" Text="{Binding Descricao}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Column="3" Classes="fraco" FontSize="12" VerticalAlignment="Center">
              <Run Text="{Binding TempoTexto}" />
              <Run Text="  ·  " />
              <Run Text="{Binding TextoFerramentas}" />
            </TextBlock>
            <v:Icone Grid.Column="4" Nome="abaixo" Tamanho="14" Classes="fraco" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,5,0,0">
              <Border Classes="etiqueta-pilula" Margin="0,0,6,0">
                <TextBlock Text="{Binding Tipo}" FontSize="11.5" FontWeight="SemiBold" />
              </Border>
              <Border Grid.Column="1" Classes="etiqueta-pilula" Margin="0,0,6,0" IsVisible="{Binding TemModelo}">
                <TextBlock Text="{Binding ModeloPedido}" FontSize="11.5" />
              </Border>
              <TextBlock Grid.Column="2" Classes="fraco" Text="{Binding EstadoTexto}" FontSize="12" VerticalAlignment="Center" Margin="2,0,12,0" />
              <TextBlock Grid.Column="3" Classes="suave mono" Text="{Binding Atividade}" IsVisible="{Binding MostraAtividade}"
                         FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="suave" Text="{Binding Previa}" IsVisible="{Binding MostraPrevia}"
                         FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Button>
        <StackPanel Spacing="8" Margin="14,0,14,12" IsVisible="{Binding EscolhendoModelo}">
          <TextBlock Classes="suave" FontSize="12.5" TextWrapping="Wrap" Text="{l:T 'Qual modelo este subagent deve usar?'}" />
          <WrapPanel>
            <Button Classes="contorno pequeno" Margin="0,0,6,6" Content="Haiku" Command="{Binding EscolherModeloCommand}" CommandParameter="haiku" />
            <Button Classes="primario pequeno" Margin="0,0,6,6" Content="Sonnet" Command="{Binding EscolherModeloCommand}" CommandParameter="sonnet" />
            <Button Classes="contorno pequeno" Margin="0,0,6,6" Content="Opus" Command="{Binding EscolherModeloCommand}" CommandParameter="opus" />
            <Button Classes="fantasma pequeno" Margin="0,0,6,6" Content="{l:T 'Igual à conversa'}" Command="{Binding EscolherModeloCommand}" CommandParameter="conversa" />
          </WrapPanel>
        </StackPanel>
        <TextBlock Classes="fraco" FontSize="12" TextWrapping="Wrap" Margin="14,0,14,12" IsVisible="{Binding NaFila}"
                   Text="{l:T 'Na fila: começa quando outro subagent terminar. O limite fica em Configurações > Sessões.'}" />
        <StackPanel Spacing="4" Margin="14,0,14,12" IsVisible="{Binding Aberto}">
          <StackPanel IsVisible="{Binding TemPedido}">
            <TextBlock Classes="secao-geral" Text="{l:T 'PEDIDO'}" Margin="0,4,0,4" />
            <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
              <SelectableTextBlock Classes="suave" Text="{Binding Pedido}" TextWrapping="Wrap" FontSize="12.5" />
            </ScrollViewer>
          </StackPanel>
          <TextBlock Classes="secao-geral" Text="{l:T 'FERRAMENTAS'}" Margin="0,8,0,4" IsVisible="{Binding TemFerramentas}" />
          <ItemsControl ItemsSource="{Binding Ferramentas}" IsVisible="{Binding TemFerramentas}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Classes="fraco" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding SoContagem}"
                     Text="{l:T 'O Claude Code só mandou a contagem das ferramentas deste subagent, sem as chamadas.'}" />
          <StackPanel IsVisible="{Binding TemResultado}">
            <TextBlock Classes="secao-geral" Text="{l:T 'RESULTADO'}" Margin="0,8,0,4" />
            <Border Classes="mdCodigo" MaxHeight="360">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <v:MarkdownTexto Texto="{Binding Resultado}" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="GrupoDeSubagentes" x:DataType="vm:ItemSubagentes">
    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,2,0,0" IsVisible="{Binding Varios}">
        <v:Icone Nome="subagente" Tamanho="14" Classes="suave" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        <TextBlock Classes="fraco" Text="{Binding Resumo}" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="2" CornerRadius="1" Background="{DynamicResource SelecaoBorda}" Margin="8,2,12,2" IsVisible="{Binding Varios}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Agentes}" ItemTemplate="{StaticResource CartaoDeSubagente}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="SubagentesNoTrecho" x:DataType="vm:ItemSubagentes">
    <ItemsControl ItemsSource="{Binding Agentes}" Margin="0,2">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ItemSubagente">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,2">
            <Ellipse Classes="estado" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                     Classes.trabalhando="{Binding Rodando}" Classes.pronta="{Binding Ok}" Classes.erro="{Binding Falhou}" />
            <v:Icone Grid.Column="1" Nome="subagente" Tamanho="12" Classes="suave" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Grid.Column="2" Text="{Binding Tipo}" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Classes="suave" Text="{Binding Descricao}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Classes="fraco" Text="{Binding TextoFerramentas}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>
  <ControlTheme x:Key="DestinoDoSegredo" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Superficie}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RaioItem}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MaxWidth" Value="560" />
  </ControlTheme>

  <ControlTheme x:Key="SegredoNoCartaoFundo" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PedidoFundo}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Laranja}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RaioItem}" />
    <Setter Property="Padding" Value="10,8" />
  </ControlTheme>

  <DataTemplate x:Key="CartaoDeSegredo" x:DataType="vm:ItemSegredo">
    <Border Classes="pedido" Classes.respondida="{Binding Respondida}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*">
          <v:Icone Nome="chave" Tamanho="16" Foreground="{DynamicResource Laranja}" IsVisible="{Binding Pendente}" VerticalAlignment="Top" Margin="0,1,8,0" />
          <v:Icone Nome="ok" Tamanho="16" Classes="fraco" IsVisible="{Binding Respondida}" VerticalAlignment="Top" Margin="0,1,8,0" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap">
            <Run Text="{Binding Titulo}" FontWeight="SemiBold" /><Run Classes="suave" Text="{Binding Motivo, StringFormat=' — {0}'}" />
          </TextBlock>
        </Grid>
        <Border Theme="{StaticResource DestinoDoSegredo}" IsVisible="{Binding Pendente}">
          <Grid ColumnDefinitions="Auto,*">
            <v:Icone Nome="{Binding IconeDestino}" Tamanho="13" Classes="suave" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Classes="suave" Text="{Binding Destino}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Pendente}" MaxWidth="560" HorizontalAlignment="Left">
          <TextBox x:Name="CampoDoSegredo" Classes="campo segredo" Text="{Binding Valor}" PasswordChar="•" RevealPassword="{Binding Mostrando}"
                   PlaceholderText="{Binding Nome}" AutomationProperties.Name="{l:T 'Valor do segredo'}" AcceptsReturn="False" MinWidth="320">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SalvarCommand}" />
            </TextBox.KeyBindings>
            <TextBox.InnerRightContent>
              <Button Classes="icone pequeno" Command="{Binding AlternarMostrarCommand}" Margin="0,0,4,0" Focusable="False"
                      ToolTip.Tip="{l:T 'Mostrar ou esconder o valor'}" AutomationProperties.Name="{l:T 'Mostrar ou esconder o valor'}">
                <Panel>
                  <v:Icone Nome="olho" Tamanho="14" IsVisible="{Binding !Mostrando}" />
                  <v:Icone Nome="olho-fechado" Tamanho="14" IsVisible="{Binding Mostrando}" />
                </Panel>
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
        </Grid>
        <TextBlock Classes="fraco" Text="{Binding Aviso}" IsVisible="{Binding Pendente}" TextWrapping="Wrap" FontSize="12" />
        <Border Classes="erro" IsVisible="{Binding TemErro}" Padding="8,6">
          <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Pendente}">
          <Button Classes="primario" Content="{l:T 'Salvar'}" Command="{Binding SalvarCommand}" />
          <Button Classes="contorno" Content="{l:T 'Recusar'}" Command="{Binding RecusarCommand}" />
        </StackPanel>
        <TextBlock Classes="fraco" Text="{Binding Resposta}" IsVisible="{Binding Respondida}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="SegredoNoTrecho" x:DataType="vm:ItemSegredo">
    <Border Classes="pedido" Classes.respondida="{Binding Respondida}" Padding="10,8" Margin="0,6">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
        <TextBlock Classes="suave" Text="{Binding Motivo}" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="fraco" Text="{l:T 'Responda pela conversa completa: o campo do segredo fica só lá.'}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Pendente}" />
        <TextBlock Classes="fraco" Text="{Binding Resposta}" FontSize="12" IsVisible="{Binding Respondida}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="SegredoNoCartao" x:DataType="vm:ChatVM">
    <Border Theme="{StaticResource SegredoNoCartaoFundo}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*">
          <v:Icone Nome="chave" Tamanho="13" Foreground="{DynamicResource Laranja}" VerticalAlignment="Top" Margin="0,2,7,0" />
          <TextBlock Grid.Column="1" Text="{Binding SegredoPendente.Titulo, FallbackValue={x:Null}}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock Classes="suave" Text="{Binding SegredoPendente.Motivo, FallbackValue={x:Null}}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <Button Classes="primario pequeno" HorizontalAlignment="Left" Content="{l:T 'Responder na conversa'}" Command="{Binding MostrarCommand}"
                ToolTip.Tip="{l:T 'Abre a conversa no formulário do segredo'}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="LinhaDeSegredo" x:DataType="vm:SegredoGuardadoVM">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
      <v:Icone Nome="chave" Tamanho="14" Classes="suave" VerticalAlignment="Center" Margin="0,0,10,0" />
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Classes="mono" Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="fraco" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CaminhoDoProjeto}">
          <Run Text="{Binding Projeto}" /><Run Text="  ·  " /><Run Text="{Binding Onde}" />
        </TextBlock>
      </StackPanel>
      <Panel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
        <Button Classes="icone pequeno" Command="{Binding PedirApagarCommand}" IsVisible="{Binding !Confirmando}"
                ToolTip.Tip="{Binding DicaApagar}" AutomationProperties.Name="{l:T 'Apagar o segredo'}">
          <v:Icone Nome="lixeira" Tamanho="14" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Confirmando}">
          <Button Classes="primario pequeno" Content="{l:T 'Apagar'}" Command="{Binding ApagarCommand}" ToolTip.Tip="{Binding DicaApagar}" />
          <Button Classes="fantasma pequeno" Content="{l:T 'Cancelar'}" Command="{Binding CancelarCommand}" />
        </StackPanel>
      </Panel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="CartaoDeCitacao" x:DataType="vm:CitacaoVM">
    <Border Background="{DynamicResource AcentoFundo}" BorderBrush="{DynamicResource SelecaoBorda}" BorderThickness="1" CornerRadius="10"
            ClipToBounds="True" ToolTip.Tip="{Binding Texto}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Border Width="3" Background="{DynamicResource Acento}" />
        <v:Icone Grid.Column="1" Nome="responder" Tamanho="13" Classes="suave" VerticalAlignment="Top" Margin="10,9,8,0" />
        <TextBlock Grid.Column="2" Classes="suave" Text="{Binding Previa}" FontSize="12.5" TextWrapping="Wrap" MaxLines="3"
                   TextTrimming="CharacterEllipsis" Margin="0,7,10,7" />
        <Button Grid.Column="3" Classes="icone pequeno" Command="{Binding RemoverCommand}" IsVisible="{Binding Removivel}"
                Width="24" Height="24" Padding="0" VerticalAlignment="Top" Margin="0,4,4,0"
                ToolTip.Tip="{l:T 'Tirar a citação'}" AutomationProperties.Name="{l:T 'Tirar a citação'}">
          <v:Icone Nome="fechar" Tamanho="9" />
        </Button>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="CitacaoNaMensagem" x:DataType="vm:CitacaoVM">
    <Grid ColumnDefinitions="Auto,*" Margin="10,0,0,0" ToolTip.Tip="{Binding Texto}">
      <Border Width="2" CornerRadius="1" Background="{DynamicResource SelecaoBorda}" Margin="0,1,9,1" />
      <StackPanel Grid.Column="1" Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <v:Icone Nome="responder" Tamanho="11" Classes="fraco" VerticalAlignment="Center" />
          <TextBlock Classes="fraco" Text="{l:T 'Respondendo a'}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="suave" Text="{Binding Previa}" FontSize="12.5" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="AvisoDeCustoDaTroca" x:DataType="x:String">
    <Border Background="{DynamicResource SuperficieAlta}" BorderBrush="{DynamicResource Laranja}" BorderThickness="1" CornerRadius="9"
            Padding="10,7" Margin="6,0,6,6">
      <Grid ColumnDefinitions="Auto,*">
        <v:Icone Nome="alerta" Tamanho="13" Foreground="{DynamicResource Laranja}" VerticalAlignment="Top" Margin="0,1,8,0" />
        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" />
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="DivisorDeSessao" x:DataType="vm:ItemAviso">
    <Grid ColumnDefinitions="*,Auto,*" Margin="0,14,0,10">
      <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Acento}" Opacity="0.55" />
      <Border Grid.Column="1" Background="{DynamicResource AcentoFundo}" BorderBrush="{DynamicResource SelecaoBorda}" BorderThickness="1"
              CornerRadius="999" Padding="12,4" Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:Icone Nome="atualizar" Tamanho="12" Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Texto}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{DynamicResource Acento}" Opacity="0.55" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="OrigemDoPedido" x:DataType="vm:ItemPermissao">
    <Border Classes="etiqueta-pilula" HorizontalAlignment="Left" Padding="7,2" ToolTip.Tip="{l:T 'Este pedido veio de um subagent desta conversa'}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <v:Icone Nome="subagente" Tamanho="12" Classes="suave" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Subagente}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <ControlTheme x:Key="GraficoDeDias" TargetType="ItemsControl">
    <Setter Property="Height" Value="40" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="6" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="vm:BarraVM">
        <Panel Width="14" Height="{Binding Altura}" VerticalAlignment="Bottom" Background="Transparent" ToolTip.Tip="{Binding Dica}">
          <Border CornerRadius="2" Background="{DynamicResource TextoFraco}" Opacity="0.5" IsVisible="{Binding !Atual}" />
          <Border CornerRadius="2" Background="{DynamicResource Acento}" IsVisible="{Binding Atual}" />
        </Panel>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="ZonaDeSoltar" TargetType="Border">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
    <Setter Property="Background" Value="{DynamicResource FundoSolido}" />
    <Setter Property="BoxShadow" Value="{DynamicResource BrilhoCaixa}" />
    <Style Selector="^.ativa">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="RecadoFlutuante" TargetType="Border">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="24,0,24,18" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="Background" Value="{DynamicResource FundoSolido}" />
    <Setter Property="BoxShadow" Value="0 8 28 0 #59000000" />
  </ControlTheme>
  <DataTemplate x:Key="AvatarDeRevisor" x:DataType="vm:ConversaNaLinhaVM">
    <Panel Width="18" Height="18" ToolTip.Tip="{Binding Dica}">
      <Border CornerRadius="9" Background="{DynamicResource FundoSolido}" BorderBrush="{DynamicResource Fundo}" BorderThickness="1.5" />
      <Border CornerRadius="9" Margin="1.5" Background="{DynamicResource MarcaGradiente}" IsVisible="{Binding EhPessoa}">
        <TextBlock Text="{Binding Iniciais}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SobreMarca}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <v:AvatarVivo Agente="{Binding Agente}" Parado="True" Rotulo="" IsVisible="{Binding EhAgente}" Margin="1" />
    </Panel>
  </DataTemplate>

  <ControlTheme x:Key="PilhaDeAvatares" TargetType="ItemsControl">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="-6" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate" Value="{StaticResource AvatarDeRevisor}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="BotaoPilhaDeAvatares" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AcentoFundo}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BotaoComentarLinha" TargetType="Button">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Acento}" />
    <Setter Property="Foreground" Value="{DynamicResource SobreAcento}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AcentoHover}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CaixaDeComentario" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Superficie}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="108,4,16,6" />
    <Setter Property="MaxWidth" Value="760" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style Selector="^.pendente">
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
      <Setter Property="Background" Value="{DynamicResource AcentoFundo}" />
    </Style>
    <Style Selector="^.resolvida">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
  </ControlTheme>

  <DataTemplate x:Key="ConversaNaLinha" x:DataType="vm:ConversaNaLinhaVM">
    <Border Theme="{StaticResource CaixaDeComentario}" Classes.resolvida="{Binding Resolvida}">
      <StackPanel Spacing="5">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AvatarDeRevisor}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <WrapPanel Grid.Column="1" ItemSpacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding Autor}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource FonteUi}" />
            <TextBlock Classes="fraco" Text="{Binding Situacao}" FontSize="11" FontFamily="{DynamicResource FonteUi}" VerticalAlignment="Center" />
            <TextBlock Classes="fraco" Text="{Binding Quando}" FontSize="11" FontFamily="{DynamicResource FonteUi}" VerticalAlignment="Center" />
          </WrapPanel>
          <Button Grid.Column="2" Classes="icone pequeno" Command="{Binding AbrirCommand}" IsVisible="{Binding TemLink}"
                  ToolTip.Tip="{l:T 'Ver a conversa no GitHub'}" AutomationProperties.Name="{l:T 'Ver a conversa no GitHub'}">
            <v:Icone Nome="externo" Tamanho="11" />
          </Button>
        </Grid>
        <TextBlock Text="{Binding Corpo}" TextWrapping="Wrap" FontSize="12.5" FontFamily="{DynamicResource FonteUi}" />
        <ItemsControl ItemsSource="{Binding Respostas}" IsVisible="{Binding TemRespostas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RespostaNaLinhaVM">
              <Border BorderBrush="{DynamicResource Borda}" BorderThickness="2,0,0,0" Padding="8,2,0,2" Margin="0,2,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="12" FontFamily="{DynamicResource FonteUi}">
                  <Run Text="{Binding Autor}" FontWeight="SemiBold" />
                  <Run Text="  " />
                  <Run Text="{Binding Corpo}" />
                </TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="ComentarioPendenteNaLinha" x:DataType="vm:ComentarioPendenteVM">
    <Border Theme="{StaticResource CaixaDeComentario}" Classes="pendente">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <v:Icone Nome="conversa" Tamanho="12" Foreground="{DynamicResource Acento}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock Grid.Column="1" Classes="fraco" FontSize="11" FontFamily="{DynamicResource FonteUi}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="{l:T 'Seu comentário, ainda não mandado'}" />
            <Run Text="·" />
            <Run Text="{Binding Faixa}" />
          </TextBlock>
          <Button Grid.Column="2" Classes="icone pequeno" Command="{Binding EditarCommand}" IsVisible="{Binding !Editando}"
                  ToolTip.Tip="{l:T 'Editar o comentário'}" AutomationProperties.Name="{l:T 'Editar o comentário'}">
            <v:Icone Nome="lapis" Tamanho="11" />
          </Button>
          <Button Grid.Column="3" Classes="icone pequeno" Command="{Binding ApagarCommand}"
                  ToolTip.Tip="{l:T 'Apagar o comentário'}" AutomationProperties.Name="{l:T 'Apagar o comentário'}">
            <v:Icone Nome="lixeira" Tamanho="11" />
          </Button>
        </Grid>
        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" FontSize="12.5" FontFamily="{DynamicResource FonteUi}" IsVisible="{Binding !Editando}" />
        <StackPanel Spacing="6" IsVisible="{Binding Editando}">
          <TextBox Classes="campo" Text="{Binding Edicao}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" FontFamily="{DynamicResource FonteUi}"
                   AutomationProperties.Name="{l:T 'Editar o comentário'}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="primario pequeno" Command="{Binding SalvarEdicaoCommand}" Content="{l:T 'Salvar'}" />
            <Button Classes="contorno pequeno" Command="{Binding CancelarEdicaoCommand}" Content="{l:T 'Cancelar'}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="OpcaoDeMenu" x:DataType="vm:OpcaoMenuVM">
    <Button Classes="opcao-menu" Classes.selecionada="{Binding Selecionada}" Command="{Binding EscolherCommand}" Margin="0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding Nome}" FontWeight="Medium" />
          <TextBlock Classes="fraco" Text="{Binding Descricao}" IsVisible="{Binding TemDescricao}" FontSize="11.5" TextWrapping="Wrap" />
        </StackPanel>
        <v:Icone Grid.Column="1" Nome="ok" Tamanho="14" IsVisible="{Binding Selecionada}" VerticalAlignment="Center" Margin="10,0,2,0" />
      </Grid>
    </Button>
  </DataTemplate>

  <ControlTheme x:Key="NuvemNaGuia" TargetType="Border">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource FundoSolido}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ciano}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,-4,-3" />
  </ControlTheme>

  <ControlTheme x:Key="SeloDaNuvem" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Superficie}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ciano}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>

  <DataTemplate x:Key="SeloNaNuvem" x:DataType="vm:CartaoVM">
    <Border Theme="{StaticResource SeloDaNuvem}" ToolTip.Tip="{Binding DicaOndeRoda}">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <v:Icone Nome="nuvem" Tamanho="11" Foreground="{DynamicResource Ciano}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding NomeDaMaquina}" FontSize="11" MaxWidth="110" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Ellipse Width="5" Height="5" Fill="{DynamicResource Laranja}" IsVisible="{Binding NuvemCaiu}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="FaixaDaNuvem" x:DataType="vm:ChatVM">
    <Border Classes="faixa-subagentes" Classes.caiu="{Binding NuvemCaiu}" v:Animacoes.Entrada="True">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="4,0">
        <v:Icone Nome="nuvem" Tamanho="14" Foreground="{DynamicResource Ciano}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding TextoNuvem}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="contorno pequeno" Content="{l:T 'Reconectar agora'}" Command="{Binding ReconectarNuvemCommand}" IsVisible="{Binding NuvemCaiu}" Margin="10,0,0,0"
                ToolTip.Tip="{l:T 'O Nexora tenta sozinho; isto tenta agora mesmo.'}" />
        <Button Grid.Column="3" Classes="contorno pequeno" Command="{Binding TrazerDaNuvemCommand}" IsVisible="{Binding PodeTrazerDaNuvem}" Margin="8,0,0,0"
                ToolTip.Tip="{l:T 'Traz a branch e as mudanças da máquina para um worktree neste PC, para o commit e o PR.'}" AutomationProperties.Name="{l:T 'Trazer para cá'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <v:Icone Nome="importar" Tamanho="12" VerticalAlignment="Center" />
            <TextBlock Text="{l:T 'Trazer para cá'}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Classes="contorno pequeno" Command="{Binding EncerrarNaMaquinaCommand}" IsVisible="{Binding PodeEncerrarNaMaquina}" Margin="8,0,0,0"
                ToolTip.Tip="{l:T 'Encerra o agente na máquina. A conversa fica aqui, e a próxima mensagem abre o agente de novo.'}" AutomationProperties.Name="{l:T 'Encerrar na máquina'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <v:Icone Nome="parar" Tamanho="12" VerticalAlignment="Center" />
            <TextBlock Text="{l:T 'Encerrar na máquina'}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="SugestaoDaNuvem" x:DataType="vm:ChatVM">
    <Border Classes="faixa-subagentes" v:Animacoes.Entrada="True">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,0">
        <v:Icone Nome="nuvem" Tamanho="14" Foreground="{DynamicResource Ciano}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding SugestaoNuvem}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="contorno pequeno" Content="{Binding TextoAceitarSugestao}" Command="{Binding AceitarSugestaoNuvemCommand}" Margin="10,0,0,0" />
        <Button Grid.Column="3" Classes="icone pequeno" Command="{Binding DispensarSugestaoNuvemCommand}" Margin="6,0,0,0"
                ToolTip.Tip="{l:T 'Continuar neste PC'}" AutomationProperties.Name="{l:T 'Continuar neste PC'}">
          <v:Icone Nome="fechar" Tamanho="12" />
        </Button>
      </Grid>
    </Border>
  </DataTemplate>

  <ControlTheme x:Key="CartaoDeMaquina" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Superficie}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
  </ControlTheme>

  <DataTemplate x:Key="LinhaDeMaquina" x:DataType="vm:MaquinaVM">
    <Border Theme="{StaticResource CartaoDeMaquina}" Margin="0,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <v:Icone Nome="nuvem" Tamanho="18" Foreground="{DynamicResource Ciano}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Border Classes="etiqueta-pilula" IsVisible="{Binding TemEstado}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Verde}" IsVisible="{Binding Ligada}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TextoEstado}" FontSize="11" />
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock Classes="mono fraco" Text="{Binding Endereco}" FontSize="12" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="fraco" Text="{Binding Situacao}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0" IsEnabled="{Binding !Ocupada}">
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding MostraEnergia}">
            <Button Classes="contorno pequeno" Content="{l:T 'Ligar'}" Command="{Binding LigarCommand}" IsVisible="{Binding MostraLigar}"
                    ToolTip.Tip="{l:T 'Liga ou retoma a máquina no InstaBox. As conversas na nuvem também ligam sozinhas.'}" />
            <Button Classes="contorno pequeno" Content="{l:T 'Pausar'}" Command="{Binding PausarCommand}" IsVisible="{Binding MostraPausar}"
                    ToolTip.Tip="{l:T 'Pausa a máquina guardando a memória. Pausada, ela só cobra o disco.'}" />
          </StackPanel>
          <Button Classes="contorno pequeno" Content="{l:T 'Testar conexão'}" Command="{Binding TestarCommand}" IsVisible="{Binding !Confirmando}" />
          <Button Classes="icone pequeno" Command="{Binding PedirApagarCommand}" IsVisible="{Binding !Confirmando}"
                  ToolTip.Tip="{Binding DicaTirar}" AutomationProperties.Name="{Binding DicaTirar}">
            <v:Icone Nome="lixeira" Tamanho="14" />
          </Button>
          <Button Classes="primario pequeno" Content="{Binding TextoTirar}" Command="{Binding ApagarCommand}" IsVisible="{Binding Confirmando}" />
          <Button Classes="fantasma pequeno" Content="{l:T 'Cancelar'}" Command="{Binding CancelarCommand}" IsVisible="{Binding Confirmando}" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="MaquinasNaNuvem" x:DataType="vm:MaquinasNaNuvemVM">
    <StackPanel Spacing="10">
      <TextBlock Classes="titulo-painel" Text="{l:T 'Máquinas na nuvem'}" />
      <TextBlock Classes="fraco" TextWrapping="Wrap"
                 Text="{l:T 'Deixe o agente (e até o projeto rodando) numa máquina na nuvem em vez de gastar o processador e a memória deste PC. Este PC só controla, e o agente continua lá mesmo com ele desligado. Cada conversa escolhe onde roda pelo botão Neste PC, ao lado do agente; o projeto precisa permitir a nuvem na página dele.'}" />
      <Border Classes="painel" IsVisible="{Binding TemAviso}" Padding="10,8">
        <Grid ColumnDefinitions="Auto,*">
          <v:Icone Nome="alerta" Tamanho="14" Foreground="{DynamicResource Laranja}" VerticalAlignment="Top" Margin="0,1,8,0" />
          <SelectableTextBlock Grid.Column="1" Text="{Binding Aviso}" TextWrapping="Wrap" FontSize="12.5" />
        </Grid>
      </Border>
      <ItemsControl ItemsSource="{Binding Maquinas}" ItemTemplate="{StaticResource LinhaDeMaquina}" IsVisible="{Binding TemMaquinas}" />
      <Button HorizontalAlignment="Left" Command="{Binding NovaMaquinaCommand}" IsVisible="{Binding !Formulario}">
        <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="mais" Tamanho="13" /><TextBlock Text="{l:T 'Conectar minha máquina (SSH)…'}" /></StackPanel>
      </Button>
      <Border Theme="{StaticResource CartaoDeMaquina}" IsVisible="{Binding Formulario}" v:Animacoes.Entrada="True">
        <StackPanel Spacing="10">
          <TextBlock Text="{l:T 'Minha máquina (SSH)'}" FontWeight="SemiBold" />
          <TextBlock Classes="fraco" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Uma VPS, a Oracle grátis, outro PC ou um Mac: qualquer máquina com SSH, git e o agente instalado.'}" />
          <Grid ColumnDefinitions="*,*,90" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock Classes="fraco" FontSize="12" Text="{l:T 'Endereço (host)'}" />
            <TextBlock Grid.Column="1" Classes="fraco" FontSize="12" Text="{l:T 'Usuário'}" />
            <TextBlock Grid.Column="2" Classes="fraco" FontSize="12" Text="{l:T 'Porta'}" />
            <TextBox Grid.Row="1" Classes="campo" Text="{Binding Host}" PlaceholderText="vps.exemplo.com" AutomationProperties.Name="{l:T 'Endereço (host)'}" />
            <TextBox Grid.Row="1" Grid.Column="1" Classes="campo" Text="{Binding Usuario}" PlaceholderText="ubuntu" AutomationProperties.Name="{l:T 'Usuário'}" />
            <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding Porta}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{l:T 'Porta'}" />
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Classes="fraco" FontSize="12" Text="{l:T 'Nome no Nexora'}" />
            <TextBox Classes="campo" Text="{Binding Nome}" AutomationProperties.Name="{l:T 'Nome no Nexora'}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240" />
          </StackPanel>
          <TextBlock Classes="fraco" FontSize="12" TextWrapping="Wrap" Text="{Binding TextoChave}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding TemLinhaPublica}">
            <SelectableTextBlock Classes="mono" Text="{Binding LinhaPublica}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="contorno pequeno" Command="{Binding CopiarChaveCommand}" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Copiar a linha pública'}">
              <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="copiar" Tamanho="12" /><TextBlock Text="{l:T 'Copiar'}" /></StackPanel>
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primario" Content="{l:T 'Testar conexão e salvar'}" Command="{Binding TestarNovaCommand}" />
            <Button Classes="fantasma" Content="{l:T 'Cancelar'}" Command="{Binding CancelarNovaCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Theme="{StaticResource CartaoDeMaquina}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <v:Icone Nome="nuvem" Tamanho="14" Foreground="{DynamicResource Ciano}" VerticalAlignment="Center" />
            <TextBlock Text="InstaBox" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="etiqueta-pilula" IsVisible="{Binding TemChaveInstaBox}"><TextBlock Text="{l:T 'chave guardada'}" FontSize="11" /></Border>
          </StackPanel>
          <TextBlock Classes="fraco" FontSize="12" TextWrapping="Wrap"
                     Text="{l:T 'O Nexora cria a máquina, entra pelo SSH com um certificado que vale uma hora e instala o Claude Code lá. Pausada, ela só cobra o disco, e uma conversa na nuvem liga a máquina sozinha. O InstaBox não diz quem opera o serviço nem publica termos de uso.'}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !TemChaveInstaBox}" MaxWidth="620" HorizontalAlignment="Left">
            <TextBox Classes="campo segredo" Text="{Binding ChaveInstaBox}" PasswordChar="•" RevealPassword="{Binding MostrandoChaveInstaBox}" MinWidth="320"
                     PlaceholderText="{l:T 'Cole a chave de API do InstaBox (ibk_…)'}" AutomationProperties.Name="{l:T 'Chave de API do InstaBox'}">
              <TextBox.InnerRightContent>
                <Button Classes="icone pequeno" Command="{Binding AlternarChaveInstaBoxCommand}" Margin="0,0,4,0" Focusable="False"
                        ToolTip.Tip="{l:T 'Mostrar ou esconder o valor'}" AutomationProperties.Name="{l:T 'Mostrar ou esconder o valor'}">
                  <Panel>
                    <v:Icone Nome="olho" Tamanho="14" IsVisible="{Binding !MostrandoChaveInstaBox}" />
                    <v:Icone Nome="olho-fechado" Tamanho="14" IsVisible="{Binding MostrandoChaveInstaBox}" />
                  </Panel>
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>
            <Button Grid.Column="1" Classes="primario" Content="{l:T 'Salvar'}" Command="{Binding SalvarChaveInstaBoxCommand}" IsEnabled="{Binding PodeSalvarChaveInstaBox}" Margin="8,0,0,0" />
          </Grid>
          <StackPanel Spacing="10" IsVisible="{Binding TemChaveInstaBox}">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !FormularioInstaBox}">
              <Button Command="{Binding NovaInstaBoxCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="mais" Tamanho="13" /><TextBlock Text="{l:T 'Criar máquina no InstaBox…'}" /></StackPanel>
              </Button>
              <Button Classes="fantasma" Content="{l:T 'Apagar a chave'}" Command="{Binding ApagarChaveInstaBoxCommand}" />
            </StackPanel>
            <StackPanel Spacing="10" IsVisible="{Binding FormularioInstaBox}" v:Animacoes.Entrada="True">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Classes="fraco" FontSize="12" Text="{l:T 'Nome no Nexora'}" />
                <TextBlock Grid.Column="1" Classes="fraco" FontSize="12" Text="{l:T 'Modelo'}" />
                <TextBox Grid.Row="1" Classes="campo" Text="{Binding NomeInstaBox}" MinWidth="240" AutomationProperties.Name="{l:T 'Nome no Nexora'}" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ModelosInstaBox}" SelectedItem="{Binding ModeloInstaBox}" MinWidth="240"
                          AutomationProperties.Name="{l:T 'Modelo'}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModeloInstaBoxVM">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Nome}" />
                        <TextBlock Classes="fraco" Text="{Binding Detalhe}" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primario" Content="{l:T 'Criar e conectar'}" Command="{Binding CriarInstaBoxCommand}" />
                <Button Classes="fantasma" Content="{l:T 'Cancelar'}" Command="{Binding CancelarInstaBoxCommand}" IsEnabled="{Binding !CriandoInstaBox}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Theme="{StaticResource CartaoDeMaquina}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <v:Icone Nome="nuvem" Tamanho="14" Foreground="{DynamicResource Ciano}" VerticalAlignment="Center" />
            <TextBlock Text="Freestyle" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="etiqueta-pilula" IsVisible="{Binding TemChaveFreestyle}"><TextBlock Text="{l:T 'chave guardada'}" FontSize="11" /></Border>
          </StackPanel>
          <TextBlock Classes="fraco" FontSize="12" TextWrapping="Wrap"
                     Text="{l:T 'O Nexora cria a máquina (Ubuntu com git, node e Claude Code), entra pelo SSH da Freestyle com um token que vale uma hora e a pausa quando a conversa termina. O plano grátis tem limite de horas por mês. A chave de API sai em dash.freestyle.sh.'}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !TemChaveFreestyle}" MaxWidth="620" HorizontalAlignment="Left">
            <TextBox Classes="campo segredo" Text="{Binding ChaveFreestyle}" PasswordChar="•" RevealPassword="{Binding MostrandoChaveFreestyle}" MinWidth="320"
                     PlaceholderText="{l:T 'Cole a chave de API da Freestyle'}" AutomationProperties.Name="{l:T 'Chave de API da Freestyle'}">
              <TextBox.InnerRightContent>
                <Button Classes="icone pequeno" Command="{Binding AlternarChaveFreestyleCommand}" Margin="0,0,4,0" Focusable="False"
                        ToolTip.Tip="{l:T 'Mostrar ou esconder o valor'}" AutomationProperties.Name="{l:T 'Mostrar ou esconder o valor'}">
                  <Panel>
                    <v:Icone Nome="olho" Tamanho="14" IsVisible="{Binding !MostrandoChaveFreestyle}" />
                    <v:Icone Nome="olho-fechado" Tamanho="14" IsVisible="{Binding MostrandoChaveFreestyle}" />
                  </Panel>
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>
            <Button Grid.Column="1" Classes="primario" Content="{l:T 'Salvar'}" Command="{Binding SalvarChaveFreestyleCommand}" IsEnabled="{Binding PodeSalvarChaveFreestyle}" Margin="8,0,0,0" />
          </Grid>
          <StackPanel Spacing="10" IsVisible="{Binding TemChaveFreestyle}">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !FormularioFreestyle}">
              <Button Command="{Binding NovaFreestyleCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="mais" Tamanho="13" /><TextBlock Text="{l:T 'Criar máquina na Freestyle…'}" /></StackPanel>
              </Button>
              <Button Classes="fantasma" Content="{l:T 'Apagar a chave'}" Command="{Binding ApagarChaveFreestyleCommand}" />
            </StackPanel>
            <StackPanel Spacing="10" IsVisible="{Binding FormularioFreestyle}" v:Animacoes.Entrada="True">
              <StackPanel Spacing="4" MaxWidth="306" HorizontalAlignment="Left">
                <TextBlock Classes="fraco" FontSize="12" Text="{l:T 'Nome no Nexora'}" />
                <TextBox Classes="campo" Text="{Binding NomeFreestyle}" MinWidth="240" AutomationProperties.Name="{l:T 'Nome no Nexora'}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primario" Content="{l:T 'Criar e conectar'}" Command="{Binding CriarFreestyleCommand}" />
                <Button Classes="fantasma" Content="{l:T 'Cancelar'}" Command="{Binding CancelarFreestyleCommand}" IsEnabled="{Binding !CriandoFreestyle}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Theme="{StaticResource CartaoDeMaquina}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <v:Icone Nome="chave" Tamanho="14" Classes="suave" VerticalAlignment="Center" />
            <TextBlock Text="{l:T 'Login do Claude na máquina'}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="etiqueta-pilula" IsVisible="{Binding TemToken}"><TextBlock Text="{l:T 'guardado'}" FontSize="11" /></Border>
          </StackPanel>
          <TextBlock Classes="fraco" FontSize="12" TextWrapping="Wrap" Text="{Binding TextoToken}" />
          <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding GuardaToken}" MaxWidth="620" HorizontalAlignment="Left">
            <TextBox Classes="campo segredo" Text="{Binding Token}" PasswordChar="•" RevealPassword="{Binding MostrandoToken}" MinWidth="320"
                     PlaceholderText="{l:T 'Cole aqui o token do claude setup-token'}" AutomationProperties.Name="{l:T 'Token do Claude'}">
              <TextBox.InnerRightContent>
                <Button Classes="icone pequeno" Command="{Binding AlternarTokenCommand}" Margin="0,0,4,0" Focusable="False"
                        ToolTip.Tip="{l:T 'Mostrar ou esconder o valor'}" AutomationProperties.Name="{l:T 'Mostrar ou esconder o valor'}">
                  <Panel>
                    <v:Icone Nome="olho" Tamanho="14" IsVisible="{Binding !MostrandoToken}" />
                    <v:Icone Nome="olho-fechado" Tamanho="14" IsVisible="{Binding MostrandoToken}" />
                  </Panel>
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>
            <Button Grid.Column="1" Classes="primario" Content="{l:T 'Salvar'}" Command="{Binding SalvarTokenCommand}" IsEnabled="{Binding PodeSalvarToken}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Classes="fantasma" Content="{l:T 'Apagar'}" Command="{Binding ApagarTokenCommand}" IsVisible="{Binding TemToken}" Margin="6,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="NuvemDoProjeto" x:DataType="vm:AmbienteVM">
    <Border Classes="painel">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <v:Icone Nome="nuvem" Classes="suave" />
            <TextBlock Classes="titulo-cartao" Text="{l:T 'Pode ir para a nuvem'}" />
          </StackPanel>
          <TextBlock Classes="fraco" TextWrapping="Wrap" FontSize="12" Text="{Binding TextoNuvem}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding PodeIrParaNuvem}" OnContent="" OffContent="" VerticalAlignment="Center"
                      AutomationProperties.Name="{l:T 'Pode ir para a nuvem'}" />
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
