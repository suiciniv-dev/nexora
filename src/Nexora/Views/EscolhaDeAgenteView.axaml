<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:c="using:Nexora.Controles"
             x:Class="Nexora.Views.EscolhaDeAgenteView"
             x:DataType="vm:EscolhaDeAgenteVM">
  <UserControl.Styles>
    <Style Selector="Button.cartao-agente">
      <Setter Property="Width" Value="300" />
      <Setter Property="Height" Value="210" />
      <Setter Property="Margin" Value="10" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#E61C1B1A" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#F2F0EC" />
    </Style>
    <Style Selector="Button.cartao-agente:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F2242320" />
      <Setter Property="BorderBrush" Value="#66FFFFFF" />
      <Setter Property="Foreground" Value="#F2F0EC" />
    </Style>
    <Style Selector="Button.cartao-agente.escolhido /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.cartao-agente.ausente">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="TextBlock.estado-agente">
      <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="LetterSpacing" Value="1.6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#9C978F" />
    </Style>
    <Style Selector="TextBlock.estado-agente.ok">
      <Setter Property="Foreground" Value="#C9C6BF" />
    </Style>
  </UserControl.Styles>
  <Panel Background="#0E1024">
    <c:FundoVivo Estilo="nexora:constelacao" Modo="animado" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40" Spacing="8">
        <TextBlock Text="{l:T 'NEXORA · PRIMEIRO PASSO'}" FontFamily="{DynamicResource Mono}" FontSize="12" LetterSpacing="3" Foreground="#9C978F" HorizontalAlignment="Center" />
        <TextBlock Text="{l:T 'Qual é o seu agente?'}" FontSize="40" FontWeight="SemiBold" Foreground="#F2F0EC" HorizontalAlignment="Center" />
        <TextBlock Text="{l:T 'As sessões rodam neste computador, com o login do próprio agente.'}" FontSize="16" Foreground="#C9C6BF" HorizontalAlignment="Center" />
        <TextBlock Text="{l:T 'Escolha qual abre as sessões por padrão. Dá para trocar em cada conversa e instalar outros quando quiser.'}"
                   FontFamily="{DynamicResource Mono}" FontSize="12" Foreground="#9C978F" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="720" Margin="0,4,0,18" />
        <ItemsControl ItemsSource="{Binding Cartoes}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CartaoAgenteVM">
              <Button Classes="cartao-agente" Classes.escolhido="{Binding Escolhido}" Classes.ausente="{Binding !Detectado}" Command="{Binding EscolherCommand}"
                      AutomationProperties.Name="{Binding Nome}">
                <StackPanel Spacing="10">
                  <c:AvatarVivo Agente="{Binding Id}" Comemorar="{Binding Escolhido}" Rotulo="" Width="64" Height="64" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Nome}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Empresa}" FontFamily="{DynamicResource Mono}" FontSize="10.5" LetterSpacing="1.4" Foreground="#7F7A72" HorizontalAlignment="Center" Margin="0,-6,0,0" />
                  <TextBlock Classes="estado-agente" Classes.ok="{Binding Detectado}" Text="{Binding TextoEstado}" />
                  <TextBlock Text="{Binding Descricao}" FontSize="12" Foreground="#9C978F" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Outros}" IsVisible="{Binding TemOutros}" FontSize="12.5" Foreground="#9C978F" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="720" HorizontalAlignment="Center" Margin="0,6,0,0" />
        <Border IsVisible="{Binding TemAviso}" Background="#26F0A860" BorderBrush="#66F0A860" BorderThickness="1" CornerRadius="10" Padding="14,10" MaxWidth="640" Margin="0,8,0,0" HorizontalAlignment="Center">
          <SelectableTextBlock Text="{Binding Aviso}" Foreground="#F2E6D2" TextWrapping="Wrap" FontSize="13" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,16,0,0">
          <Button Classes="fantasma" Command="{Binding ProcurarCommand}" Foreground="#C9C6BF">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <c:Icone Nome="atualizar" Tamanho="14" />
              <TextBlock Text="{l:T 'PROCURAR DE NOVO'}" FontFamily="{DynamicResource Mono}" LetterSpacing="1.6" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="primario" Command="{Binding ContinuarCommand}" Padding="22,9">
            <TextBlock Text="{l:T 'Continuar'}" FontSize="14" />
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
