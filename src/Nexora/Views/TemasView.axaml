<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:v="using:Nexora.Views"
             x:Class="Nexora.Views.TemasView"
             x:DataType="vm:TemasVM">
  <UserControl.Styles>
    <Style Selector="ItemsControl.cartoes-tema">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="14">
    <Border Classes="aviso" IsVisible="{Binding TemMensagem}">
      <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
    </Border>

    <StackPanel Spacing="12" IsVisible="{Binding NaGaleria}">
      <ItemsControl ItemsSource="{Binding Grupos}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GrupoTemasVM">
            <StackPanel Spacing="8" Margin="0,0,0,6">
              <StackPanel Spacing="2">
                <TextBlock Classes="secao-geral" Text="{Binding Titulo}" />
                <TextBlock Classes="fraco" Text="{Binding Descricao}" TextWrapping="Wrap" FontSize="12.5" />
              </StackPanel>
              <ItemsControl Classes="cartoes-tema" ItemsSource="{Binding Cartoes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TemaCartaoVM">
                    <Panel Width="188" Margin="0,0,10,10">
                      <Button Theme="{StaticResource CartaoDeTema}" Classes.em-uso="{Binding EmUso}" Command="{Binding UsarCommand}"
                              AutomationProperties.Name="{Binding NomeAcessivel}" AutomationProperties.HelpText="{Binding Descricao}">
                        <StackPanel Spacing="8">
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PreviaDoTema}" />
                          <StackPanel Spacing="1" Margin="2,0,30,0">
                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="fraco" Text="{Binding Descricao}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                      <Border IsVisible="{Binding EmUso}" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Acento}" BorderBrush="{DynamicResource Superficie}" BorderThickness="2"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" IsHitTestVisible="False" ToolTip.Tip="{l:T 'em uso'}">
                        <v:Icone Nome="ok" Tamanho="11" Foreground="{DynamicResource SobreAcento}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Button Classes="icone pequeno" IsVisible="{Binding PodeDuplicar}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,12"
                              ToolTip.Tip="{l:T 'Mais ações do tema'}" AutomationProperties.Name="{l:T 'Mais ações do tema'}">
                        <v:Icone Nome="mais-acoes" Tamanho="14" />
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="{l:T 'Duplicar e editar'}" Command="{Binding DuplicarCommand}" />
                            <MenuItem Header="{l:T 'Editar'}" Command="{Binding EditarCommand}" IsVisible="{Binding Meu}" />
                            <MenuItem Header="{l:T 'Exportar'}" Click="Exportar_Click" />
                            <MenuItem Header="{l:T 'Apagar'}" Command="{Binding ApagarCommand}" IsVisible="{Binding Meu}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Classes="contorno" Command="{Binding NovoTemaCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="lapis" Tamanho="13" /><TextBlock Text="{l:T 'Criar um tema a partir do atual'}" /></StackPanel>
        </Button>
        <Button Classes="contorno" Click="Importar_Click">
          <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="importar" Tamanho="13" /><TextBlock Text="{l:T 'Importar tema'}" /></StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>

    <ContentControl IsVisible="{Binding Editando}" Content="{Binding Editor}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:TemaEditorVM">
          <StackPanel Spacing="16">
            <WrapPanel ItemSpacing="10" LineSpacing="8">
              <Button Classes="primario" Command="{Binding SalvarCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="ok" Tamanho="14" /><TextBlock Text="{l:T 'Salvar e usar'}" /></StackPanel>
              </Button>
              <Button Classes="contorno" Content="{l:T 'Cancelar'}" Command="{Binding CancelarCommand}" />
              <TextBlock Classes="fraco" Text="{l:T 'O app inteiro já mostra o tema enquanto você edita.'}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Spacing="6">
                <TextBlock Classes="titulo-painel" Text="{l:T 'Nome'}" />
                <TextBox Classes="campo" Text="{Binding Nome}" AutomationProperties.Name="{l:T 'Nome do tema'}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="titulo-painel" Text="{l:T 'Base'}" />
                <ToggleSwitch IsChecked="{Binding Escuro}" OnContent="{l:T 'Escuro'}" OffContent="{l:T 'Claro'}" AutomationProperties.Name="{l:T 'Tema escuro'}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="6" Margin="0,14,0,0">
                <TextBlock Classes="titulo-painel" Text="{l:T 'Fundo animado'}" />
                <ComboBox ItemsSource="{Binding FundosAnimados}" SelectedItem="{Binding FundoAnimado}" HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                          AutomationProperties.Name="{l:T 'Fundo animado'}" />
                <TextBlock Classes="fraco" Text="{l:T 'Escurecer o fundo (animado ou imagem)'}" Margin="0,4,0,0" />
                <Slider Minimum="0" Maximum="0.95" Value="{Binding Escurecer}" AutomationProperties.Name="{l:T 'Escurecer o fundo (animado ou imagem)'}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6" Margin="0,14,0,0">
                <TextBlock Classes="titulo-painel" Text="{l:T 'Imagem de fundo'}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="contorno" Click="Imagem_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="pasta" Tamanho="14" /><TextBlock Text="{l:T 'Escolher imagem'}" /></StackPanel>
                  </Button>
                  <Button Classes="fantasma" Content="{l:T 'Tirar'}" Command="{Binding TirarImagemCommand}" IsVisible="{Binding TemImagem}" />
                </StackPanel>
                <TextBlock Classes="fraco" Text="{Binding Imagem}" TextTrimming="CharacterEllipsis" IsVisible="{Binding TemImagem}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,14,0,0">
                <TextBlock Classes="titulo-painel" Text="{l:T 'Fonte do código'}" />
                <ComboBox ItemsSource="{Binding Fontes}" SelectedItem="{Binding FonteCodigo}" HorizontalAlignment="Stretch" MaxDropDownHeight="320"
                          AutomationProperties.Name="{l:T 'Fonte do código'}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6" Margin="0,14,0,0">
                <TextBlock Classes="titulo-painel" Text="{l:T 'Cores do código no editor'}" />
                <ComboBox ItemsSource="{Binding TemasDeEditor}" SelectedItem="{Binding TemaEditor}" HorizontalAlignment="Stretch" MaxDropDownHeight="320"
                          AutomationProperties.Name="{l:T 'Cores do código no editor'}" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="10">
              <TextBlock Classes="titulo-painel" Text="{l:T 'Cores'}" />
              <TextBlock Classes="fraco" Text="{l:T 'Clique na amostra para escolher no seletor, ou digite o hex.'}" />
              <ItemsControl ItemsSource="{Binding Cores}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CorVM">
                    <Grid ColumnDefinitions="Auto,*,104" Margin="0,4,18,4">
                      <Button Classes="amostra" Background="{Binding Pincel}" ToolTip.Tip="{l:T 'Escolher a cor'}" AutomationProperties.Name="{Binding Rotulo}">
                        <Button.Flyout>
                          <Flyout Placement="RightEdgeAlignedTop">
                            <ColorView Color="{Binding Cor}" IsAlphaEnabled="True" IsAlphaVisible="True" IsColorPaletteVisible="False" Width="300" />
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      <TextBlock Grid.Column="1" Text="{Binding Rotulo}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
                      <TextBox Grid.Column="2" Classes="campo mono-campo" Text="{Binding Hex}" AutomationProperties.Name="{Binding Rotulo}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </StackPanel>
</UserControl>
