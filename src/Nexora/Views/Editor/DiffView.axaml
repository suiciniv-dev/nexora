<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora.Traducao"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:v="using:Nexora.Views"
             xmlns:c="using:Nexora.Controles"
             x:Class="Nexora.Views.DiffView"
             x:DataType="vm:DiffVM">
  <UserControl.Styles>
    <Style Selector="c|Caixa.linha-diff:pointerover c|Botao.comentar-linha">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="c|Caixa.linha-diff.na-faixa">
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="14,6,8,6" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1">
      <DockPanel>
        <c:Botao DockPanel.Dock="Right" Classes="fantasma" Command="{Binding AbrirArquivoCommand}" IsVisible="{Binding PodeAbrir}">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="arquivo" Tamanho="14" /><TextBlock Text="{l:T 'Abrir arquivo'}" FontSize="12.5" /></StackPanel>
        </c:Botao>
        <TextBlock DockPanel.Dock="Right" Classes="menos" Text="{Binding Removidas, StringFormat='−{0}'}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock DockPanel.Dock="Right" Classes="mais" Text="{Binding Adicionadas, StringFormat='+{0}'}" VerticalAlignment="Center" Margin="12,0,8,0" />
        <c:Icone DockPanel.Dock="Left" Nome="diff" Tamanho="15" Classes="suave" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="mono" Text="{Binding Caminho}" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding Caminho}" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="14,6,8,6" Background="{DynamicResource AcentoFundo}" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1"
            IsVisible="{Binding Revisao.TemItens, FallbackValue=False}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <c:Botao x:Name="BotaoPendentes" Classes="mini" Command="{Binding Revisao.AlternarListaCommand, FallbackValue={x:Null}}"
                ToolTip.Tip="{l:T 'Ver, editar ou apagar os comentários antes de mandar'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icone Nome="conversa" Tamanho="12" />
            <TextBlock Text="{Binding Revisao.TextoQuantidade, FallbackValue=''}" />
            <c:Icone Nome="abaixo" Tamanho="11" />
          </StackPanel>
        </c:Botao>
        <Popup Grid.Column="0" PlacementTarget="{Binding #BotaoPendentes}" Placement="BottomEdgeAlignedLeft" VerticalOffset="4" IsLightDismissEnabled="True"
               IsOpen="{Binding Revisao.ListaAberta, Mode=TwoWay, FallbackValue=False}">
          <Border Theme="{DynamicResource Flutuante}" Padding="8" Width="420" v:Animacoes.Entrada="True">
            <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Revisao.Itens, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ComentarioPendenteVM">
                    <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="8" Background="{DynamicResource Superficie}">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Classes="mono fraco" Text="{Binding Onde}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Arquivo}" />
                          <c:Botao Grid.Column="1" Classes="icone pequeno" Command="{Binding EditarCommand}" IsVisible="{Binding !Editando}"
                                  ToolTip.Tip="{l:T 'Editar o comentário'}" AutomationProperties.Name="{l:T 'Editar o comentário'}">
                            <c:Icone Nome="lapis" Tamanho="11" />
                          </c:Botao>
                          <c:Botao Grid.Column="2" Classes="icone pequeno" Command="{Binding ApagarCommand}"
                                  ToolTip.Tip="{l:T 'Apagar o comentário'}" AutomationProperties.Name="{l:T 'Apagar o comentário'}">
                            <c:Icone Nome="lixeira" Tamanho="11" />
                          </c:Botao>
                        </Grid>
                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" FontSize="12.5" IsVisible="{Binding !Editando}" />
                        <StackPanel Spacing="6" IsVisible="{Binding Editando}">
                          <TextBox Classes="campo" Text="{Binding Edicao}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                   AutomationProperties.Name="{l:T 'Editar o comentário'}" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Botao Classes="primario pequeno" Command="{Binding SalvarEdicaoCommand}" Content="{l:T 'Salvar'}" />
                            <c:Botao Classes="contorno pequeno" Command="{Binding CancelarEdicaoCommand}" Content="{l:T 'Cancelar'}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Popup>
        <TextBlock Grid.Column="1" Classes="fraco" Text="{l:T 'Ficam aqui até você mandar. Valem para todos os diffs desta conversa.'}" FontSize="11.5"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" />
        <c:Botao Grid.Column="2" Classes="contorno pequeno" Command="{Binding Revisao.DescartarCommand, FallbackValue={x:Null}}" Content="{l:T 'Descartar'}" Margin="0,0,6,0"
                ToolTip.Tip="{l:T 'Apaga todos os comentários pendentes'}" />
        <c:Botao Grid.Column="3" Classes="primario pequeno" Command="{Binding Revisao.MandarCommand, FallbackValue={x:Null}}"
                ToolTip.Tip="{l:T 'Manda todos os comentários de uma vez para a conversa, com arquivo, linhas e o trecho do código'}">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="enviar" Tamanho="12" /><TextBlock Text="{l:T 'Mandar para o agente'}" /></StackPanel>
        </c:Botao>
      </Grid>
    </Border>
    <Panel>
      <TextBlock Classes="suave" Text="{l:T 'Sem diferenças.'}" IsVisible="{Binding Vazio}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ListBox x:Name="Lista" Classes="diff" ItemsSource="{Binding Linhas}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LinhaDiffVM">
            <StackPanel>
              <c:Caixa Classes="linha-diff" Classes.adicionada="{Binding Adicionada}" Classes.removida="{Binding Removida}" Classes.cabecalho="{Binding Cabecalho}"
                      Classes.na-faixa="{Binding NaFaixa}">
                <Grid ColumnDefinitions="44,44,22,20,*,Auto">
                  <TextBlock Classes="num" Text="{Binding Antiga}" />
                  <TextBlock Grid.Column="1" Classes="num" Text="{Binding Nova}" />
                  <c:Botao Grid.Column="2" Theme="{StaticResource BotaoComentarLinha}" Classes="comentar-linha" IsVisible="{Binding Comentavel}" Click="Comentar_Click"
                          ToolTip.Tip="{l:T 'Comentar esta linha. Com Shift, estende o comentário até aqui.'}" AutomationProperties.Name="{l:T 'Comentar a linha'}">
                    <c:Icone Nome="mais" Tamanho="11" />
                  </c:Botao>
                  <TextBlock Grid.Column="3" Classes="marca-diff" Text="{Binding Marca}" />
                  <TextBlock Grid.Column="4" Classes="codigo" Text="{Binding Texto}" />
                  <Button Grid.Column="5" Theme="{StaticResource BotaoPilhaDeAvatares}" IsVisible="{Binding TemResolvidas}" Command="{Binding AlternarResolvidasCommand}"
                          ToolTip.Tip="{Binding DicaResolvidas}" AutomationProperties.Name="{Binding DicaResolvidas}" Margin="6,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <ItemsControl Theme="{StaticResource PilhaDeAvatares}" ItemsSource="{Binding ResolvidasVisiveis}" />
                      <TextBlock Classes="fraco" Text="{Binding MaisResolvidas}" IsVisible="{Binding TemMaisResolvidas}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </c:Caixa>
              <ItemsControl ItemsSource="{Binding Conversas}" ItemTemplate="{StaticResource ConversaNaLinha}" />
              <ItemsControl ItemsSource="{Binding Comentarios}" ItemTemplate="{StaticResource ComentarioPendenteNaLinha}" />
              <c:Caixa Theme="{StaticResource CaixaDeComentario}" Classes="pendente" IsVisible="{Binding Escrevendo}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="fraco" FontSize="11" FontFamily="{DynamicResource FonteUi}">
                    <Run Text="{l:T 'Comentário para o agente'}" />
                    <Run Text="·" />
                    <Run Text="{Binding FaixaDoRascunho}" />
                  </TextBlock>
                  <TextBox x:Name="CampoComentario" Classes="campo" Text="{Binding Rascunho}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                           FontFamily="{DynamicResource FonteUi}" PlaceholderText="{l:T 'O que o agente deve mudar aqui?'}"
                           AutomationProperties.Name="{l:T 'Comentário para o agente'}" />
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Classes="fraco" Text="{l:T 'Ctrl+Enter guarda. Shift+clique no + de outra linha estende o intervalo.'}" FontSize="11"
                               FontFamily="{DynamicResource FonteUi}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <c:Botao Grid.Column="1" Classes="contorno pequeno" Command="{Binding CancelarCommand}" Content="{l:T 'Cancelar'}" Margin="8,0,6,0" />
                    <c:Botao Grid.Column="2" Classes="primario pequeno" Command="{Binding ConfirmarCommand}" Content="{l:T 'Comentar'}" />
                  </Grid>
                </StackPanel>
              </c:Caixa>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
