<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora.Traducao"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:c="using:Nexora.Controles"
             x:Class="Nexora.Views.ProjetosView"
             x:DataType="vm:ProjetosVM">
  <UserControl.Styles>
    <Style Selector="c|Botao.projeto">
      <Setter Property="Width" Value="340" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="c|Botao.projeto:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextoFraco}" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="c|Botao.projeto.destacado /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="{DynamicResource BrilhoCaixa}" />
    </Style>
    <Style Selector="ItemsControl.cartoes-projeto">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Window.vertical ItemsControl.cartoes-projeto">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <c:GradeAdaptativa LarguraMinima="340" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Window.vertical c|Botao.projeto">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>
  <Panel x:Name="AreaDeSoltar" Background="Transparent">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1100" Margin="40,30,40,36" Spacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{l:T 'Projetos'}" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Classes="suave" Text="{l:T 'Cada projeto é uma pasta de código. Com um .code-workspace, as pastas vinculadas entram junto.'}" TextWrapping="Wrap" />
          <TextBlock Classes="fraco" Text="{l:T 'Dica: arraste pastas para cá ou para a lateral e elas viram projetos.'}" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
          <c:Botao Classes="contorno" Click="AdicionarProjeto_Click" ToolTip.Tip="{l:T 'Escolher a pasta de um projeto que já existe'}">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="pasta" Tamanho="14" /><TextBlock Text="{l:T 'Adicionar pasta'}" /></StackPanel>
          </c:Botao>
          <c:Botao Classes="contorno" Command="{Binding NovoProjetoCommand}" ToolTip.Tip="{l:T 'Montar um projeto com uma pasta principal e outras vinculadas'}">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="mais" Tamanho="14" /><TextBlock Text="{l:T 'Novo projeto'}" /></StackPanel>
          </c:Botao>
        </StackPanel>
      </Grid>
      <c:Caixa Classes="painel" IsVisible="{Binding Vazio}" Padding="24,22">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Text="{l:T 'Nenhum projeto ainda'}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Classes="suave" TextWrapping="Wrap" Text="{l:T 'Um projeto é a pasta do seu código. Escolha a pasta de um projeto, ou a pasta onde ficam vários: cada repositório git dentro dela vira um projeto.'}" />
            <TextBlock Classes="fraco" TextWrapping="Wrap" Text="{Binding TextoRaizes}" IsVisible="{Binding TemRaizes}" />
          </StackPanel>
          <WrapPanel>
            <c:Botao Classes="primario" Click="AdicionarProjeto_Click" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="7"><c:Icone Nome="pasta" Tamanho="14" /><TextBlock Text="{l:T 'Escolher a pasta de um projeto'}" /></StackPanel>
            </c:Botao>
            <c:Botao Classes="contorno" Click="AdicionarRaiz_Click" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="7"><c:Icone Nome="camadas" Tamanho="14" /><TextBlock Text="{l:T 'Escolher a pasta onde ficam vários'}" /></StackPanel>
            </c:Botao>
            <c:Botao Classes="contorno" Click="Importar_Click" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="7"><c:Icone Nome="importar" Tamanho="14" /><TextBlock Text="{l:T 'Importar um .code-workspace'}" /></StackPanel>
            </c:Botao>
          </WrapPanel>
        </StackPanel>
      </c:Caixa>
      <ItemsControl Classes="cartoes-projeto" ItemsSource="{Binding Cartoes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CartaoProjetoVM">
            <c:Botao Classes="projeto" Classes.destacado="{Binding Destacado}" Command="{Binding AbrirCommand}">
              <c:Botao.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{l:T 'Abrir o projeto'}" Command="{Binding AbrirCommand}" />
                  <MenuItem Header="{l:T 'Nova sessão'}" Command="{Binding NovaSessaoCommand}" />
                  <MenuItem Header="{l:T 'Abrir a pasta'}" Command="{Binding Ambiente.AbrirPastaCommand}" />
                  <MenuItem Header="{l:T 'Abrir no VS Code'}" Command="{Binding Ambiente.AbrirNoVsCodeCommand}" />
                  <Separator />
                  <MenuItem Header="{l:T 'Excluir projeto…'}" Command="{Binding ExcluirCommand}" />
                </ContextMenu>
              </c:Botao.ContextMenu>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <Panel VerticalAlignment="Top" Margin="0,0,14,0">
                  <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource MarcaGradiente}" IsVisible="{Binding !Ambiente.TemIconeRepo}">
                    <TextBlock Text="{Binding Iniciais}" Foreground="{DynamicResource SobreMarca}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Width="40" Height="40" CornerRadius="11" ClipToBounds="True" Background="{DynamicResource SuperficieAlta}" IsVisible="{Binding Ambiente.TemIconeRepo}">
                    <Image Source="{Binding Ambiente.IconeRepo}" Stretch="UniformToFill" />
                  </Border>
                </Panel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icone Nome="branch" Tamanho="12" Classes="fraco" VerticalAlignment="Center" />
                    <TextBlock Classes="fraco mono" Text="{Binding Branch}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                  </StackPanel>
                  <TextBlock Classes="fraco" Text="{Binding Vinculados}" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Classes="estado trabalhando" IsVisible="{Binding TemSessoes}" VerticalAlignment="Center" />
                      <TextBlock Classes="suave" Text="{Binding Sessoes}" FontSize="12.5" />
                    </StackPanel>
                    <TextBlock Classes="fraco" Text="{Binding Ultima}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <c:Botao Classes="contorno pequeno" Command="{Binding NovaSessaoCommand}" ToolTip.Tip="{l:T 'Começar uma sessão neste projeto'}">
                      <StackPanel Orientation="Horizontal" Spacing="5"><c:Icone Nome="mais" Tamanho="12" /><TextBlock Text="{l:T 'Sessão'}" /></StackPanel>
                    </c:Botao>
                    <c:Botao Classes="icone pequeno" ToolTip.Tip="{l:T 'Mais opções'}" AutomationProperties.Name="{l:T 'Mais opções do projeto'}">
                      <c:Icone Nome="mais-acoes" Tamanho="14" />
                      <c:Botao.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="{l:T 'Abrir a pasta'}" Command="{Binding Ambiente.AbrirPastaCommand}" />
                          <MenuItem Header="{l:T 'Abrir no VS Code'}" Command="{Binding Ambiente.AbrirNoVsCodeCommand}" />
                          <Separator />
                          <MenuItem Header="{l:T 'Excluir projeto…'}" Command="{Binding ExcluirCommand}" />
                        </MenuFlyout>
                      </c:Botao.Flyout>
                    </c:Botao>
                  </StackPanel>
                </Grid>
              </Grid>
            </c:Botao>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
  <Border x:Name="RealceSoltar" Theme="{StaticResource ZonaDeSoltar}" Margin="24">
    <Border Background="{DynamicResource AcentoFundo}" CornerRadius="12">
      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <c:Icone Nome="pasta" Tamanho="34" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center" />
        <TextBlock Text="{l:T 'Solte para adicionar como projeto'}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="fraco" Text="{l:T 'Só pastas viram projeto.'}" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</UserControl>
