<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:v="using:Nexora.Views"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Nexora.Views.ExecutarView"
             x:DataType="vm:ExecutarVM">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1" Padding="28,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <v:Icone Nome="executar" Tamanho="17" Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Classes="fraco" Text="{l:T 'launch.json, launchSettings.json e package.json do ambiente'}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding MostraOndeRoda}" VerticalAlignment="Center">
          <v:Icone Nome="nuvem" Tamanho="13" Foreground="{DynamicResource Ciano}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding OpcoesOndeRoda}" SelectedItem="{Binding OndeRoda}" MinWidth="170" AutomationProperties.Name="{l:T 'Onde executar'}"
                    ToolTip.Tip="{l:T 'Onde o projeto roda: neste PC ou numa máquina na nuvem. Na nuvem, a porta chega aqui por um túnel SSH e abre no localhost.'}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OndeExecutaVM">
                <TextBlock Text="{Binding Nome}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <Button Classes="contorno pequeno" Command="{Binding RecarregarCommand}" ToolTip.Tip="{l:T 'Procurar de novo'}">
          <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="atualizar" Tamanho="12" /><TextBlock Text="{l:T 'Atualizar'}" /></StackPanel>
        </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Panel>
      <StackPanel IsVisible="{Binding Vazio}" Margin="28,32" Spacing="8" HorizontalAlignment="Left">
        <TextBlock Classes="suave" Text="{l:T 'Nada para executar neste ambiente.'}" />
        <TextBlock Classes="fraco" TextWrapping="Wrap" MaxWidth="560"
                   Text="{l:T 'O Nexora lê as configurações coreclr do .vscode/launch.json, os perfis Project dos Properties/launchSettings.json e os scripts do package.json.'}" />
      </StackPanel>

      <Grid IsVisible="{Binding !Vazio}" ColumnDefinitions="380,1,*">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ListBox Classes="lista" ItemsSource="{Binding Alvos}" SelectedItem="{Binding Selecionado}" Margin="12,12,12,12">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AlvoVM">
                <StackPanel Spacing="6" Margin="4,6">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Classes="estado" Classes.trabalhando="{Binding EstaRodando}" Classes.pronta="{Binding EstaPronto}" Classes.erro="{Binding TemErro}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                      <Button Classes="icone pequeno" Command="{Binding ExecutarCommand}" IsVisible="{Binding Parado}" ToolTip.Tip="{l:T 'Executar'}" AutomationProperties.Name="{l:T 'Executar'}">
                        <v:Icone Nome="executar" Tamanho="12" />
                      </Button>
                      <Button Classes="icone pequeno" Command="{Binding ReiniciarCommand}" IsVisible="{Binding Ativo}" ToolTip.Tip="{l:T 'Reiniciar'}" AutomationProperties.Name="{l:T 'Reiniciar'}">
                        <v:Icone Nome="atualizar" Tamanho="12" />
                      </Button>
                      <Button Classes="icone pequeno" Command="{Binding PararCommand}" IsVisible="{Binding Ativo}" ToolTip.Tip="{l:T 'Parar'}" AutomationProperties.Name="{l:T 'Parar'}">
                        <v:Icone Nome="parar" Tamanho="12" />
                      </Button>
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="fraco" Text="{Binding Detalhe}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding TemPorta}" Margin="0,0,12,0">
                      <TextBlock Classes="fraco" Text="{l:T 'Porta'}" FontSize="12" VerticalAlignment="Center" />
                      <TextBox Classes="campo" Text="{Binding Porta}" Width="76" FontSize="12" IsEnabled="{Binding Parado}" />
                    </StackPanel>
                    <TextBlock Classes="fraco" Text="{Binding EstadoTexto}" FontSize="12" VerticalAlignment="Center" />
                  </WrapPanel>
                  <Button Classes="fantasma pequeno" Command="{Binding AbrirCommand}" IsVisible="{Binding TemEndereco}" HorizontalAlignment="Left" Padding="0,2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <v:Icone Nome="externo" Tamanho="12" />
                      <TextBlock Text="{Binding Endereco}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="{Binding Aviso}" Foreground="{DynamicResource Laranja}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding TemAviso}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource Borda}" />

        <DockPanel Grid.Column="2" IsVisible="{Binding TemSelecionado}">
          <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Selecionado.Nome, FallbackValue=''}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Classes="fraco" Text="{Binding Selecionado.EstadoTexto, FallbackValue=''}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="contorno pequeno" Command="{Binding Selecionado.AbrirAquiCommand, FallbackValue={x:Null}}" IsVisible="{Binding Selecionado.PodeAbrirNoNexora, FallbackValue=False}"
                        Content="{l:T 'Abrir no Nexora'}" ToolTip.Tip="{l:T 'Abre no navegador embutido, ao lado da conversa deste projeto'}" />
                <Button Classes="contorno pequeno" Command="{Binding Selecionado.AbrirCommand, FallbackValue={x:Null}}" IsVisible="{Binding Selecionado.TemEndereco, FallbackValue=False}"
                        Content="{l:T 'Abrir no navegador'}" />
                <Button Classes="primario pequeno" Command="{Binding Selecionado.ExecutarCommand, FallbackValue={x:Null}}" IsVisible="{Binding Selecionado.Parado, FallbackValue=False}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="executar" Tamanho="11" /><TextBlock Text="{l:T 'Executar'}" /></StackPanel>
                </Button>
                <Button Classes="contorno pequeno" Command="{Binding Selecionado.PararCommand, FallbackValue={x:Null}}" IsVisible="{Binding Selecionado.Ativo, FallbackValue=False}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><v:Icone Nome="parar" Tamanho="11" /><TextBlock Text="{l:T 'Parar'}" /></StackPanel>
                </Button>
                <Button Classes="fantasma pequeno" Command="{Binding Selecionado.LimparCommand, FallbackValue={x:Null}}" Content="{l:T 'Limpar'}" />
              </StackPanel>
            </Grid>
          </Border>
          <ae:TextEditor x:Name="Saida" IsReadOnly="True" FontFamily="{DynamicResource Mono}" FontSize="12.5" Padding="12,8"
                         WordWrap="True" Background="Transparent" />
        </DockPanel>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
