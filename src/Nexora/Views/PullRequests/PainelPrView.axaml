<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora.Traducao"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:c="using:Nexora.Controles"
             x:Class="Nexora.Views.PainelPrView"
             x:DataType="vm:PainelPrVM">
  <UserControl.Styles>
    <Style Selector="TextBlock.secao-pr">
      <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.estado-pr">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource DiffMais}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.estado-pr > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Verde}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.estado-pr.rascunho">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
    </Style>
    <Style Selector="Border.estado-pr.rascunho > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}" />
    </Style>
    <Style Selector="Border.estado-pr.mergeado">
      <Setter Property="Background" Value="{DynamicResource AcentoFundo}" />
    </Style>
    <Style Selector="Border.estado-pr.mergeado > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Acento}" />
    </Style>
    <Style Selector="Border.estado-pr.fechado">
      <Setter Property="Background" Value="{DynamicResource ErroFundo}" />
    </Style>
    <Style Selector="Border.estado-pr.fechado > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Vermelho}" />
    </Style>
    <Style Selector="Button.linha-pr">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="-6,0" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="Button.linha-pr:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="c|Icone.falhou">
      <Setter Property="Foreground" Value="{DynamicResource Vermelho}" />
    </Style>
    <Style Selector="c|Icone.ok">
      <Setter Property="Foreground" Value="{DynamicResource Verde}" />
    </Style>
    <Style Selector="c|Icone.pendente">
      <Setter Property="Foreground" Value="{DynamicResource Laranja}" />
    </Style>
    <Style Selector="c|Icone.pulado">
      <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
    </Style>
    <Style Selector="Border.conversa-pr">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.alerta-pr">
      <Setter Property="Background" Value="{DynamicResource ErroFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Vermelho}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.alerta-pr.atencao">
      <Setter Property="Background" Value="{DynamicResource PedidoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Laranja}" />
    </Style>
    <Style Selector="Border.avatar-pr">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource MarcaGradiente}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.avatar-pr > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SobreMarca}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,12,18,18" Spacing="18">

      <StackPanel Spacing="8" IsVisible="{Binding Carregando}">
        <Border Classes="esqueleto" Height="14" Width="120" HorizontalAlignment="Left" CornerRadius="4" />
        <Border Classes="esqueleto" Height="18" CornerRadius="4" />
        <Border Classes="esqueleto" Height="12" Width="180" HorizontalAlignment="Left" CornerRadius="4" />
        <TextBlock Classes="fraco" Text="{l:T 'Lendo o PR no GitHub…'}" FontSize="12" Margin="0,4,0,0" />
      </StackPanel>

      <Border Classes="aviso erro" IsVisible="{Binding TemErro}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" FontSize="12.5" />
          <Button Classes="mini" Command="{Binding AtualizarCommand}" HorizontalAlignment="Left" Content="{l:T 'Tentar de novo'}" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="8" IsVisible="{Binding NaPrincipal}">
        <TextBlock Classes="secao-pr" Text="PULL REQUEST" />
        <TextBlock Classes="suave" Text="{l:T 'Esta sessão está na branch principal. Crie uma branch ou um worktree para abrir um PR.'}" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="aviso" IsVisible="{Binding TemAviso}" Padding="12,8">
        <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" FontSize="12.5" />
      </Border>

      <Border Classes="alerta-pr" Classes.atencao="{Binding !ConfirmacaoPerigosa}" IsVisible="{Binding TemConfirmacao}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Confirmacao.Texto, FallbackValue=''}" TextWrapping="Wrap" FontSize="12.5" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primario pequeno" Command="{Binding ConfirmarCommand}" Content="{Binding Confirmacao.Botao, FallbackValue=''}" />
            <Button Classes="contorno pequeno" Command="{Binding CancelarConfirmacaoCommand}" Content="{l:T 'Cancelar'}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Spacing="18" IsVisible="{Binding TemPr}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Border Classes="estado-pr" Classes.rascunho="{Binding Rascunho}" Classes.mergeado="{Binding Mergeado}" Classes.fechado="{Binding Fechado}">
              <TextBlock Text="{Binding EstadoTexto}" />
            </Border>
            <TextBlock Grid.Column="1" Classes="fraco mono" Text="{Binding Numero}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Button Grid.Column="3" Classes="icone pequeno" Command="{Binding AtualizarCommand}" ToolTip.Tip="{l:T 'Ler o PR de novo'}" AutomationProperties.Name="{l:T 'Ler o PR de novo'}">
              <c:Icone Nome="atualizar" Tamanho="12" />
            </Button>
            <Button Grid.Column="4" Classes="icone pequeno" Command="{Binding AbrirNoGitHubCommand}" ToolTip.Tip="{l:T 'Abrir no GitHub'}" AutomationProperties.Name="{l:T 'Abrir no GitHub'}">
              <c:Icone Nome="externo" Tamanho="12" />
            </Button>
          </Grid>
          <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="fraco mono" Text="{Binding Ramos}" FontSize="11.5" TextWrapping="Wrap" />
          <TextBlock Classes="fraco" Text="{Binding InfoAutor}" FontSize="11.5" TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="alerta-pr" IsVisible="{Binding TemConflito}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*">
              <c:Icone Nome="alerta" Tamanho="14" Foreground="{DynamicResource Vermelho}" VerticalAlignment="Top" Margin="0,1,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding TextoConflito}" TextWrapping="Wrap" FontSize="12.5" />
            </Grid>
            <Button Classes="mini" Command="{Binding PedirConflitoCommand}" HorizontalAlignment="Left"
                    ToolTip.Tip="{l:T 'Escreve no campo da conversa um pedido para o agente resolver o conflito; você revisa e manda'}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="faisca" Tamanho="12" /><TextBlock Text="{l:T 'Pedir ao agente para resolver'}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="secao-pr" Text="CHECKS" />
            <TextBlock Grid.Column="1" Classes="fraco" Text="{Binding ResumoChecks}" FontSize="11.5" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Checks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CheckPrVM">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="linha-pr" Command="{Binding AbrirCommand}" IsEnabled="{Binding TemLink}" ToolTip.Tip="{Binding Dica}" AutomationProperties.Name="{Binding Nome}">
                    <Grid ColumnDefinitions="Auto,*">
                      <c:Icone Nome="{Binding Icone}" Tamanho="13" Classes.falhou="{Binding Falhou}" Classes.ok="{Binding Ok}" Classes.pendente="{Binding Pendente}" Classes.pulado="{Binding Pulado}"
                               VerticalAlignment="Center" Margin="0,0,9,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Nome}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="fraco" Text="{Binding Fluxo}" IsVisible="{Binding TemFluxo}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="mini" Command="{Binding PedirCorrecaoCommand}" IsVisible="{Binding Falhou}" VerticalAlignment="Center" Margin="8,0,0,0"
                          ToolTip.Tip="{l:T 'Escreve no campo da conversa um pedido para o agente corrigir este check; você revisa e manda'}">
                    <TextBlock Text="{l:T 'Corrigir'}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding TemRevisores}">
          <TextBlock Classes="secao-pr" Text="{l:T 'REVISÕES'}" />
          <ItemsControl ItemsSource="{Binding Revisores}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RevisorPrVM">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                  <Border Classes="avatar-pr" Margin="0,0,9,0"><TextBlock Text="{Binding Inicial}" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding Login}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <c:Icone Nome="{Binding Icone}" Tamanho="12" Classes.ok="{Binding Aprovou}" Classes.falhou="{Binding PediuMudancas}" Classes.pendente="{Binding Esperando}" VerticalAlignment="Center" />
                    <TextBlock Classes="suave" Text="{Binding Estado}" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="secao-pr" Text="{l:T 'COMENTÁRIOS DE REVISÃO'}" />
          <TextBlock Classes="fraco" Text="{Binding TextoConversas}" FontSize="12" TextWrapping="Wrap" />
          <Button Classes="mini" Command="{Binding PedirConversasCommand}" IsVisible="{Binding TemConversasAbertas}" HorizontalAlignment="Left"
                  ToolTip.Tip="{l:T 'Escreve no campo da conversa um pedido para o agente resolver estes comentários sem responder no PR; você revisa e manda'}">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="faisca" Tamanho="12" /><TextBlock Text="{l:T 'Pedir ao agente para resolver'}" /></StackPanel>
          </Button>
          <ItemsControl ItemsSource="{Binding Grupos}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GrupoConversasVM">
                <StackPanel Spacing="4" Margin="0,4,0,4">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                      <TextBlock Classes="mono" Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Arquivo}" />
                      <TextBlock Classes="fraco mono" Text="{Binding Pasta}" IsVisible="{Binding TemPasta}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Theme="{StaticResource BotaoPilhaDeAvatares}" IsVisible="{Binding TemResolvidas}" Command="{Binding VerDiffCommand}" Margin="6,0,0,0"
                            ToolTip.Tip="{l:T 'Conversas resolvidas neste arquivo. Abre o diff do PR com elas na margem.'}" AutomationProperties.Name="{Binding TextoResolvidas}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <ItemsControl Theme="{StaticResource PilhaDeAvatares}" ItemsSource="{Binding ResolvidasVisiveis}" />
                        <TextBlock Classes="fraco" Text="{Binding MaisResolvidas}" IsVisible="{Binding TemMaisResolvidas}" FontSize="10.5" VerticalAlignment="Center" />
                        <TextBlock Classes="fraco" Text="{Binding TextoResolvidas}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="icone pequeno" Command="{Binding VerDiffCommand}" Margin="4,0,0,0"
                            ToolTip.Tip="{l:T 'Ver o diff deste arquivo no PR, com as conversas nas linhas'}" AutomationProperties.Name="{l:T 'Ver o diff no PR'}">
                      <c:Icone Nome="diff" Tamanho="12" />
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Conversas}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConversaPrVM">
                        <Border Classes="conversa-pr">
                          <StackPanel Spacing="6">
                            <WrapPanel ItemSpacing="6">
                              <CheckBox IsChecked="{Binding Incluir}" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                        ToolTip.Tip="{l:T 'Incluir este comentário no que vai para o agente'}" AutomationProperties.Name="{l:T 'Incluir este comentário'}" />
                              <Panel Width="20" Height="20" VerticalAlignment="Center">
                                <Border Classes="avatar-pr" IsVisible="{Binding EhPessoa}"><TextBlock Text="{Binding Iniciais}" /></Border>
                                <c:AvatarVivo Agente="{Binding Agente}" Parado="True" Rotulo="" IsVisible="{Binding EhAgente}" />
                              </Panel>
                              <Button Classes="mini" Command="{Binding AbrirArquivoCommand}" Padding="6,1" ToolTip.Tip="{l:T 'Abrir o arquivo nesta linha'}">
                                <TextBlock Classes="mono" Text="{Binding Linha}" FontSize="11" />
                              </Button>
                              <TextBlock Text="{Binding Autor}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                              <TextBlock Classes="fraco" Text="{Binding Quando}" FontSize="11" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Corpo}" TextWrapping="Wrap" FontSize="12.5" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                              <TextBlock Classes="fraco" Text="{Binding TextoRespostas}" IsVisible="{Binding TemRespostas}" FontSize="11" VerticalAlignment="Center" />
                              <Button Grid.Column="1" Classes="icone pequeno" Command="{Binding AbrirCommand}" IsVisible="{Binding TemLink}"
                                      ToolTip.Tip="{l:T 'Ver a conversa no GitHub'}" AutomationProperties.Name="{l:T 'Ver a conversa no GitHub'}">
                                <c:Icone Nome="externo" Tamanho="11" />
                              </Button>
                              <Button Grid.Column="2" Classes="mini" Command="{Binding PedirCorrecaoCommand}" Margin="6,0,0,0"
                                      ToolTip.Tip="{l:T 'Escreve no campo da conversa um pedido para o agente resolver só este comentário; você revisa e manda'}">
                                <TextBlock Text="{l:T 'Corrigir'}" />
                              </Button>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding TemComentarios}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="secao-pr" Text="{l:T 'CONVERSA'}" />
            <TextBlock Grid.Column="1" Classes="fraco" Text="{Binding TextoComentarios}" FontSize="11.5" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Comentarios}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComentarioPrVM">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                  <CheckBox IsChecked="{Binding Incluir}" IsVisible="{Binding !Meu}" VerticalAlignment="Top" MinWidth="0" Padding="0" Margin="0,0,6,0"
                            ToolTip.Tip="{l:T 'Incluir este comentário no que vai para o agente'}" AutomationProperties.Name="{l:T 'Incluir este comentário'}" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Autor}" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Classes="fraco" Text="{Binding Quando}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="suave" Text="{Binding Corpo}" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="conversa-pr" IsVisible="{Binding TemEnvio}" Padding="12,10">
          <StackPanel Spacing="8">
            <StackPanel Spacing="2">
              <TextBlock Classes="secao-pr" Text="{l:T 'MANDAR PARA O AGENTE'}" />
              <TextBlock Classes="fraco" Text="{Binding TextoSelecionados}" FontSize="11.5" />
            </StackPanel>
            <Border Background="{DynamicResource Fundo}" CornerRadius="9" Padding="3">
              <Grid ColumnDefinitions="*,*">
                <Button Classes="nivel" Classes.ativa="{Binding ParaOriginal}" Command="{Binding EscolherDestinoCommand}" CommandParameter="original" IsEnabled="{Binding TemOriginal}"
                        Margin="1,0" ToolTip.Tip="{l:T 'Manda para esta conversa, que já tem o histórico da branch'}">
                  <TextBlock Text="{l:T 'Conversa original'}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Grid.Column="1" Classes="nivel" Classes.ativa="{Binding ParaNova}" Command="{Binding EscolherDestinoCommand}" CommandParameter="nova" Margin="1,0"
                        ToolTip.Tip="{l:T 'Abre uma conversa nova que começa pela passagem (handoff) da branch e depois traz os comentários'}">
                  <TextBlock Text="{Binding TextoNova}" TextTrimming="CharacterEllipsis" />
                </Button>
              </Grid>
            </Border>
            <Grid ColumnDefinitions="Auto,*">
              <c:Icone Nome="faisca" Tamanho="12" Foreground="{DynamicResource Acento}" VerticalAlignment="Top" Margin="0,2,7,0" />
              <TextBlock Grid.Column="1" Classes="suave" Text="{Binding MotivoDestino}" TextWrapping="Wrap" FontSize="12" />
            </Grid>
            <TextBlock Classes="fraco" Text="{Binding DetalheDestino}" TextWrapping="Wrap" FontSize="11.5" />
            <Button Classes="primario" Command="{Binding MandarComentariosCommand}" HorizontalAlignment="Left"
                    ToolTip.Tip="{l:T 'Manda os comentários marcados, com arquivo, linhas e o trecho do código. O agente não responde no PR.'}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="enviar" Tamanho="13" /><TextBlock Text="{l:T 'Mandar para o agente'}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding PodeMarcarPronto}">
          <TextBlock Classes="secao-pr" Text="{l:T 'RASCUNHO'}" />
          <TextBlock Classes="suave" Text="{l:T 'Os revisores só são avisados quando o PR sai do rascunho.'}" TextWrapping="Wrap" FontSize="12.5" />
          <Button Classes="contorno" Command="{Binding MarcarProntoCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="ok" Tamanho="13" /><TextBlock Text="{l:T 'Marcar como pronto para revisão'}" /></StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding MostraMerge}">
          <TextBlock Classes="secao-pr" Text="MERGE" />
          <Border Background="{DynamicResource Superficie}" CornerRadius="9" Padding="3">
            <Grid ColumnDefinitions="*,*,*">
              <Button Classes="nivel" Classes.ativa="{Binding ModoSquash}" Command="{Binding EscolherModoCommand}" CommandParameter="squash" Content="Squash" Margin="1,0"
                      ToolTip.Tip="{l:T 'Junta os commits do PR em um só'}" />
              <Button Grid.Column="1" Classes="nivel" Classes.ativa="{Binding ModoMergeCommit}" Command="{Binding EscolherModoCommand}" CommandParameter="merge" Content="Merge" Margin="1,0"
                      ToolTip.Tip="{l:T 'Mantém os commits e cria um commit de merge'}" />
              <Button Grid.Column="2" Classes="nivel" Classes.ativa="{Binding ModoRebase}" Command="{Binding EscolherModoCommand}" CommandParameter="rebase" Content="Rebase" Margin="1,0"
                      ToolTip.Tip="{l:T 'Reaplica os commits em cima da base, sem commit de merge'}" />
            </Grid>
          </Border>
          <TextBlock Classes="fraco" Text="{Binding TextoBloqueio}" IsVisible="{Binding TemBloqueio}" TextWrapping="Wrap" FontSize="12" />
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <Button Classes="primario" Command="{Binding MergearCommand}" IsEnabled="{Binding PodeMergear}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="pr" Tamanho="13" /><TextBlock Text="{l:T 'Mergear'}" /></StackPanel>
            </Button>
            <Button Classes="contorno" Command="{Binding LigarAutoMergeCommand}" IsVisible="{Binding PodeLigarAutoMerge}"
                    ToolTip.Tip="{l:T 'O GitHub faz o merge sozinho quando os checks passarem e as revisões aprovarem'}">
              <TextBlock Text="{l:T 'Ligar o auto-merge'}" />
            </Button>
          </WrapPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding AutoMergeLigado}">
            <c:Icone Nome="relogio" Tamanho="13" Classes="pendente" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Classes="suave" Text="{l:T 'Auto-merge ligado: o GitHub mergeia quando liberar.'}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="mini" Command="{Binding DesligarAutoMergeCommand}" Content="{l:T 'Desligar'}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="10" IsVisible="{Binding SemPr}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="secao-pr" Text="{l:T 'NOVO PULL REQUEST'}" />
          <Button Grid.Column="1" Classes="icone pequeno" Command="{Binding GerarDeNovoCommand}" ToolTip.Tip="{l:T 'Gerar o título e a descrição de novo a partir dos commits'}"
                  AutomationProperties.Name="{l:T 'Gerar de novo'}">
            <c:Icone Nome="atualizar" Tamanho="12" />
          </Button>
        </Grid>
        <TextBlock Classes="fraco" Text="{Binding ResumoBranch}" IsVisible="{Binding TemResumoBranch}" TextWrapping="Wrap" FontSize="12" />
        <StackPanel Spacing="4">
          <TextBlock Classes="suave" Text="{l:T 'Base'}" FontSize="12" />
          <ComboBox ItemsSource="{Binding Bases}" SelectedItem="{Binding BaseEscolhida}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T 'Branch base do PR'}"
                    ToolTip.Tip="{l:T 'Escolha outra branch para empilhar este PR em cima dela'}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="suave" Text="{l:T 'Título'}" FontSize="12" />
          <TextBox Classes="campo" Text="{Binding NovoTitulo}" TextWrapping="Wrap" AutomationProperties.Name="{l:T 'Título do PR'}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="suave" Text="{l:T 'Descrição'}" FontSize="12" />
          <TextBox Classes="campo" Text="{Binding NovoCorpo}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="340" FontSize="12.5"
                   AutomationProperties.Name="{l:T 'Descrição do PR'}" />
        </StackPanel>
        <CheckBox IsChecked="{Binding NovoRascunho}" Content="{l:T 'Abrir como rascunho'}" />
        <Border Classes="alerta-pr atencao" IsVisible="{Binding TemAvisoNovo}" Padding="10,8">
          <TextBlock Text="{Binding AvisoNovo}" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="primario" Command="{Binding CriarPrCommand}"
                  ToolTip.Tip="{l:T 'Envia a branch e abre o PR pelo gh, sem passar pelo agente'}">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="pr" Tamanho="13" /><TextBlock Text="{l:T 'Criar o PR'}" /></StackPanel>
          </Button>
          <Button Classes="contorno" Command="{Binding PedirPrAoAgenteCommand}"
                  ToolTip.Tip="{l:T 'Escreve no campo da conversa o pedido de commit e PR com este título e esta descrição; você revisa e manda'}">
            <TextBlock Text="{l:T 'Pedir ao agente'}" />
          </Button>
        </WrapPanel>
        <TextBlock Classes="fraco" Text="{l:T 'O título e a descrição saem dos commits da branch, sem gastar tokens. Edite à vontade antes de criar.'}" TextWrapping="Wrap" FontSize="11.5" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
