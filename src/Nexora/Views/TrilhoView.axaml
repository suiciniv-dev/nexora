<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:v="using:Nexora.Views"
             x:Class="Nexora.Views.TrilhoView"
             x:DataType="vm:JanelaVM"
             ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="Border.capsula">
      <Setter Property="Width" Value="48" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BordaVidro}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 10 28 0 #55000000" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.capsula.aberta">
      <Setter Property="Width" Value="188" />
      <Setter Property="Background" Value="{DynamicResource FundoSolido}" />
      <Setter Property="BoxShadow" Value="0 14 40 0 #73000000" />
    </Style>
    <Style Selector="Button.trilho">
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="5,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.trilho /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.14" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.capsula:not(.aberta) Button.trilho:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.1)" />
    </Style>
    <Style Selector="Button.trilho:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.trilho:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="Button.trilho.ativo /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MarcaGradiente}" />
      <Setter Property="Foreground" Value="{DynamicResource SobreMarca}" />
    </Style>
    <Style Selector="Button.trilho, Button.trilho /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="TextBlock.rotulo-trilho">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,12,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(-6px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.capsula.aberta TextBlock.rotulo-trilho">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateX(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Delay="0:0:0.08" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Delay="0:0:0.06" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.contador-trilho">
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Background" Value="{DynamicResource Laranja}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-8,-10,0" />
    </Style>
    <Style Selector="Border.contador-trilho > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SobreLaranja}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <DockPanel Width="64" ClipToBounds="False">
    <Border DockPanel.Dock="Bottom" Classes="capsula" Margin="8,0,0,8">
      <StackPanel Spacing="4">
        <Button Classes="trilho" Command="{Binding AbrirBoasVindasCommand}" ToolTip.Tip="{l:T 'Guia de primeiros passos'}" AutomationProperties.Name="{l:T 'Guia de primeiros passos'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="ajuda" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Guia'}" />
          </Grid>
        </Button>
        <Button Classes="trilho" Command="{Binding MostrarAtalhosCommand}" ToolTip.Tip="{l:T 'Atalhos de teclado (F1)'}" AutomationProperties.Name="{l:T 'Atalhos de teclado'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="teclado" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Atalhos'}" />
          </Grid>
        </Button>
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding NaConfiguracoes}" IsChecked="{Binding NaConfiguracoes, Mode=OneWay}" Command="{Binding MostrarConfiguracoesCommand}" ToolTip.Tip="{l:T 'Configurações (Ctrl+,)'}" AutomationProperties.Name="{l:T 'Configurações'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="ajustes" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Configurações'}" />
          </Grid>
        </v:BotaoLigado>
      </StackPanel>
    </Border>

    <Border Classes="capsula" VerticalAlignment="Top" Margin="8,4,0,0">
      <StackPanel Spacing="4">
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding NaVisaoGeral}" IsChecked="{Binding NaVisaoGeral, Mode=OneWay}" Command="{Binding MostrarVisaoGeralCommand}" ToolTip.Tip="{l:T 'Ao vivo (Ctrl+0)'}" AutomationProperties.Name="{l:T 'Ao vivo'}">
          <Grid ColumnDefinitions="38,*">
            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
              <v:Icone Nome="painel-geral" Tamanho="17" />
              <Border Classes="contador-trilho" IsVisible="{Binding TemPrecisa}" ToolTip.Tip="{l:T 'Sessões que precisam de você'}"><TextBlock Text="{Binding TotalPrecisa}" /></Border>
            </Panel>
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Ao vivo'}" />
          </Grid>
        </v:BotaoLigado>
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding LateralNaTela}" IsChecked="{Binding LateralNaTela, Mode=OneWay}" Command="{Binding AlternarLateralCommand}" ToolTip.Tip="{l:T 'Deixar a lateral aberta, com as conversas (Ctrl+B)'}" AutomationProperties.Name="{l:T 'Conversas'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="conversa" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Conversas'}" />
          </Grid>
        </v:BotaoLigado>
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding NaProjetos}" IsChecked="{Binding NaProjetos, Mode=OneWay}" Command="{Binding MostrarProjetosCommand}" ToolTip.Tip="{l:T 'Projetos'}" AutomationProperties.Name="{l:T 'Projetos'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="camadas" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Projetos'}" />
          </Grid>
        </v:BotaoLigado>
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding NaIssues}" IsChecked="{Binding NaIssues, Mode=OneWay}" Command="{Binding MostrarIssuesCommand}" ToolTip.Tip="{l:T 'Issues: as abertas nos seus projetos do GitHub'}" AutomationProperties.Name="{l:T 'Issues'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="issue" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Issues'}" />
          </Grid>
        </v:BotaoLigado>
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding NaOrquestra}" IsChecked="{Binding NaOrquestra, Mode=OneWay}" Command="{Binding MostrarOrquestraCommand}" ToolTip.Tip="{l:T 'Orquestrador (Ctrl+Shift+O)'}" AutomationProperties.Name="{l:T 'Orquestrador'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="orquestra" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Orquestrador'}" />
          </Grid>
        </v:BotaoLigado>
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding NaAgendados}" IsChecked="{Binding NaAgendados, Mode=OneWay}" Command="{Binding MostrarAgendadosCommand}" ToolTip.Tip="{l:T 'Agendados: pedidos que rodam sozinhos no horário'}" AutomationProperties.Name="{l:T 'Agendados'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="relogio" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Agendados'}" />
          </Grid>
        </v:BotaoLigado>
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding NaUso}" IsChecked="{Binding NaUso, Mode=OneWay}" Command="{Binding MostrarUsoCommand}" ToolTip.Tip="{l:T 'Uso: plano do Claude e a parte de cada projeto'}" AutomationProperties.Name="{l:T 'Uso'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="grafico" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Uso'}" />
          </Grid>
        </v:BotaoLigado>
        <v:BotaoLigado Classes="trilho" Classes.ativo="{Binding NaRecursos}" IsChecked="{Binding NaRecursos, Mode=OneWay}" Command="{Binding MostrarRecursosCommand}" ToolTip.Tip="{l:T 'Recursos: memória das sessões e MCPs compartilhados'}" AutomationProperties.Name="{l:T 'Recursos'}">
          <Grid ColumnDefinitions="38,*">
            <v:Icone Nome="memoria" Tamanho="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="rotulo-trilho" Text="{l:T 'Recursos'}" />
          </Grid>
        </v:BotaoLigado>
      </StackPanel>
    </Border>
  </DockPanel>
</UserControl>
