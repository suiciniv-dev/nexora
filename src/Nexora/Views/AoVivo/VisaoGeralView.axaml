<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora.Traducao"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:v="using:Nexora.Views"
             xmlns:c="using:Nexora.Controles"
             x:Class="Nexora.Views.VisaoGeralView"
             x:DataType="vm:VisaoGeralVM">
  <UserControl.Styles>
    <Style Selector="Panel.espiada">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel.espiada.aberta">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="c|Caixa.widget.expandido">
      <Setter Property="Width" Value="734" />
    </Style>
    <Style Selector="c|Caixa.coluna">
      <Setter Property="Background" Value="#18000000" />
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,12,10,8" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="c|Botao.card">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="c|Botao.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextoFraco}" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="c|Botao.tirar">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="c|Botao.card:pointerover c|Botao.tirar, c|Caixa.widget:pointerover c|Botao.tirar, c|Botao.tirar:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="c|Botao.card.destaque">
      <Setter Property="Background" Value="{DynamicResource PedidoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Laranja}" />
    </Style>
    <Style Selector="c|Botao.card:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
      <Setter Property="BoxShadow" Value="0 0 0 1 #66FFFFFF" />
    </Style>
    <Style Selector="c|Botao.contorno.ligado /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Acento}" />
      <Setter Property="Background" Value="{DynamicResource AcentoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
    </Style>
    <Style Selector="c|Caixa.sigla">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource MarcaGradiente}" />
      <Setter Property="Margin" Value="0,0,9,0" />
    </Style>
    <Style Selector="c|Caixa.issue-cartao">
      <Setter Property="Background" Value="{DynamicResource AcentoFundo}" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|Caixa.fila">
      <Setter Property="Background" Value="{DynamicResource PedidoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Laranja}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="c|Caixa.pedido-fila">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="c|Caixa.icone-repo">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
    <Style Selector="c|Caixa.sigla > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SobreMarca}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|Caixa.contagem">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|Caixa.contagem > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}" />
    </Style>
    <Style Selector="c|Botao.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="c|Botao.seg.ativo">
      <Setter Property="Background" Value="#66000000" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="c|Botao.brilho">
      <Setter Property="Background" Value="{DynamicResource Lateral}" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.filtro-projeto">
      <Setter Property="MinWidth" Value="190" />
    </Style>
    <Style Selector="Panel.estreita ComboBox.filtro-projeto">
      <Setter Property="MinWidth" Value="130" />
    </Style>
    <Style Selector="Panel.estreita TextBlock.resumo-topo">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBox.busca-sessoes">
      <Setter Property="Width" Value="220" />
    </Style>
    <Style Selector="Panel.estreita TextBox.busca-sessoes">
      <Setter Property="Width" Value="170" />
    </Style>
    <Style Selector="StackPanel.filtros-ao-vivo">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <Style Selector="Panel.compacta TextBlock.rotulo-compactavel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.empilhada StackPanel.filtros-ao-vivo">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="4" />
      <Setter Property="Margin" Value="0,12,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Panel.empilhada TextBox.busca-sessoes">
      <Setter Property="Width" Value="200" />
    </Style>
    <Style Selector="c|GradeAdaptativa.colunas-quadro, c|GradeAdaptativa.grade-faixa">
      <Setter Property="Colunas" Value="4" />
    </Style>
    <Style Selector="c|GradeAdaptativa.colunas-quadro">
      <Setter Property="PreencherAltura" Value="True" />
    </Style>
    <Style Selector="StackPanel.so-vertical">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.vertical StackPanel.so-vertical">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.vertical Grid.cabecas-faixa">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.vertical c|GradeAdaptativa.colunas-quadro, Window.vertical c|GradeAdaptativa.grade-faixa">
      <Setter Property="Colunas" Value="2" />
    </Style>
    <Style Selector="Window.vertical c|GradeAdaptativa.colunas-quadro">
      <Setter Property="PreencherAltura" Value="False" />
    </Style>
    <Style Selector="Window.vertical c|GradeAdaptativa.colunas-quadro > c|Caixa.coluna">
      <Setter Property="Margin" Value="0,0,12,12" />
    </Style>
    <Style Selector="c|Avatar.avatar-mesa">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="54" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Avatar.avatar-mesa">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="c|AvatarVivo.agente-mesa">
      <Setter Property="ZIndex" Value="2" />
      <Setter Property="Width" Value="21" />
      <Setter Property="Height" Value="21" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,-12,-10" />
    </Style>
    <Style Selector="ItemsControl.mesa c|AvatarVivo.agente-mesa">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="0,0,-2,-4" />
    </Style>
    <Style Selector="ItemsControl.mesa Panel.icone-cartao">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Botao.card">
      <Setter Property="Width" Value="320" />
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="BorderBrush" Value="{DynamicResource BordaVidro}" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Botao.card /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource SombraCartao}" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Botao.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Botao.card.destaque:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PedidoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Laranja}" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Botao.card:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
      <Setter Property="BoxShadow" Value="{DynamicResource BrilhoCaixa}" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Botao.card.destaque">
      <Setter Property="BorderBrush" Value="{DynamicResource Laranja}" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Botao.card.destaque /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource BrilhoPrecisa}" />
    </Style>
    <Style Selector="ItemsControl.mesa c|Botao.card TextBlock.titulo-cartao">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.chamando">
      <Setter Property="Foreground" Value="{DynamicResource Laranja}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="PerguntasNoCartao" x:DataType="vm:ChatVM">
          <StackPanel Spacing="8">
            <ItemsControl ItemsSource="{Binding PermissaoPendente.Perguntas, FallbackValue={x:Null}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PerguntaVM">
                  <StackPanel Spacing="6" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Opcoes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OpcaoVM">
                          <c:BotaoLigado Classes="contorno pequeno" Classes.ligado="{Binding Selecionada}" IsChecked="{Binding Selecionada, Mode=OneWay}" Command="{Binding EscolherCommand}"
                                  ToolTip.Tip="{Binding Descricao}" Margin="0,0,6,6" AutomationProperties.Name="{Binding Rotulo}">
                            <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap" MaxWidth="200" />
                          </c:BotaoLigado>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Botao Classes="primario pequeno" Content="{l:T 'Responder'}" Command="{Binding PermissaoPendente.ResponderCommand, FallbackValue={x:Null}}"
                      IsVisible="{Binding PermissaoPendente.PrecisaBotaoResponder, FallbackValue=False}" IsEnabled="{Binding PermissaoPendente.PodeResponder, FallbackValue=False}" />
              <c:Botao Classes="fantasma pequeno" Content="{l:T 'Outra resposta'}" Command="{Binding MostrarCommand}" ToolTip.Tip="{l:T 'Abre a conversa para escrever a resposta'}" />
            </StackPanel>
          </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Medidores" x:DataType="vm:CartaoVM">
      <StackPanel Spacing="10">
        <StackPanel Spacing="5" IsVisible="{Binding TemContexto}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="fraco" Text="{l:T 'Contexto'}" />
            <TextBlock Grid.Column="1" Classes="fraco" Text="{Binding ContextoTexto}" />
          </Grid>
          <ProgressBar Classes="contexto" Classes.cheio="{Binding ContextoCheio}" Minimum="0" Maximum="1" Value="{Binding ContextoFracao}" IsVisible="{Binding TemJanela}" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:Icone Nome="relogio" Tamanho="13" Classes="fraco" IsVisible="{Binding TemCache}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="cache" Classes.acabando="{Binding CacheAcabando}" Classes.expirado="{Binding CacheExpirado}"
                     Text="{Binding CacheTexto}" Margin="6,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Panel x:Name="Raiz">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="24,16,24,12">
      <TextBlock Text="{l:T 'Ao vivo'}" FontSize="22" FontWeight="Medium" VerticalAlignment="Center" />
      <Border Grid.Column="1" Margin="16,0,0,0" Padding="3" CornerRadius="99" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <c:BotaoLigado Classes="seg" Classes.ativo="{Binding ModoMesa}" IsChecked="{Binding ModoMesa, Mode=OneWay}" Command="{Binding MostrarMesaCommand}" Content="{l:T 'Mesa'}" />
          <c:BotaoLigado Classes="seg" Classes.ativo="{Binding QuadroColunas}" IsChecked="{Binding QuadroColunas, Mode=OneWay}" Command="{Binding MostrarQuadroCommand}" Content="{l:T 'Quadro'}" />
          <c:BotaoLigado Classes="seg" Classes.ativo="{Binding ModoLista}" IsChecked="{Binding ModoLista, Mode=OneWay}" Command="{Binding MostrarListaCommand}" Content="{l:T 'Lista'}" />
        </StackPanel>
      </Border>
      <StackPanel Classes="filtros-ao-vivo" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding ModoQuadro}">
        <TextBox Classes="busca-sessoes" Text="{Binding BuscaSessoes}" PlaceholderText="{l:T 'Procurar sessões'}" VerticalAlignment="Center"
                 AutomationProperties.Name="{l:T 'Procurar sessões'}">
          <TextBox.InnerLeftContent>
            <c:Icone Nome="busca" Tamanho="13" Classes="fraco" Margin="10,0,2,0" VerticalAlignment="Center" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <c:Botao Classes="icone pequeno" Command="{Binding LimparBuscaCommand}" IsVisible="{Binding TemBusca}" Margin="0,0,4,0"
                    ToolTip.Tip="{l:T 'Limpar a busca'}" AutomationProperties.Name="{l:T 'Limpar a busca'}">
              <c:Icone Nome="fechar" Tamanho="11" />
            </c:Botao>
          </TextBox.InnerRightContent>
        </TextBox>
        <ComboBox Classes="filtro-projeto" ItemsSource="{Binding Projetos}" SelectedItem="{Binding FiltroProjeto}" ToolTip.Tip="{l:T 'Mostrar só as sessões de um projeto'}"
                  AutomationProperties.Name="{l:T 'Filtrar por projeto'}" />
        <ComboBox Classes="filtro-projeto" ItemsSource="{Binding Estados}" SelectedIndex="{Binding FiltroEstado}" IsVisible="{Binding ModoLista}"
                  ToolTip.Tip="{l:T 'Mostrar só as sessões num estado'}" AutomationProperties.Name="{l:T 'Filtrar por estado'}" />
        <c:BotaoLigado Classes="contorno pequeno" Classes.ligado="{Binding PorProjeto}" IsChecked="{Binding PorProjeto, Mode=OneWay}" Command="{Binding AlternarPorProjetoCommand}" IsVisible="{Binding QuadroColunas}"
                ToolTip.Tip="{l:T 'Uma faixa por projeto'}" AutomationProperties.Name="{l:T 'Agrupar por projeto'}">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="camadas" Tamanho="13" /><TextBlock Classes="rotulo-compactavel" Text="{l:T 'Por projeto'}" /></StackPanel>
        </c:BotaoLigado>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="fraco resumo-topo" Text="{Binding ResumoTopo}" VerticalAlignment="Center" />
        <c:Botao Classes="contorno pequeno" Command="{Binding AbrirAtivasEmSplitCommand}" VerticalAlignment="Center"
                ToolTip.Tip="{l:T 'Abre todas as sessões ativas lado a lado, as que precisam de você primeiro'}" AutomationProperties.Name="{l:T 'Ativas em split view'}">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="painel-geral" Tamanho="13" /><TextBlock Classes="rotulo-compactavel" Text="{l:T 'Ativas em split view'}" /></StackPanel>
        </c:Botao>
      </StackPanel>
    </Grid>
    <c:Caixa DockPanel.Dock="Top" Classes="fila" IsVisible="{Binding TemFila}" Margin="24,0,24,12">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Classes="estado precisa" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Grid.Column="1" Text="{Binding TituloFila}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Janela.TemLiberadas}" VerticalAlignment="Center">
            <TextBlock Classes="fraco" Text="{Binding Janela.TextoLiberadas}" FontSize="12" VerticalAlignment="Center" />
            <c:Botao Classes="mini" Content="{l:T 'Esquecer'}" Command="{Binding Janela.EsquecerLiberadasCommand}" ToolTip.Tip="{l:T 'Volta a pedir em cada sessão'}" />
          </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Fila}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PedidoDaFilaVM">
              <c:Caixa Classes="pedido-fila">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Sessao}" FontWeight="Medium" />
                      <Run Text="  ·  " />
                      <Run Text="{Binding Titulo}" />
                    </TextBlock>
                    <TextBlock Classes="suave" Text="{Binding Item.Subagente}" FontSize="11.5" TextTrimming="CharacterEllipsis" IsVisible="{Binding Item.TemSubagente}" />
                    <TextBlock Classes="fraco mono" Text="{Binding Detalhe}" FontSize="11.5" TextTrimming="CharacterEllipsis" IsVisible="{Binding TemDetalhe}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                    <c:Botao Classes="primario pequeno" Content="{l:T 'Permitir'}" Command="{Binding Item.PermitirCommand}" />
                    <c:Botao Classes="contorno pequeno" Content="{l:T 'Em todas'}" Command="{Binding Item.PermitirEmTodasCommand}" IsVisible="{Binding PodeEmTodas}" ToolTip.Tip="{Binding DicaEmTodas}" />
                    <c:Botao Classes="contorno pequeno" Content="{l:T 'Negar'}" Command="{Binding Item.NegarCommand}" />
                    <c:Botao Classes="icone pequeno" Command="{Binding AbrirCommand}" ToolTip.Tip="{l:T 'Abrir a conversa'}" AutomationProperties.Name="{l:T 'Abrir a conversa'}">
                      <c:Icone Nome="maximizar" Tamanho="12" />
                    </c:Botao>
                  </StackPanel>
                </Grid>
              </c:Caixa>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </c:Caixa>
    <Panel>
    <ScrollViewer x:Name="RolagemQuadro" IsVisible="{Binding ModoQuadro}" HorizontalScrollBarVisibility="Disabled">
      <Panel>
        <Panel.DataTemplates>
          <DataTemplate DataType="vm:ChatVM">
            <c:Botao Classes="card" Classes.destaque="{Binding Precisa}" ToolTip.Tip="{l:T 'Espiar a conversa'}"
                    Command="{Binding $parent[v:VisaoGeralView].((vm:VisaoGeralVM)DataContext).EspiarCommand}" CommandParameter="{Binding}">
                    <c:Botao.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{l:T 'Abrir em split view'}" Command="{Binding AbrirEmSplitCommand}" />
                        <MenuItem Header="{Binding TextoVigia}" Command="{Binding AlternarVigiaCommand}" IsVisible="{Binding TemPr}" />
                      </ContextMenu>
                    </c:Botao.ContextMenu>
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Panel Margin="0,0,13,0" VerticalAlignment="Center">
                    <c:Avatar Classes="avatar-mesa" Imagem="{Binding IconeRepo}" Iniciais="{Binding Iniciais}" Trabalhando="{Binding Trabalhando}" Precisa="{Binding Precisa}"
                               Pronta="{Binding EstaPronta}" Erro="{Binding TemErro}" Fracao="{Binding ContextoFracao}" Novidade="{Binding NaoVista}" ToolTip.Tip="{Binding ContextoTexto}" />
                    <c:AvatarVivo Classes="agente-mesa" Agente="{Binding AgenteDoCartao}" Parado="{Binding !Trabalhando}" SegueMouse="False" Rotulo="" ToolTip.Tip="{Binding NomeDoAgente}" />
                    <Panel Classes="icone-cartao">
                    <c:Caixa Classes="sigla" Margin="0" IsVisible="{Binding MostrarIniciais}"><TextBlock Text="{Binding Iniciais}" /></c:Caixa>
                    <c:Caixa Classes="icone-repo" IsVisible="{Binding PastaSolta}" ToolTip.Tip="{Binding NomeProjeto}"><c:Icone Nome="pasta" Tamanho="13" Classes="suave" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:Caixa>
                    <c:Caixa Classes="icone-repo" IsVisible="{Binding TemIconeRepo}" ToolTip.Tip="{Binding NomeProjeto}"><Image Source="{Binding IconeRepo}" Stretch="UniformToFill" /></c:Caixa>
                  </Panel>
                  </Panel>
                  <TextBlock Grid.Column="1" Classes="titulo-cartao" Text="{Binding Titulo}" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" ToolTip.Tip="{Binding Titulo}" />
                  <c:Botao Grid.Column="2" Classes="icone pequeno tirar" Command="{Binding $parent[v:VisaoGeralView].((vm:VisaoGeralVM)DataContext).TirarCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding PodeTirar}" ToolTip.Tip="{Binding DicaTirar}" AutomationProperties.Name="{Binding DicaTirar}" Margin="6,-4,-4,-4" VerticalAlignment="Center">
                    <c:Icone Nome="fechar" Tamanho="12" />
                  </c:Botao>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="fraco" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <Run FontFamily="{DynamicResource Mono}" Text="{Binding Onde}" /><Run Text="{Binding NomeDoAgente, StringFormat='  ·  {0}'}" />
                  </TextBlock>
                  <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource SeloNaNuvem}" IsVisible="{Binding NaNuvem}" Margin="8,0,0,0" />
                  <c:Caixa Grid.Column="1" Classes="issue-cartao" IsVisible="{Binding TemIssue}" ToolTip.Tip="{Binding DicaIssue}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <c:Icone Nome="issue" Tamanho="11" VerticalAlignment="Center" />
                      <TextBlock Classes="mono" Text="{Binding TextoIssue}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Classes="fraco" Text="{Binding TarefaTexto, StringFormat='· {0}'}" IsVisible="{Binding TemTarefa}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                  </c:Caixa>
                </Grid>
                <TextBlock Classes="fraco" Text="{Binding PedidoInicial}" IsVisible="{Binding TemPedidoInicial}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{l:T 'Primeiro pedido da sessão'}" />
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding UltimaAtividade, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Ellipse Classes="estado trabalhando" Width="7" Height="7" IsVisible="{Binding Trabalhando}" VerticalAlignment="Top" Margin="0,5,8,0" />
                  <TextBlock Grid.Column="1" Classes="suave" Text="{Binding UltimaAtividade}" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </Grid>
                <c:Caixa Classes="etiqueta-pilula" HorizontalAlignment="Left" IsVisible="{Binding TemSubagentesRodando}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <c:Icone Nome="subagente" Tamanho="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TextoSubagentes}" FontSize="11.5" VerticalAlignment="Center" />
                  </StackPanel>
                </c:Caixa>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="fraco" Text="{Binding TempoTexto}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Grid.Column="1" Classes="contexto" Classes.cheio="{Binding ContextoCheio}" Minimum="0" Maximum="1" Value="{Binding ContextoFracao}"
                               Width="44" Height="4" MinHeight="4" VerticalAlignment="Center" Margin="8,0,6,0" IsVisible="{Binding TemJanela}" ToolTip.Tip="{Binding ContextoTexto}" />
                  <TextBlock Grid.Column="2" Classes="fraco mono" Text="{Binding ContextoFracao, StringFormat='{}{0:P0}'}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding TemJanela}" />
                </Grid>
                <c:Botao Theme="{StaticResource PilulaPr}" Classes.falhou="{Binding PrFalhou}" Classes.aprovado="{Binding PrAprovado}" Classes.mergeado="{Binding PrMergeado}"
                        Classes.fechado="{Binding PrFechado}" IsVisible="{Binding TemPr}" Command="{Binding AbrirPrCommand}" ToolTip.Tip="{l:T 'Abrir o painel do PR nesta sessão'}">
                  <Grid ColumnDefinitions="Auto,*"><c:Icone Nome="pr" Tamanho="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding TextoPr}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
                </c:Botao>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding TemPedidoNoCartao}">
                  <c:Botao Classes="primario pequeno" Content="{l:T 'Permitir'}" Command="{Binding PermissaoPendente.PermitirCommand}" />
                  <c:Botao Classes="contorno pequeno" Content="{l:T 'Negar'}" Command="{Binding PermissaoPendente.NegarCommand}" />
                </StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PerguntasNoCartao}" IsVisible="{Binding TemPerguntaNoCartao}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SegredoNoCartao}" IsVisible="{Binding TemSegredoNoCartao}" />
                <StackPanel Spacing="3" IsVisible="{Binding MostraContagem}" Margin="0,2,0,0">
                  <ItemsControl ItemsSource="{Binding Contagem}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LinhaAlteradaVM">
                        <Grid ColumnDefinitions="*,Auto,Auto" ToolTip.Tip="{Binding Caminho}" Margin="0,1">
                          <TextBlock Classes="suave mono" Text="{Binding Nome}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="mais" Text="{Binding Mais}" FontSize="11.5" Margin="8,0,0,0" />
                          <TextBlock Grid.Column="2" Classes="menos" Text="{Binding Menos}" FontSize="11.5" Margin="6,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="fraco" Text="{Binding TextoContagem}" FontSize="11" />
                </StackPanel>
                <WrapPanel IsVisible="{Binding MostraBotoesDePronta}">
                  <c:Botao Classes="mini" Content="{l:T 'Ver diff'}" Command="{Binding VerDiffCommand}" Margin="0,0,6,6" ToolTip.Tip="{l:T 'Abre a conversa no painel Git, com o diff de cada arquivo'}" />
                  <c:Botao Classes="mini" Content="{l:T 'Commit e PR'}" Command="{Binding ComitarEPrCommand}" Margin="0,0,6,6" />
                  <c:Botao Classes="mini" Content="{l:T 'Só o commit'}" Command="{Binding ComitarCommand}" Margin="0,0,6,6" />
                </WrapPanel>
              </StackPanel>
            </c:Botao>
          </DataTemplate>
          <DataTemplate DataType="vm:SessaoForaVM">
            <c:Botao Classes="card" Classes.destaque="{Binding Precisa}" ToolTip.Tip="{l:T 'Espiar a conversa'}"
                    Command="{Binding $parent[v:VisaoGeralView].((vm:VisaoGeralVM)DataContext).EspiarCommand}" CommandParameter="{Binding}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Panel Margin="0,0,13,0" VerticalAlignment="Center">
                    <c:Avatar Classes="avatar-mesa" Imagem="{Binding IconeRepo}" Iniciais="{Binding Iniciais}" Trabalhando="{Binding Trabalhando}" Precisa="{Binding Precisa}"
                               Pronta="{Binding Pronta}" Fracao="{Binding ContextoFracao}" />
                    <c:AvatarVivo Classes="agente-mesa" Agente="{Binding AgenteDoCartao}" Parado="{Binding !Trabalhando}" SegueMouse="False" Rotulo="" ToolTip.Tip="{Binding NomeDoAgente}" />
                    <Panel Classes="icone-cartao">
                    <c:Caixa Classes="sigla" Margin="0" IsVisible="{Binding MostrarIniciais}"><TextBlock Text="{Binding Iniciais}" /></c:Caixa>
                    <c:Caixa Classes="icone-repo" IsVisible="{Binding PastaSolta}" ToolTip.Tip="{Binding NomeProjeto}"><c:Icone Nome="pasta" Tamanho="13" Classes="suave" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:Caixa>
                    <c:Caixa Classes="icone-repo" IsVisible="{Binding TemIconeRepo}" ToolTip.Tip="{Binding NomeProjeto}"><Image Source="{Binding IconeRepo}" Stretch="UniformToFill" /></c:Caixa>
                  </Panel>
                  </Panel>
                  <TextBlock Grid.Column="1" Classes="titulo-cartao" Text="{Binding Titulo}" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" ToolTip.Tip="{Binding Titulo}" />
                  <c:Botao Grid.Column="2" Classes="icone pequeno tirar" Command="{Binding $parent[v:VisaoGeralView].((vm:VisaoGeralVM)DataContext).TirarCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding PodeTirar}" ToolTip.Tip="{Binding DicaTirar}" AutomationProperties.Name="{Binding DicaTirar}" Margin="6,-4,-4,-4" VerticalAlignment="Center">
                    <c:Icone Nome="fechar" Tamanho="12" />
                  </c:Botao>
                </Grid>
                <TextBlock Classes="fraco" FontSize="11" TextTrimming="CharacterEllipsis">
                  <Run FontFamily="{DynamicResource Mono}" Text="{Binding Onde}" /><Run Text="{Binding NomeDoAgente, StringFormat='  ·  {0}'}" />
                </TextBlock>
                <TextBlock Classes="suave" Text="{Binding UltimaAtividade}" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding UltimaAtividade, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="fraco" Text="{Binding TextoResponder}" IsVisible="{Binding Precisa}" FontSize="12" />
                <c:Botao Theme="{StaticResource PilulaPr}" Classes.falhou="{Binding PrFalhou}" Classes.aprovado="{Binding PrAprovado}" Classes.mergeado="{Binding PrMergeado}"
                        Classes.fechado="{Binding PrFechado}" IsVisible="{Binding TemPr}" Command="{Binding AbrirPrCommand}" ToolTip.Tip="{l:T 'Abrir o PR no navegador'}">
                  <Grid ColumnDefinitions="Auto,*"><c:Icone Nome="pr" Tamanho="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding TextoPr}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
                </c:Botao>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="fraco" Text="{Binding TempoTexto}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <c:Caixa Grid.Column="1" Classes="etiqueta" Margin="8,0,0,0"><TextBlock Text="{Binding Origem}" /></c:Caixa>
                </Grid>
              </StackPanel>
            </c:Botao>
          </DataTemplate>
        </Panel.DataTemplates>
      <StackPanel Margin="24,6,12,40" Spacing="20" IsVisible="{Binding ModoMesa}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,12,0">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Saudacao}" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.4" />
            <TextBlock Classes="suave" Classes.chamando="{Binding TemPrecisam}" Text="{Binding ResumoMesa}" FontSize="14" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <c:Botao Classes="contorno foco-mesa" Command="{Binding AbrirFocoCommand}" IsVisible="{Binding TemPrecisam}" ToolTip.Tip="{l:T 'Um pedido por vez, respondido pelo teclado'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icone Nome="foco" Tamanho="14" />
                <TextBlock Text="{l:T 'Modo foco'}" />
                <c:Caixa Classes="tecla"><TextBlock Text="F" /></c:Caixa>
              </StackPanel>
            </c:Botao>
            <c:Botao Classes="contorno" Command="{Binding EditarTemplatesCommand}" ToolTip.Tip="{l:T 'Pedidos prontos para começar uma sessão'}">
              <StackPanel Orientation="Horizontal" Spacing="8"><c:Icone Nome="modelo" Tamanho="14" /><TextBlock Text="{l:T 'Templates'}" /></StackPanel>
            </c:Botao>
            <c:Botao Classes="primario" Command="{Binding NovaSessaoCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8"><c:Icone Nome="mais" Tamanho="14" /><TextBlock Text="{l:T 'Nova sessão'}" /></StackPanel>
            </c:Botao>
          </StackPanel>
        </Grid>
        <ItemsControl Classes="mesa" ItemsSource="{Binding Mesa}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>

      <c:GradeAdaptativa Classes="colunas-quadro" Margin="24,0,12,80" IsVisible="{Binding VerColunas}">
        <c:Caixa Classes="coluna">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
              <Ellipse Classes="estado precisa" VerticalAlignment="Center" Margin="0,0,9,0" />
              <TextBlock Text="{l:T 'Precisa de você'}" FontWeight="Medium" VerticalAlignment="Center" />
              <c:Caixa Classes="contagem"><TextBlock Text="{Binding ColPrecisa.Count}" /></c:Caixa>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ColPrecisa}" />
            <TextBlock Classes="fraco" Text="{l:T 'Nada esperando por você.'}" Margin="4,2,4,6" IsVisible="{Binding !ColPrecisa.Count}" />
          </StackPanel>
        </c:Caixa>
        <c:Caixa Classes="coluna">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
              <Ellipse Classes="estado trabalhando" VerticalAlignment="Center" Margin="0,0,9,0" />
              <TextBlock Text="{l:T 'Trabalhando'}" FontWeight="Medium" VerticalAlignment="Center" />
              <c:Caixa Classes="contagem"><TextBlock Text="{Binding ColTrabalhando.Count}" /></c:Caixa>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ColTrabalhando}" />
            <c:Botao Classes="fantasma" Command="{Binding NovaSessaoCommand}" HorizontalAlignment="Left" Padding="6,4">
              <StackPanel Orientation="Horizontal" Spacing="7"><c:Icone Nome="mais" Tamanho="13" /><TextBlock Text="{l:T 'Nova sessão'}" FontSize="12.5" /></StackPanel>
            </c:Botao>
          </StackPanel>
        </c:Caixa>
        <c:Caixa Classes="coluna">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
              <Ellipse Classes="estado pronta" VerticalAlignment="Center" Margin="0,0,9,0" />
              <TextBlock Text="{l:T 'Prontas'}" FontWeight="Medium" VerticalAlignment="Center" />
              <c:Caixa Classes="contagem"><TextBlock Text="{Binding ColProntas.Count}" /></c:Caixa>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ColProntas}" />
            <TextBlock Classes="fraco" Text="{l:T 'As que terminaram o turno aparecem aqui.'}" Margin="4,2,4,6" TextWrapping="Wrap" IsVisible="{Binding !ColProntas.Count}" />
          </StackPanel>
        </c:Caixa>
        <c:Caixa Classes="coluna">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
              <Ellipse Classes="estado" VerticalAlignment="Center" Margin="0,0,9,0" />
              <TextBlock Text="{l:T 'Paradas'}" FontWeight="Medium" VerticalAlignment="Center" />
              <c:Caixa Classes="contagem"><TextBlock Text="{Binding ColParadas.Count}" /></c:Caixa>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ColParadas}" />
          </StackPanel>
        </c:Caixa>
      </c:GradeAdaptativa>

      <StackPanel Margin="24,0,12,80" Spacing="12" IsVisible="{Binding VerFaixas}">
        <Grid Classes="cabecas-faixa" ColumnDefinitions="*,*,*,*" Margin="0,0,0,-2">
          <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
            <Ellipse Classes="estado precisa" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Text="{l:T 'Precisa de você'}" FontWeight="Medium" VerticalAlignment="Center" />
            <c:Caixa Classes="contagem"><TextBlock Text="{Binding ColPrecisa.Count}" /></c:Caixa>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
            <Ellipse Classes="estado trabalhando" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Text="{l:T 'Trabalhando'}" FontWeight="Medium" VerticalAlignment="Center" />
            <c:Caixa Classes="contagem"><TextBlock Text="{Binding ColTrabalhando.Count}" /></c:Caixa>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
            <Ellipse Classes="estado pronta" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Text="{l:T 'Prontas'}" FontWeight="Medium" VerticalAlignment="Center" />
            <c:Caixa Classes="contagem"><TextBlock Text="{Binding ColProntas.Count}" /></c:Caixa>
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
            <Ellipse Classes="estado" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Text="{l:T 'Paradas'}" FontWeight="Medium" VerticalAlignment="Center" />
            <c:Caixa Classes="contagem"><TextBlock Text="{Binding ColParadas.Count}" /></c:Caixa>
          </StackPanel>
        </Grid>
        <TextBlock Classes="fraco" Text="{l:T 'Nenhuma sessão aberta neste filtro.'}" Margin="16,8" IsVisible="{Binding !Faixas.Count}" />
        <ItemsControl ItemsSource="{Binding Faixas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:FaixaVM">
              <c:Caixa Classes="coluna" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="9" Margin="4,0,0,0">
                    <c:Caixa Classes="sigla"><TextBlock Text="{Binding Iniciais}" /></c:Caixa>
                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Classes="fraco" Text="{Binding Resumo}" VerticalAlignment="Center" FontSize="12.5" />
                  </StackPanel>
                  <c:GradeAdaptativa Classes="grade-faixa">
                    <StackPanel Margin="0,0,10,0">
                      <StackPanel Classes="so-vertical">
                        <StackPanel Orientation="Horizontal" Margin="4,2,0,8" IsVisible="{Binding !!Precisa.Count}">
                          <Ellipse Classes="estado precisa" VerticalAlignment="Center" Margin="0,0,9,0" />
                          <TextBlock Text="{l:T 'Precisa de você'}" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Precisa}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                      <StackPanel Classes="so-vertical">
                        <StackPanel Orientation="Horizontal" Margin="4,2,0,8" IsVisible="{Binding !!Trabalhando.Count}">
                          <Ellipse Classes="estado trabalhando" VerticalAlignment="Center" Margin="0,0,9,0" />
                          <TextBlock Text="{l:T 'Trabalhando'}" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Trabalhando}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                      <StackPanel Classes="so-vertical">
                        <StackPanel Orientation="Horizontal" Margin="4,2,0,8" IsVisible="{Binding !!Prontas.Count}">
                          <Ellipse Classes="estado pronta" VerticalAlignment="Center" Margin="0,0,9,0" />
                          <TextBlock Text="{l:T 'Prontas'}" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Prontas}" />
                    </StackPanel>
                    <StackPanel>
                      <StackPanel Classes="so-vertical">
                        <StackPanel Orientation="Horizontal" Margin="4,2,0,8" IsVisible="{Binding !!Paradas.Count}">
                          <Ellipse Classes="estado" VerticalAlignment="Center" Margin="0,0,9,0" />
                          <TextBlock Text="{l:T 'Paradas'}" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Paradas}" />
                    </StackPanel>
                  </c:GradeAdaptativa>
                </StackPanel>
              </c:Caixa>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      </Panel>
    </ScrollViewer>
    <ScrollViewer IsVisible="{Binding ModoLista}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,20,28,28" Spacing="10" MaxWidth="1180" HorizontalAlignment="Left">
        <StackPanel IsVisible="{Binding Vazia}" Spacing="10" Margin="0,40,0,0">
          <TextBlock Classes="suave" Text="{l:T 'Nenhuma sessão aberta, nem no Nexora nem fora dele.'}" />
          <c:Botao Classes="primario" Command="{Binding NovaSessaoCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icone Nome="mais" /><TextBlock Text="{l:T 'Nova sessão'}" /></StackPanel>
          </c:Botao>
        </StackPanel>

        <WrapPanel IsVisible="{Binding !Vazia}" Margin="0,0,0,4">
          <c:Caixa Classes="resumo precisa" IsVisible="{Binding TemPrecisam}"><TextBlock Text="{Binding TextoPrecisam}" /></c:Caixa>
          <c:Caixa Classes="resumo trabalhando" IsVisible="{Binding TemTrabalhando}"><TextBlock Text="{Binding TextoTrabalhando}" /></c:Caixa>
          <c:Caixa Classes="resumo" IsVisible="{Binding TemParadas}"><TextBlock Text="{Binding TextoParadas}" /></c:Caixa>
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding Todas}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:ChatVM">
              <c:Caixa Classes="widget" Classes.precisa="{Binding Precisa}" Classes.trabalhando="{Binding Trabalhando}" Classes.expandido="{Binding Expandido}">
                    <c:Caixa.ContextMenu>
                      <ContextMenu><MenuItem Header="{l:T 'Abrir em split view'}" Command="{Binding AbrirEmSplitCommand}" /></ContextMenu>
                    </c:Caixa.ContextMenu>
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Ellipse Classes="estado"
                             Classes.trabalhando="{Binding Trabalhando}"
                             Classes.precisa="{Binding Precisa}"
                             Classes.pronta="{Binding EstaPronta}"
                             Classes.erro="{Binding TemErro}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <c:Botao Grid.Column="1" Classes="titulo-widget" Command="{Binding MostrarCommand}" ToolTip.Tip="{l:T 'Abrir a sessão numa aba'}">
                      <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </c:Botao>
                    <c:BotaoLigado Grid.Column="2" Classes="icone pequeno" Classes.ligado="{Binding Expandido}" IsChecked="{Binding Expandido, Mode=OneWay}" Command="{Binding AlternarExpandidoCommand}"
                            ToolTip.Tip="{l:T 'Ver a conversa e responder aqui'}" AutomationProperties.Name="{l:T 'Ver a conversa e responder no card'}" Margin="0,0,2,0">
                      <c:Icone Nome="conversa" Tamanho="13" />
                    </c:BotaoLigado>
                    <c:Botao Grid.Column="3" Classes="icone pequeno" Command="{Binding MostrarCommand}" ToolTip.Tip="{l:T 'Abrir numa aba'}" AutomationProperties.Name="{l:T 'Abrir a sessão numa aba'}">
                      <c:Icone Nome="externo" Tamanho="13" />
                    </c:Botao>
                    <c:Botao Grid.Column="4" Classes="icone pequeno tirar" Command="{Binding $parent[v:VisaoGeralView].((vm:VisaoGeralVM)DataContext).TirarCommand}" CommandParameter="{Binding}"
                            IsVisible="{Binding PodeTirar}" ToolTip.Tip="{Binding DicaTirar}" AutomationProperties.Name="{Binding DicaTirar}" Margin="2,0,0,0">
                      <c:Icone Nome="fechar" Tamanho="12" />
                    </c:Botao>
                  </Grid>
                  <WrapPanel>
                    <c:Icone Nome="camadas" Tamanho="13" Classes="fraco" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Classes="fraco" Text="{Binding Onde}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <c:Caixa Classes="etiqueta" IsVisible="{Binding TemModelo}"><TextBlock Text="{Binding Modelo}" /></c:Caixa>
                  </WrapPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding !Expandido}">
                    <c:Caixa Classes="agora">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="rotulo-widget" Text="{Binding TempoTexto}" />
                        <TextBlock Text="{Binding UltimaAtividade}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="13"
                                   IsVisible="{Binding UltimaAtividade, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="fraco" Text="{l:T 'Sem atividade ainda.'}" IsVisible="{Binding UltimaAtividade, Converter={x:Static ObjectConverters.IsNull}}" />
                      </StackPanel>
                    </c:Caixa>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding TemPedidoNoCartao}">
                      <c:Botao Classes="primario pequeno" Content="{l:T 'Permitir'}" Command="{Binding PermissaoPendente.PermitirCommand}" />
                      <c:Botao Classes="contorno pequeno" Content="{l:T 'Negar'}" Command="{Binding PermissaoPendente.NegarCommand}" />
                      <c:Botao Classes="fantasma pequeno" Content="{l:T 'Ver detalhes'}" Command="{Binding AlternarExpandidoCommand}" />
                    </StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PerguntasNoCartao}" IsVisible="{Binding TemPerguntaNoCartao}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SegredoNoCartao}" IsVisible="{Binding TemSegredoNoCartao}" />
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding Expandido}">
                    <TextBlock Classes="rotulo-widget" Text="{Binding TempoTexto}" />
                    <v:TrechoView />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Classes="campo" Text="{Binding Rascunho}" PlaceholderText="{l:T 'Responder aqui · Enter envia'}" TextWrapping="Wrap" MaxHeight="120" FontSize="13">
                        <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding EnviarCommand}" /></TextBox.KeyBindings>
                      </TextBox>
                      <c:Botao Grid.Column="1" Classes="icone" Command="{Binding EnviarCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                              ToolTip.Tip="{l:T 'Enviar (Enter)'}" AutomationProperties.Name="{l:T 'Enviar a resposta'}">
                        <c:Icone Nome="enviar" Tamanho="15" />
                      </c:Botao>
                    </Grid>
                  </StackPanel>
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Medidores}" />
                  <c:Botao Classes="mini" Command="{Binding PararCommand}" IsVisible="{Binding Trabalhando}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="5"><c:Icone Nome="parar" Tamanho="12" /><TextBlock Text="{l:T 'Parar'}" /></StackPanel>
                  </c:Botao>
                </StackPanel>
              </c:Caixa>
            </DataTemplate>
            <DataTemplate DataType="vm:SessaoForaVM">
              <c:Caixa Classes="widget" Classes.precisa="{Binding Precisa}" Classes.trabalhando="{Binding Trabalhando}" Classes.expandido="{Binding Expandido}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Ellipse Classes="estado"
                             Classes.trabalhando="{Binding Trabalhando}"
                             Classes.precisa="{Binding Precisa}"
                             Classes.pronta="{Binding Parada}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <c:Botao Grid.Column="1" Classes="titulo-widget" Command="{Binding VerCommand}" ToolTip.Tip="{l:T 'Abrir a conversa numa aba'}">
                      <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </c:Botao>
                    <c:Caixa Grid.Column="2" Classes="etiqueta" VerticalAlignment="Center" Margin="8,0,6,0"><TextBlock Text="{Binding Origem}" /></c:Caixa>
                    <c:BotaoLigado Grid.Column="3" Classes="icone pequeno" Classes.ligado="{Binding Expandido}" IsChecked="{Binding Expandido, Mode=OneWay}" Command="{Binding AlternarExpandidoCommand}"
                            ToolTip.Tip="{l:T 'Ver a conversa aqui'}" AutomationProperties.Name="{l:T 'Ver a conversa no card'}">
                      <c:Icone Nome="conversa" Tamanho="13" />
                    </c:BotaoLigado>
                    <c:Botao Grid.Column="4" Classes="icone pequeno tirar" Command="{Binding $parent[v:VisaoGeralView].((vm:VisaoGeralVM)DataContext).TirarCommand}" CommandParameter="{Binding}"
                            IsVisible="{Binding PodeTirar}" ToolTip.Tip="{Binding DicaTirar}" AutomationProperties.Name="{Binding DicaTirar}" Margin="2,0,0,0">
                      <c:Icone Nome="fechar" Tamanho="12" />
                    </c:Botao>
                  </Grid>
                  <WrapPanel>
                    <c:Icone Nome="camadas" Tamanho="13" Classes="fraco" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Classes="fraco" Text="{Binding Onde}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <c:Caixa Classes="etiqueta" IsVisible="{Binding TemModelo}"><TextBlock Text="{Binding Modelo}" /></c:Caixa>
                  </WrapPanel>
                  <c:Caixa Classes="agora" IsVisible="{Binding !Expandido}">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="rotulo-widget" Text="{Binding TempoTexto}" />
                      <TextBlock Text="{Binding UltimaAtividade}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="13"
                                 IsVisible="{Binding UltimaAtividade, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Classes="fraco" Text="{l:T 'Sem atividade ainda.'}" IsVisible="{Binding UltimaAtividade, Converter={x:Static ObjectConverters.IsNull}}" />
                    </StackPanel>
                  </c:Caixa>
                  <StackPanel Spacing="8" IsVisible="{Binding Expandido}">
                    <TextBlock Classes="rotulo-widget" Text="{Binding TempoTexto}" />
                    <v:TrechoView />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Classes="campo" Text="{Binding Rascunho}" PlaceholderText="{l:T 'Responder aqui · Enter envia e continua no Nexora'}" TextWrapping="Wrap" MaxHeight="120" FontSize="13">
                        <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding EnviarCommand}" /></TextBox.KeyBindings>
                      </TextBox>
                      <c:Botao Grid.Column="1" Classes="icone" Command="{Binding EnviarCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                              ToolTip.Tip="{l:T 'Enviar e continuar no Nexora (Enter)'}" AutomationProperties.Name="{l:T 'Enviar e continuar a conversa no Nexora'}">
                        <c:Icone Nome="enviar" Tamanho="15" />
                      </c:Botao>
                    </Grid>
                    <TextBlock Classes="fraco" Text="{Binding TextoContinuar}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Classes="fraco" Text="{Binding TextoResponder}" IsVisible="{Binding Precisa}" />
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Medidores}" />
                  <c:Botao Classes="contorno pequeno" Content="{l:T 'Ver conversa'}" Command="{Binding VerCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </c:Caixa>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Panel>
  </DockPanel>
  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22" CornerRadius="99" BoxShadow="{DynamicResource BrilhoCaixa}">
    <c:Botao Classes="brilho" Command="{Binding PedirAoOrquestradorCommand}" ToolTip.Tip="{l:T 'Um Claude que divide o trabalho entre agentes (Ctrl+Shift+O)'}">
      <StackPanel Orientation="Horizontal" Spacing="8"><c:Icone Nome="orquestra" Tamanho="15" /><TextBlock Text="{l:T 'Pedir ao orquestrador'}" /></StackPanel>
    </c:Botao>
  </Border>

  <Panel x:Name="CamadaEspiada" Classes="espiada" Classes.aberta="{Binding Espiando}">
    <Border Background="{DynamicResource VeuMedio}" PointerPressed="FundoEspiada_PointerPressed" />
    <Border Margin="40,18,40,18" MaxWidth="1180" Background="{DynamicResource FundoSolido}" BorderBrush="{DynamicResource Borda}"
            BorderThickness="1" CornerRadius="16" BoxShadow="0 24 70 0 #80000000" ClipToBounds="True">
      <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1" Padding="20,12,12,12">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <ContentControl Content="{Binding Espiado}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ChatVM">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="fraco mono" Text="{Binding Onde}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="vm:SessaoForaVM">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <c:Caixa Classes="etiqueta" VerticalAlignment="Center"><TextBlock Text="{Binding Origem}" /></c:Caixa>
                    </StackPanel>
                    <TextBlock Classes="fraco mono" Text="{Binding Onde}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <c:Botao Grid.Column="1" Classes="contorno pequeno" Command="{Binding MaximizarEspiadaCommand}" Margin="12,0,6,0" VerticalAlignment="Center" IsVisible="{Binding Espiando}"
                    ToolTip.Tip="{l:T 'Abrir a conversa inteira numa aba'}" AutomationProperties.Name="{l:T 'Abrir a conversa inteira'}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="maximizar" Tamanho="13" /><TextBlock Text="{l:T 'Abrir a conversa'}" /></StackPanel>
            </c:Botao>
            <c:Botao Grid.Column="2" Classes="icone" Command="{Binding FecharEspiadaCommand}" VerticalAlignment="Center" IsVisible="{Binding Espiando}"
                    ToolTip.Tip="{l:T 'Fechar (Esc)'}" AutomationProperties.Name="{l:T 'Fechar'}">
              <c:Icone Nome="fechar" Tamanho="15" />
            </c:Botao>
          </Grid>
        </Border>
        <Panel>
        <Panel x:Name="CorpoEspiada" />
        <ContentControl Content="{Binding EspiadoFora}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:SessaoForaVM">
              <DockPanel Margin="20,14,20,16">
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Classes="campo" Text="{Binding Rascunho}" PlaceholderText="{l:T 'Responder aqui · Enter envia e continua no Nexora'}" TextWrapping="Wrap" MaxHeight="140" FontSize="13">
                      <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding EnviarCommand}" /></TextBox.KeyBindings>
                    </TextBox>
                    <c:Botao Grid.Column="1" Classes="icone" Command="{Binding EnviarCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                            ToolTip.Tip="{l:T 'Enviar e continuar no Nexora (Enter)'}" AutomationProperties.Name="{l:T 'Enviar e continuar a conversa no Nexora'}">
                      <c:Icone Nome="enviar" Tamanho="15" />
                    </c:Botao>
                  </Grid>
                  <TextBlock Classes="fraco" Text="{Binding TextoContinuar}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Classes="rotulo-widget" Text="{Binding TempoTexto}" Margin="0,0,0,8" />
                <v:TrechoView Altura="100000" />
              </DockPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        </Panel>
      </DockPanel>
    </Border>
  </Panel>
  </Panel>
</UserControl>
