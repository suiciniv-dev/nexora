<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora.Traducao"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:v="using:Nexora.Views"
             xmlns:c="using:Nexora.Controles"
             x:Class="Nexora.Views.DetalhesSessaoView"
             x:DataType="vm:ChatVM">
  <UserControl.Styles>
    <Style Selector="TextBlock.titulo-detalhe">
      <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.abas-detalhe > Button.guia">
      <Setter Property="Padding" Value="7,6" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style Selector="Grid.linha-detalhe">
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="Button.saida">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="Margin" Value="-6,0" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="Button.saida:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
  </UserControl.Styles>
  <Border Width="{Binding LarguraDetalhes}" Background="{DynamicResource Lateral}" BorderBrush="{DynamicResource Borda}" BorderThickness="1,0,0,0">
    <DockPanel>
    <Grid DockPanel.Dock="Top" Classes="abas-detalhe" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="10,10,6,4">
      <Button Classes="guia" Classes.ativa="{Binding AbaSessao}" Command="{Binding MostrarAbaCommand}" CommandParameter="sessao" Content="{l:T 'Sessão'}" />
      <Button Grid.Column="1" Classes="guia" Classes.ativa="{Binding AbaArquivos}" Command="{Binding MostrarAbaCommand}" CommandParameter="arquivos" Content="{l:T 'Arquivos'}"
              ToolTip.Tip="{l:T 'Árvore do projeto (Ctrl+Shift+E)'}" />
      <Button Grid.Column="2" Classes="guia" Classes.ativa="{Binding AbaGit}" Command="{Binding MostrarAbaCommand}" CommandParameter="git" Content="Git"
              ToolTip.Tip="{l:T 'Alterações do git em todas as pastas do projeto (Ctrl+Shift+G)'}" />
      <Button Grid.Column="3" Classes="guia" Classes.ativa="{Binding AbaBusca}" Command="{Binding MostrarAbaCommand}" CommandParameter="busca" Content="{l:T 'Busca'}"
              ToolTip.Tip="{l:T 'Procurar em todos os arquivos (Ctrl+Shift+F)'}" />
      <Button Grid.Column="4" Classes="guia" Classes.ativa="{Binding AbaPr}" Command="{Binding MostrarAbaCommand}" CommandParameter="pr" Content="PR"
              ToolTip.Tip="{l:T 'Pull request desta branch: checks, revisões, comentários e merge'}" />
      <Button Grid.Column="5" Classes="guia" Classes.ativa="{Binding AbaNavegador}" Command="{Binding MostrarAbaCommand}" CommandParameter="navegador" Padding="7,5"
              ToolTip.Tip="{l:T 'Navegador: veja a página do projeto e anote o que mudar'}" AutomationProperties.Name="{l:T 'Navegador'}">
        <c:Icone Nome="globo" Tamanho="14" />
      </Button>
      <Button Grid.Column="7" Classes="icone pequeno" Command="{Binding AlternarDetalhesAquiCommand}" Margin="4,0,0,0" VerticalAlignment="Center"
              ToolTip.Tip="{l:T 'Recolher o painel (Ctrl+Alt+B)'}" AutomationProperties.Name="{l:T 'Recolher o painel'}">
        <c:Icone Nome="painel-direito" Tamanho="14" />
      </Button>
    </Grid>
    <Panel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding AbaSessao}">
      <StackPanel Margin="18,14,18,18" Spacing="20">
        <StackPanel Spacing="8">
          <TextBlock Classes="titulo-detalhe" Text="{l:T 'AMBIENTE'}" />
          <Grid Classes="linha-detalhe" ColumnDefinitions="Auto,*">
            <c:Icone Nome="pasta" Tamanho="14" Classes="suave" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding NomePasta}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Pasta}" />
          </Grid>
          <Panel IsVisible="{Binding Branch, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Button x:Name="BotaoBranch" Classes="opcao-menu" Classes.selecionada="{Binding MenuBranchAberto}" Command="{Binding AbrirMenuBranchCommand}"
                    Padding="6,4" Margin="-6,0" ToolTip.Tip="{l:T 'Trocar a branch desta pasta'}" AutomationProperties.Name="{l:T 'Trocar a branch'}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icone Nome="branch" Tamanho="14" Classes="suave" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Branch}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5" />
                <c:Icone Grid.Column="2" Nome="abaixo" Tamanho="12" Classes="fraco" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </Button>
            <Popup PlacementTarget="{Binding #BotaoBranch}" Placement="BottomEdgeAlignedLeft" VerticalOffset="4" IsLightDismissEnabled="True"
                   IsOpen="{Binding MenuBranchAberto, Mode=TwoWay}">
              <Border Theme="{DynamicResource Flutuante}" Padding="6" Width="320" v:Animacoes.Entrada="True">
                <StackPanel Spacing="4">
                  <TextBox Classes="campo" Text="{Binding FiltroBranch}" PlaceholderText="{l:T 'Procurar branch'}" Margin="2,2,2,4" />
                  <TextBlock Text="{Binding AvisoBranch}" IsVisible="{Binding TemAvisoBranch}" Foreground="{DynamicResource Laranja}"
                             TextWrapping="Wrap" FontSize="12" Margin="8,2,8,4" />
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,2" IsVisible="{Binding TrocandoBranch}">
                    <Border Classes="esqueleto" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" />
                    <TextBlock Classes="fraco" Text="{l:T 'Trocando de branch…'}" FontSize="12" />
                  </StackPanel>
                  <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OpcoesBranch}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OpcaoMenuVM">
                          <Button Classes="opcao-menu" Classes.selecionada="{Binding Selecionada}" Command="{Binding EscolherCommand}" Margin="0,1">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="1">
                                <TextBlock Classes="mono" Text="{Binding Nome}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="fraco" Text="{Binding Descricao}" IsVisible="{Binding TemDescricao}" FontSize="11.5" />
                              </StackPanel>
                              <c:Icone Grid.Column="1" Nome="ok" Tamanho="13" IsVisible="{Binding Selecionada}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>
            </Popup>
          </Panel>
          <Grid Classes="linha-detalhe" ColumnDefinitions="Auto,*" IsVisible="{Binding TemVinculados}">
            <c:Icone Nome="vinculo" Tamanho="14" Classes="suave" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Classes="suave" Text="{Binding TextoVinculados}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="linha-detalhe" ColumnDefinitions="Auto,*" IsVisible="{Binding TemMcpDoHub}"
                ToolTip.Tip="{l:T 'Estes servidores do .mcp.json rodam uma vez só no hub do Nexora e são divididos entre as sessões'}">
            <c:Icone Nome="memoria" Tamanho="14" Classes="suave" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="suave" Text="{Binding TextoMcpDoHub}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="170" />
              <Border Classes="etiqueta"><TextBlock Text="{l:T 'pelo hub'}" /></Border>
            </StackPanel>
          </Grid>
          <Grid Classes="linha-detalhe" ColumnDefinitions="Auto,*,Auto">
            <c:Icone Nome="celular" Tamanho="14" Classes="suave" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="Remote Control" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding RemotoLigado, Mode=OneWay}" Command="{Binding AlternarRemotoCommand}" IsEnabled="{Binding RemotoDisponivel}"
                          OnContent="" OffContent="" MinWidth="0" ToolTip.Tip="{l:T 'Continuar esta conversa pelo celular ou pelo claude.ai'}" />
          </Grid>
          <Button Classes="mini" Command="{Binding AbrirRemotoCommand}" IsVisible="{Binding RemotoLigado}" HorizontalAlignment="Left" ToolTip.Tip="{Binding EnderecoRemoto}">
            <StackPanel Orientation="Horizontal" Spacing="5"><c:Icone Nome="externo" Tamanho="12" /><TextBlock Text="{l:T 'Abrir o link do Remote Control'}" /></StackPanel>
          </Button>
          <Button Classes="mini" Command="{Binding ExecutarCommand}" HorizontalAlignment="Left" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5"><c:Icone Nome="executar" Tamanho="12" /><TextBlock Text="{l:T 'Executar o projeto'}" /></StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="titulo-detalhe" Text="{l:T 'CONTEXTO'}" />
            <Button Grid.Column="1" Classes="icone pequeno" Command="{Binding DetalharContextoCommand}" ToolTip.Tip="{l:T 'Medir o contexto de novo'}"
                    AutomationProperties.Name="{l:T 'Medir o contexto de novo'}">
              <c:Icone Nome="atualizar" Tamanho="12" />
            </Button>
          </Grid>
          <TextBlock Classes="fraco" Text="{l:T 'Aparece depois da primeira resposta.'}" IsVisible="{Binding !TemContexto}" TextWrapping="Wrap" />
          <StackPanel Spacing="6" IsVisible="{Binding TemContexto}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ResumoContexto, TargetNullValue=''}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Classes="fraco" Text="{Binding ContextoTexto}" />
            </Grid>
            <ProgressBar Classes="contexto" Classes.cheio="{Binding ContextoCheio}" Minimum="0" Maximum="1" Value="{Binding ContextoFracao}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding CategoriasContexto}" IsVisible="{Binding TemCategorias}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoriaContextoVM">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                  <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Cor}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBlock Grid.Column="1" Classes="suave" Text="{Binding Nome}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="fraco mono" Text="{Binding Tokens}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0" />
                  <TextBlock Grid.Column="3" Classes="fraco mono" Text="{Binding Percentual}" FontSize="11.5" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="titulo-detalhe" Text="{l:T 'SAÍDAS'}" />
          <TextBlock Classes="fraco" Text="{l:T 'Os arquivos que esta sessão editar aparecem aqui.'}" IsVisible="{Binding !TemSaidas}" TextWrapping="Wrap" />
          <TextBlock Classes="fraco" Text="{Binding TituloSaidas}" IsVisible="{Binding TemSaidas}" />
          <ItemsControl ItemsSource="{Binding Saidas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SaidaVM">
                <Button Classes="saida" Command="{Binding VerDiffCommand}" ToolTip.Tip="{Binding Caminho}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{l:T 'Ver o diff da última edição'}" Command="{Binding VerDiffCommand}" />
                      <MenuItem Header="{l:T 'Abrir o arquivo'}" Command="{Binding AbrirCommand}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icone Nome="{Binding Icone}" Tamanho="14" Classes="suave" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" FontSize="13" />
                      <TextBlock Classes="fraco" Text="{Binding Diretorio}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="fraco" Text="{Binding Edicoes, StringFormat='{}{0}×'}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                               ToolTip.Tip="{l:T 'Edições nesta sessão'}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <v:PainelArquivosView DataContext="{Binding Painel}" IsVisible="{Binding $parent[v:DetalhesSessaoView].((vm:ChatVM)DataContext).AbaDoPainel}" Margin="0,4,0,0" />
    <v:PainelPrView DataContext="{Binding PainelPr}" IsVisible="{Binding $parent[v:DetalhesSessaoView].((vm:ChatVM)DataContext).AbaPr}" />
    <Panel IsVisible="{Binding AbaNavegador}" Margin="0,4,0,0">
      <ContentControl Content="{Binding NavegadorNoPainel}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:NavegadorVM">
            <v:NavegadorView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
      <StackPanel IsVisible="{Binding NavegadorDestacado}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="20">
        <c:Icone Nome="globo" Tamanho="24" Classes="suave" HorizontalAlignment="Center" />
        <TextBlock Classes="suave" Text="{l:T 'O navegador está numa janela flutuante.'}" TextWrapping="Wrap" TextAlignment="Center" />
        <Button Classes="contorno pequeno" Command="{Binding Navegador.EncaixarCommand}" HorizontalAlignment="Center" Content="{l:T 'Trazer de volta para cá'}" />
      </StackPanel>
    </Panel>
    </Panel>
    </DockPanel>
  </Border>
</UserControl>
