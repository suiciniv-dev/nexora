<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:v="using:Nexora.Views"
             x:Class="Nexora.Views.AbasView"
             x:DataType="vm:AreaVM">
  <UserControl.Styles>
    <Style Selector="Border.guia">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="5,0,5,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions><v:TransicaoDeCor Property="Background" Duration="0:0:0.12" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.guia:pointerover">
      <Setter Property="Background" Value="{DynamicResource Superficie}" />
    </Style>
    <Style Selector="Border.guia.selecionada">
      <Setter Property="Background" Value="{DynamicResource SelecaoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
      <Setter Property="BoxShadow" Value="{DynamicResource SelecaoSombra}" />
    </Style>
    <Style Selector="Border.guia TextBlock.titulo-guia">
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}" />
    </Style>
    <Style Selector="Border.guia.selecionada TextBlock.titulo-guia">
      <Setter Property="Foreground" Value="{DynamicResource Texto}" />
    </Style>
    <Style Selector="Border.guia Button.fechar-guia">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.guia:pointerover Button.fechar-guia, Border.guia.selecionada Button.fechar-guia, Border.guia:focus-within Button.fechar-guia, Button.fechar-guia:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ContentPresenter.estreita Border.guia:not(.selecionada) TextBlock.titulo-guia">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ContentPresenter.estreita Border.guia:not(.selecionada):not(:focus-within) Button.fechar-guia, ContentPresenter.estreita Border.guia:not(.selecionada):not(:focus-within):pointerover Button.fechar-guia">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center">
    <Button DockPanel.Dock="Right" Classes="topo" Command="{Binding NovaSessaoCommand}" WindowDecorationProperties.ElementRole="User"
            ToolTip.Tip="{l:T 'Nova sessão (Ctrl+N)'}" AutomationProperties.Name="{l:T 'Nova sessão'}" Margin="2,0,0,0" VerticalAlignment="Center">
      <v:Icone Nome="mais" Tamanho="16" />
    </Button>
    <v:BotaoLigado DockPanel.Dock="Right" Classes="topo" Classes.ligado="{Binding Dividido}" IsChecked="{Binding Dividido, Mode=OneWay}" Command="{Binding AlternarSplitCommand}" WindowDecorationProperties.ElementRole="User"
            ToolTip.Tip="{l:T 'Split view: liga e desliga, sem perder o que estava nele (Ctrl+Shift+\)'}" AutomationProperties.Name="Split view" Margin="2,0,0,0" VerticalAlignment="Center">
      <v:Icone Nome="dividir" Tamanho="16" />
    </v:BotaoLigado>
    <ScrollViewer x:Name="Rolagem" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Lista" ItemsSource="{Binding Guias}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><v:PainelAbas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GuiaVM">
            <Border Classes="guia" Classes.selecionada="{Binding Selecionada}" WindowDecorationProperties.ElementRole="User"
                    PointerPressed="AoApertar" PointerMoved="AoMover" PointerReleased="AoSoltar"
                    ToolTip.Tip="{Binding Titulo}">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{l:T 'Abrir em split view'}" Command="{Binding DividirCommand}" IsVisible="{Binding PodeDividirAo}" />
                  <MenuItem Header="{l:T 'Fechar painel (mantém a aba)'}" Command="{Binding FecharPainelCommand}" IsVisible="{Binding NaDivisao}" />
                  <MenuItem Header="{l:T 'Abrir em nova janela'}" Command="{Binding NovaJanelaCommand}" />
                  <MenuItem Header="{l:T 'Voltar para a janela principal'}" Command="{Binding VoltarParaPrincipalCommand}" IsVisible="{Binding !NaPrincipal}" />
                  <MenuItem Header="{l:T 'Manter conversa'}" Command="{Binding Chat.ManterLateralCommand, FallbackValue={x:Null}}" IsVisible="{Binding Chat.EhLateral, FallbackValue=False}" />
                  <Separator />
                  <MenuItem Header="{l:T 'Fechar aba'}" Command="{Binding FecharCommand}" InputGesture="Ctrl+W" />
                </ContextMenu>
              </Border.ContextMenu>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel VerticalAlignment="Center" Width="24" Height="24">
                  <v:Avatar Width="24" Height="24" IsVisible="{Binding Chat, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Imagem="{Binding Chat.IconeRepo, FallbackValue={x:Null}}" Iniciais="{Binding Chat.Iniciais, FallbackValue={x:Null}}"
                             Trabalhando="{Binding Chat.Trabalhando, FallbackValue=False}"
                             Precisa="{Binding Chat.Precisa, FallbackValue=False}"
                             Pronta="{Binding Chat.EstaPronta, FallbackValue=False}"
                             Erro="{Binding Chat.TemErro, FallbackValue=False}"
                             Fracao="{Binding Chat.ContextoFracao, FallbackValue=0}" />
                  <v:Icone Nome="{Binding Icone}" Tamanho="14" Classes="suave" VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsVisible="{Binding Chat, Converter={x:Static ObjectConverters.IsNull}}" />
                  <Border Theme="{StaticResource NuvemNaGuia}" IsVisible="{Binding Chat.NaNuvem, FallbackValue=False}" ToolTip.Tip="{Binding Chat.DicaOndeRoda, FallbackValue={x:Null}}">
                    <v:Icone Nome="nuvem" Tamanho="9" Foreground="{DynamicResource Ciano}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Panel>
                <TextBlock Grid.Column="1" Classes="titulo-guia" Text="{Binding Titulo}" MaxWidth="170" Margin="7,0" TextTrimming="CharacterEllipsis" FontSize="12.5" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="icone pequeno fechar-guia" Command="{Binding FecharCommand}" Width="24" Height="24" Padding="0"
                        ToolTip.Tip="{l:T 'Fechar aba (Ctrl+W)'}" AutomationProperties.Name="{l:T 'Fechar aba'}">
                  <v:Icone Nome="fechar" Tamanho="10" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
