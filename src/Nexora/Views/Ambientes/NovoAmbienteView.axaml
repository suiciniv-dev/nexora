<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora.Traducao"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:c="using:Nexora.Controles"
             x:Class="Nexora.Views.NovoAmbienteView"
             x:DataType="vm:NovoAmbienteVM">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1" Padding="28,14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <c:Icone Nome="camadas" Tamanho="18" Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
        <TextBlock Text="{l:T 'Novo ambiente'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Classes="fraco" Text="{l:T 'uma pasta principal e os projetos que andam junto'}" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,22,28,28" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <c:Caixa Classes="painel">
          <StackPanel Spacing="12">
            <TextBlock Classes="titulo-painel" Text="{l:T 'Pasta principal'}" />
            <TextBlock Classes="fraco" TextWrapping="Wrap" Text="{l:T 'É onde o agente roda e onde o .code-workspace é salvo, como você já faz nos seus projetos.'}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mono" Text="{Binding Principal, TargetNullValue='nenhuma pasta escolhida'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <c:Botao Grid.Column="1" Classes="contorno" Click="Principal_Click" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="pasta" Tamanho="14" /><TextBlock Text="{l:T 'Escolher'}" /></StackPanel>
              </c:Botao>
            </Grid>
            <TextBlock Classes="titulo-painel" Text="{l:T 'Nome'}" Margin="0,6,0,0" />
            <TextBox Classes="campo" Text="{Binding Nome}" PlaceholderText="{l:T 'Ex.: Acme.Shop'}" />
          </StackPanel>
        </c:Caixa>

        <c:Caixa Classes="painel">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icone Nome="vinculo" Classes="suave" />
                <TextBlock Classes="titulo-painel" Text="{l:T 'Projetos vinculados'}" />
              </StackPanel>
              <c:Botao Grid.Column="1" Classes="contorno" Click="Vinculado_Click">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="mais" Tamanho="14" /><TextBlock Text="{l:T 'Adicionar pasta'}" /></StackPanel>
              </c:Botao>
            </Grid>
            <TextBlock Classes="fraco" Text="{l:T 'Opcional. Entram em toda sessão como diretórios extras.'}" />
            <ItemsControl ItemsSource="{Binding Vinculados}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PastaEscolhidaVM">
                  <Grid ColumnDefinitions="Auto,*,Auto" Classes="linha">
                    <c:Icone Nome="pasta" Classes="suave" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Nome}" FontWeight="Medium" />
                      <TextBlock Classes="fraco" Text="{Binding Pasta}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <c:Botao Grid.Column="2" Classes="icone pequeno" Command="{Binding RemoverCommand}" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Tirar'}">
                      <c:Icone Nome="fechar" Tamanho="12" />
                    </c:Botao>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:Caixa>

        <c:Caixa Classes="aviso erro" IsVisible="{Binding TemErro}">
          <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" />
        </c:Caixa>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <c:Botao Classes="primario" Command="{Binding CriarCommand}" IsEnabled="{Binding PodeCriar}">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="mais" Tamanho="14" /><TextBlock Text="{l:T 'Criar ambiente'}" /></StackPanel>
          </c:Botao>
          <TextBlock Classes="fraco mono" Text="{Binding Previa}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </StackPanel>

        <c:Caixa Classes="painel" IsVisible="{Binding TemOcultos}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icone Nome="olho-fechado" Classes="suave" />
              <TextBlock Classes="titulo-painel" Text="{l:T 'Ambientes tirados da lista'}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Ocultos}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OcultoVM">
                  <Grid ColumnDefinitions="*,Auto" Classes="linha">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Nome}" FontWeight="Medium" />
                      <TextBlock Classes="fraco" Text="{Binding Pasta}" />
                    </StackPanel>
                    <c:Botao Grid.Column="1" Classes="contorno" Content="{l:T 'Mostrar de novo'}" Command="{Binding MostrarCommand}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:Caixa>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
