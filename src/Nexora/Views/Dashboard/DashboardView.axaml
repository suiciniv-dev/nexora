<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora.Traducao"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:c="using:Nexora.Controles"
             x:Class="Nexora.Views.DashboardView"
             x:DataType="vm:DashboardVM">
  <UserControl.Styles>
    <Style Selector="TextBox.pedido-dashboard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="2,4" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBox.pedido-dashboard:pointerover /template/ Border#PART_BorderElement, TextBox.pedido-dashboard:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="c|Caixa.selo-pr">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
    <Style Selector="c|Caixa.selo-pr > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}" />
    </Style>
    <Style Selector="c|Caixa.selo-pr.aberto > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Verde}" />
    </Style>
    <Style Selector="c|Caixa.selo-pr.mergeado > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Acento}" />
    </Style>
    <Style Selector="c|Caixa.selo-pr.fechado > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Vermelho}" />
    </Style>
    <Style Selector="c|Caixa.lista-lateral">
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,0,0,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Ellipse.ponto-estado">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource TextoFraco}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.ponto-estado.trabalhando">
      <Setter Property="Fill" Value="{DynamicResource Acento}" />
    </Style>
    <Style Selector="Ellipse.ponto-estado.precisa">
      <Setter Property="Fill" Value="{DynamicResource Laranja}" />
    </Style>
    <Style Selector="Ellipse.ponto-estado.pronta">
      <Setter Property="Fill" Value="{DynamicResource Verde}" />
    </Style>
    <Style Selector="Button.fixar-projeto">
      <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
    </Style>
    <Style Selector="Button.fixar-projeto.ligado">
      <Setter Property="Foreground" Value="{DynamicResource Acento}" />
    </Style>
    <Style Selector="c|Caixa.quadradinho">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,24,28,32" ColumnDefinitions="*,26,300" MaxWidth="1480">
      <StackPanel Spacing="16">
        <StackPanel HorizontalAlignment="Center" Spacing="4" Margin="0,30,0,6">
          <TextBlock Classes="fraco" Text="{Binding Saudacao}" HorizontalAlignment="Center" FontSize="13" />
          <WrapPanel HorizontalAlignment="Center">
            <TextBlock Text="{l:T 'O que vamos construir em'}" FontSize="29" FontWeight="Medium" VerticalAlignment="Bottom" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Bottom">
              <TextBlock Text="{Binding NomeDoProjeto}" FontSize="29" FontWeight="SemiBold" FontStyle="Italic" />
              <Border Height="2" CornerRadius="1" Background="{DynamicResource MarcaGradiente}" Margin="2,0,2,0" />
            </StackPanel>
            <TextBlock Text="?" FontSize="29" FontWeight="Medium" VerticalAlignment="Bottom" />
          </WrapPanel>
        </StackPanel>

        <Border Theme="{StaticResource CaixaDoPedido}" MaxWidth="760" HorizontalAlignment="Stretch" Width="NaN">
          <Grid RowDefinitions="*,Auto">
            <TextBox x:Name="CampoPedido" Classes="pedido-dashboard" Text="{Binding Pedido}" TextWrapping="Wrap" AcceptsReturn="False"
                     PlaceholderText="{l:T 'Descreva a tarefa. Enter abre uma sessão nova no projeto escolhido.'}"
                     AutomationProperties.Name="{l:T 'Pedido para uma sessão nova'}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ComecarCommand}" />
                <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ComecarCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">
              <ComboBox ItemsSource="{Binding Projetos}" SelectedItem="{Binding Projeto}" MinWidth="170" MaxWidth="260"
                        AutomationProperties.Name="{l:T 'Projeto da sessão'}" ToolTip.Tip="{l:T 'Projeto da sessão'}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AmbienteVM">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <c:Icone Nome="pasta" Tamanho="13" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Classes="icone fixar-projeto" Classes.ligado="{Binding ProjetoFixo}" Command="{Binding AlternarFixoCommand}" Margin="6,0,0,0"
                      IsVisible="{Binding TemProjeto}" ToolTip.Tip="{Binding DicaDoFixo}" AutomationProperties.Name="{l:T 'Fixar o projeto do Dashboard'}">
                <c:Icone Nome="fixar" Tamanho="14" />
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center" IsVisible="{Binding TemProjeto}">
                <c:Icone Nome="branch" Tamanho="13" Foreground="{DynamicResource TextoFraco}" VerticalAlignment="Center" />
                <TextBlock Classes="fraco" Text="{Binding BranchDoProjeto}" FontFamily="{DynamicResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="3" Classes="primario" Command="{Binding ComecarCommand}" AutomationProperties.Name="{l:T 'Começar'}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{l:T 'Começar'}" VerticalAlignment="Center" />
                  <c:Icone Nome="enviar" Tamanho="13" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Planos}" Margin="-7,18,-7,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CartaoDePlanoVM">
              <Border Theme="{StaticResource Widget}" Margin="7,0">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icone Nome="{Binding Icone}" Tamanho="14" Foreground="{Binding Cor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Theme="{StaticResource TituloDoWidget}" Text="{Binding Nome}" />
                    <TextBlock Grid.Column="2" Theme="{StaticResource RotuloDoWidget}" Foreground="{DynamicResource Laranja}" Text="{Binding Renova}" />
                  </Grid>
                  <TextBlock Theme="{StaticResource NumeroDoWidget}" Text="{Binding Numero}" Margin="0,6,0,0" />
                  <TextBlock Classes="suave" FontSize="12" Text="{Binding Detalhe}" />
                  <c:LinhaDoTempo Height="44" Margin="0,8,0,0" Valores="{Binding Linha}" Maximo="0" Cor="{Binding Cor}" Guia="{DynamicResource Borda}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Theme="{StaticResource RotuloDoWidget}" Text="{l:T 'ÚLTIMAS 24 H'}" />
                    <TextBlock Grid.Column="1" Theme="{StaticResource RotuloDoWidget}" Text="{Binding RotuloDaLinha}" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto,14,Auto">
          <Border Grid.ColumnSpan="3" Theme="{StaticResource Widget}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <c:Icone Nome="quadro" Tamanho="14" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Theme="{StaticResource TituloDoWidget}" Text="{l:T 'Atividade no GitHub'}" />
                <TextBlock Grid.Column="2" Classes="suave" FontSize="12" Text="{Binding TextoAtividade}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Theme="{StaticResource RotuloDoWidget}" Text="{Binding LoginDoGitHub}" />
              </Grid>
              <c:GradeDeAtividade Niveis="{Binding Contribuicoes}" Inicio="{Binding InicioDasContribuicoes}" Cor="{DynamicResource Verde}"
                                  Vazio="{DynamicResource SuperficieAlta}" Rotulo="{DynamicResource TextoFraco}" />
              <TextBlock Classes="suave" FontSize="12.5" IsVisible="{Binding SemGitHub}" TextWrapping="Wrap"
                         Text="{l:T 'Não deu para ler o GitHub. Confira se o gh está instalado e conectado (gh auth login).'}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Theme="{StaticResource Widget}">
            <Grid RowDefinitions="Auto,*,Auto,Auto">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icone Nome="grafico" Tamanho="14" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Theme="{StaticResource TituloDoWidget}" Text="{l:T 'Uso'}" />
                <Button Grid.Column="2" Theme="{StaticResource ItemDoWidget}" Margin="0" Padding="6,2" HorizontalAlignment="Right" Command="{Binding AbrirUsoCommand}" VerticalAlignment="Center">
                  <TextBlock Classes="suave" FontSize="12" Text="{Binding TextoUso}" />
                </Button>
              </Grid>
              <c:GraficoDeUso Grid.Row="1" MinHeight="110" Margin="0,12,0,4" Series="{Binding SeriesDeUso}" Guia="{DynamicResource Borda}" Rotulo="{DynamicResource TextoFraco}" />
              <Grid Grid.Row="2" ColumnDefinitions="40,*,*,*">
                <TextBlock Grid.Column="1" Theme="{StaticResource RotuloDoWidget}" Text="{Binding InicioDoUso}" />
                <TextBlock Grid.Column="2" Theme="{StaticResource RotuloDoWidget}" Text="{Binding MeioDoUso}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Theme="{StaticResource RotuloDoWidget}" Text="{Binding FimDoUso}" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl Grid.Row="3" ItemsSource="{Binding LegendasDeUso}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LegendaVM">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,0">
                      <c:Caixa Classes="quadradinho" Background="{Binding Cor}" />
                      <TextBlock Classes="suave" FontSize="12" Text="{Binding Texto}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <Border Grid.Row="2" Grid.Column="2" Theme="{StaticResource Widget}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icone Nome="relogio" Tamanho="14" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Theme="{StaticResource TituloDoWidget}" Text="{l:T 'Tempo no Nexora'}" />
                <TextBlock Grid.Column="2" Theme="{StaticResource RotuloDoWidget}" Text="{l:T 'ESTA SEMANA'}" />
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,10,0,0">
                <StackPanel Spacing="1">
                  <TextBlock Theme="{StaticResource NumeroDoWidget}" FontSize="21" Text="{Binding TempoAtivo}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Caixa Classes="quadradinho" Background="{DynamicResource Acento}" />
                    <TextBlock Classes="suave" FontSize="12" Text="{l:T 'com o Nexora em uso'}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Theme="{StaticResource NumeroDoWidget}" FontSize="21" Text="{Binding TempoAgentes}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Caixa Classes="quadradinho" Background="{DynamicResource Verde}" />
                    <TextBlock Classes="suave" FontSize="12" Text="{l:T 'agentes trabalhando'}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
              <c:BarrasDeUso Grid.Row="2" Height="72" VerticalAlignment="Bottom" Margin="0,14,0,4" Primeira="{Binding SemanaAgentes}" Segunda="{Binding SemanaResto}"
                             CorPrimeira="{DynamicResource Verde}" CorSegunda="{DynamicResource Acento}" Guia="{DynamicResource Borda}" />
              <Grid Grid.Row="3" RowDefinitions="Auto,Auto">
                <ItemsControl ItemsSource="{Binding Semana}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiaDaSemanaVM">
                      <TextBlock Theme="{StaticResource RotuloDoWidget}" Text="{Binding Nome}" HorizontalAlignment="Center"
                                 Foreground="{DynamicResource TextoFraco}" Classes.hoje="{Binding Hoje}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Classes="fraco" FontSize="12" Margin="0,8,0,0" Text="{Binding TextoTurnos}" />
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Row="4" Theme="{StaticResource Widget}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icone Nome="sino" Tamanho="14" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Theme="{StaticResource TituloDoWidget}" Text="{l:T 'Precisa de você'}" />
                <Button Grid.Column="2" Theme="{StaticResource ItemDoWidget}" Margin="0" Padding="6,2" HorizontalAlignment="Right" Command="{Binding AbrirAoVivoCommand}" VerticalAlignment="Center">
                  <TextBlock Classes="suave" FontSize="12" Text="{l:T 'Ao vivo'}" />
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Fila}" IsVisible="{Binding TemFila}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PedidoDaFilaVM">
                    <Border Background="{DynamicResource PedidoFundo}" BorderBrush="{DynamicResource Laranja}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Theme="{StaticResource ItemDoWidget}" Margin="-6,-4" Padding="6,4" Command="{Binding AbrirCommand}">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="suave" FontSize="11.5" Text="{Binding Sessao}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Item.MostraBotoes}">
                          <Button Classes="primario" Padding="10,4" Command="{Binding Item.PermitirCommand}" Content="{l:T 'Permitir'}" />
                          <Button Classes="contorno" Padding="10,4" Command="{Binding Item.NegarCommand}" Content="{l:T 'Negar'}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding EmAndamento}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatVM">
                    <Button Theme="{StaticResource ItemDoWidget}" Command="{Binding $parent[ItemsControl].((vm:DashboardVM)DataContext).AbrirChatCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse Classes="ponto-estado" Classes.trabalhando="{Binding Trabalhando}" Classes.precisa="{Binding Precisa}" Classes.pronta="{Binding Pronta}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Titulo}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="fraco" FontSize="11.5" Text="{Binding NomeProjeto}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="fraco" FontSize="11.5" Text="{Binding TempoTexto}" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="suave" FontSize="12.5" IsVisible="{Binding NadaPendente}" Text="{l:T 'Nada esperando por você. As sessões abertas aparecem aqui.'}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Row="4" Grid.Column="2" Theme="{StaticResource Widget}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*">
                <c:Icone Nome="conversa" Tamanho="14" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Theme="{StaticResource TituloDoWidget}" Text="{l:T 'Retomar uma conversa'}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Recentes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConversaVM">
                    <Button Theme="{StaticResource ItemDoWidget}" Command="{Binding AbrirCommand}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Titulo}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="fraco" FontSize="11.5" Text="{Binding Local}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="fraco" FontSize="11.5" Text="{Binding Quando}" VerticalAlignment="Center" Margin="10,0,0,0" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="suave" FontSize="12.5" IsVisible="{Binding !TemRecentes}" Text="{l:T 'As conversas guardadas aparecem aqui.'}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="6" Grid.ColumnSpan="3" Theme="{StaticResource Widget}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icone Nome="globo" Tamanho="14" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Theme="{StaticResource TituloDoWidget}" Text="{l:T 'Notícias'}" />
                <TextBlock Grid.Column="2" Theme="{StaticResource RotuloDoWidget}" Text="{Binding TextoNoticias}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Noticias}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LinkDoPainelVM">
                    <Button Theme="{StaticResource ItemDoWidget}" Command="{Binding AbrirCommand}" ToolTip.Tip="{Binding Link}">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Titulo}" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="fraco" FontSize="11.5" Text="{Binding Detalhe}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="suave" FontSize="12.5" IsVisible="{Binding SemNoticias}" TextWrapping="Wrap"
                         Text="{l:T 'Não deu para ler os feeds agora. Eles ficam na lista FeedsDoDashboard do config.json.'}" />
            </StackPanel>
          </Border>

        </Grid>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="18" Margin="0,6,0,0">
        <Border Theme="{StaticResource Widget}" IsVisible="{Binding TemProjeto}">
          <StackPanel Spacing="9">
            <Grid ColumnDefinitions="Auto,*">
              <c:Icone Nome="pasta" Tamanho="14" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Theme="{StaticResource TituloDoWidget}" Text="{Binding NomeDoProjeto}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <TextBlock Classes="fraco" FontFamily="{DynamicResource Mono}" FontSize="11.5" Text="{Binding PastaDoProjeto}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding PastaDoProjeto}" />
            <Border Height="1" Background="{DynamicResource Borda}" Margin="0,2" />
            <Grid ColumnDefinitions="Auto,*">
              <c:Icone Nome="branch" Tamanho="13" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" FontSize="12.5" FontFamily="{DynamicResource Mono}" Text="{Binding BranchDoProjeto}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <c:Icone Nome="diff" Tamanho="13" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" FontSize="12.5" Text="{Binding TextoMudancas}" />
              <TextBlock Grid.Column="2" FontSize="12.5" FontFamily="{DynamicResource Mono}" Foreground="{DynamicResource Verde}" Text="{Binding Mais}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="3" FontSize="12.5" FontFamily="{DynamicResource Mono}" Foreground="{DynamicResource Vermelho}" Text="{Binding Menos}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Classes="contorno" Command="{Binding AbrirProjetoCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="camadas" Tamanho="13" /><TextBlock Text="{l:T 'Abrir projeto'}" /></StackPanel>
              </Button>
              <Button Classes="contorno" Command="{Binding NovaSessaoNoProjetoCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:Icone Nome="mais" Tamanho="13" /><TextBlock Text="{l:T 'Nova sessão'}" /></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding TemParaRevisar}">
          <c:Caixa Classes="lista-lateral">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Theme="{StaticResource RotuloDoWidget}" Text="{l:T 'ESPERANDO SUA REVIEW'}" />
              <TextBlock Grid.Column="1" Theme="{StaticResource RotuloDoWidget}" Text="{Binding LoginDoGitHub}" />
            </Grid>
          </c:Caixa>
          <ItemsControl ItemsSource="{Binding ParaRevisar}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LinkDoPainelVM">
                <Button Theme="{StaticResource ItemDoWidget}" Command="{Binding AbrirCommand}" ToolTip.Tip="{Binding Link}">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="fraco" FontSize="11.5" Text="{Binding Detalhe}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <c:Caixa Grid.Column="1" Classes="selo-pr" Classes.aberto="{Binding Aberto}" Classes.mergeado="{Binding Mergeado}" Classes.fechado="{Binding Fechado}">
                        <TextBlock Text="{Binding Selo}" />
                      </c:Caixa>
                    </Grid>
                    <TextBlock Text="{Binding Titulo}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel>
          <c:Caixa Classes="lista-lateral">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Theme="{StaticResource RotuloDoWidget}" Text="{l:T 'MEUS PULL REQUESTS'}" />
              <TextBlock Grid.Column="1" Theme="{StaticResource RotuloDoWidget}" Text="{Binding LoginDoGitHub}" />
            </Grid>
          </c:Caixa>
          <ItemsControl ItemsSource="{Binding MeusPrs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LinkDoPainelVM">
                <Button Theme="{StaticResource ItemDoWidget}" Command="{Binding AbrirCommand}" ToolTip.Tip="{Binding Link}">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="fraco" FontSize="11.5" Text="{Binding Detalhe}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <c:Caixa Grid.Column="1" Classes="selo-pr" Classes.aberto="{Binding Aberto}" Classes.mergeado="{Binding Mergeado}" Classes.fechado="{Binding Fechado}">
                        <TextBlock Text="{Binding Selo}" />
                      </c:Caixa>
                    </Grid>
                    <TextBlock Text="{Binding Titulo}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="suave" FontSize="12.5" IsVisible="{Binding SemMeusPrs}" TextWrapping="Wrap" Text="{l:T 'Nenhum PR seu por enquanto, ou o gh não está conectado.'}" />
        </StackPanel>

        <StackPanel>
          <c:Caixa Classes="lista-lateral">
            <TextBlock Theme="{StaticResource RotuloDoWidget}" Text="{l:T 'COMMITS RECENTES'}" />
          </c:Caixa>
          <ItemsControl ItemsSource="{Binding Commits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LinkDoPainelVM">
                <Button Theme="{StaticResource ItemDoWidget}" Command="{Binding AbrirCommand}" ToolTip.Tip="{Binding Link}">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock FontFamily="{DynamicResource Mono}" FontSize="11.5" Foreground="{DynamicResource Acento}" Text="{Binding Selo}" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Titulo}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="fraco" FontSize="11.5" Text="{Binding Detalhe}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="suave" FontSize="12.5" IsVisible="{Binding SemCommits}" Text="{l:T 'Sem commits para mostrar.'}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
