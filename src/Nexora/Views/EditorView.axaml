<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Nexora"
             xmlns:vm="using:Nexora.ViewModels"
             xmlns:v="using:Nexora.Views"
             x:Class="Nexora.Views.EditorView"
             x:DataType="vm:EditorVM">
  <DockPanel Background="{DynamicResource Fundo}">
    <Border DockPanel.Dock="Top" Background="{DynamicResource Lateral}" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Abas}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AbaVM">
                <Border Classes="aba" Classes.ativa="{Binding Ativa}">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="aba-titulo" Command="{Binding SelecionarCommand}" ToolTip.Tip="{Binding Dica}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <v:Icone Nome="arquivo" Tamanho="13" Classes="fraco" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Titulo}" FontSize="12.5" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Acento}" IsVisible="{Binding Modificada}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Classes="icone pequeno" Command="{Binding FecharCommand}" Margin="0,0,4,0" VerticalAlignment="Center"
                            ToolTip.Tip="{l:T 'Fechar'}" AutomationProperties.Name="{l:T 'Fechar a aba'}">
                      <v:Icone Nome="fechar" Tamanho="11" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Column="1" Classes="icone" Command="{Binding FecharTodasCommand}" Margin="4,0" ToolTip.Tip="{l:T 'Fechar o editor'}"
                AutomationProperties.Name="{l:T 'Fechar o editor'}">
          <v:Icone Nome="fechar" Tamanho="14" />
        </Button>
      </Grid>
    </Border>
    <ContentControl Content="{Binding Atual}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:ArquivoVM">
          <v:ArquivoView />
        </DataTemplate>
        <DataTemplate DataType="vm:DiffVM">
          <v:DiffView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</UserControl>
