    <Style Selector="c|Botao.topo.ativo /template/ ContentPresenter#PART_ContentPresenter, c|Botao.topo.ativo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelecaoFundo}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelecaoBorda}" />
      <Setter Property="BoxShadow" Value="{DynamicResource SelecaoSombra}" />
    </Style>
    <Style Selector="c|Botao.topo.foco.vazio">
      <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
    </Style>
    <Style Selector="c|Botao.topo.foco.chamando">
      <Setter Property="Foreground" Value="{DynamicResource Laranja}" />
    </Style>
    <Style Selector="c|Botao.logo-topo">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="c|Botao.logo-topo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuperficieAlta}" />
    </Style>
  </Application.Styles>
</Application>
